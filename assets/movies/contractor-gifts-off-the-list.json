{"id": "contractor-gifts-off-the-list", "title": "Tickets from departments’ own permit holders and tenants that the public list lost", "seconds": 121.5, "voice": "elevenlabs:OUMCzFUTd0F4Q6lkLkco", "narrator": "Roxy", "made": "2026-11-24", "key": "74f803d214e6b132", "words": 304, "beats": [{"scene": "open", "kind": "form", "ref": ["suspicious[0]", "timeline[3]"], "text": "August 2026. Recreation and Park signs its monthly gift form.", "t0": 0.2, "t1": 5.05, "shot": "b0", "visual": {"type": "form", "title": "Recreation and Park, August 2026", "sub": "the replaced gift filing, signed", "rows": [["Another Planet Entertainment", "5 gifts, $72,855"], ["A contract or permit?", "Yes"]]}, "wt": [0.0, 0.39, 0.7, 1.91, 2.56, 2.68, 3.09, 3.47, 3.67, 4.1, 4.4]}, {"scene": "open", "kind": "form", "ref": ["suspicious[0]", "links[1]", "story[3]"], "text": "The donor: Another Planet Entertainment, holder of its Outside Lands festival permit.", "t0": 5.17, "t1": 11.49, "shot": "b0", "visual": {"type": "form", "title": "Recreation and Park, August 2026", "sub": "the replaced gift filing, signed", "rows": [["Another Planet Entertainment", "5 gifts, $72,855"], ["A contract or permit?", "Yes"]]}, "wt": [0.0, 0.18, 1.38, 1.87, 2.35, 3.22, 3.64, 3.73, 3.93, 4.45, 4.82, 5.37]}, {"scene": "open", "kind": "form", "ref": ["suspicious[0]", "links[1]", "story[3]"], "text": "How much?", "t0": 11.49, "t1": 13.01, "shot": "b0", "visual": {"type": "form", "title": "Recreation and Park, August 2026", "sub": "the replaced gift filing, signed", "rows": [["Another Planet Entertainment", "5 gifts, $72,855"], ["A contract or permit?", "Yes"]]}, "wt": [0.04, 0.31]}, {"scene": "open", "kind": "bignum", "ref": ["suspicious[0]", "established[1]", "links[0]", "amount"], "text": "72,855 dollars.", "t0": 13.01, "t1": 16.31, "shot": "b1", "visual": {"type": "bignum", "value": "$72,855", "label": "of tickets and passes, 5 gifts", "sub": "Another Planet Entertainment to Recreation and Park"}, "emph": ["72,855"], "w