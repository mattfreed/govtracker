{"id": "usf-teacher-residency-americorps-settlement", "title": "USF agreed to settle claims over teacher residency hours at San Francisco schools", "seconds": 66.7, "voice": "elevenlabs:iPYqcpY8j8Ap4jUf28I3", "narrator": "Michael", "tempo": 1.117, "made": "2026-11-25", "key": "73382d8bef0db56d", "words": 166, "beats": [{"scene": "open", "kind": "hook", "ref": ["suspicious[0]", "established[0]"], "text": "The University of San Francisco administered an AmeriCorps grant for teacher apprentices.", "t0": 0.2, "t1": 5.46, "shot": "r0", "visual": {"type": "hook", "words": ["Time", "records", "and", "education", "awards"], "sub": "University of San Francisco"}, "wt": [0.0, 0.16, 0.7, 0.79, 1.01, 2.06, 2.7, 2.81, 3.54, 4.08, 4.25, 4.57]}, {"scene": "open", "kind": "doc", "ref": ["suspicious[0]", "established[0]"], "text": "The government alleged more than 1,500 false timesheets.", "t0": 5.58, "t1": 9.56, "shot": "r1", "visual": {"type": "doc", "source": "doj", "kicker": "U.S. Attorney’s Office, Eastern District of California", "text": "Government allegations", "mark": "Government allegations"}, "wt": [0.0, 0.16, 0.53, 0.96, 1.13, 1.34, 1.64, 2.18, 2.51, 2.89, 3.21]}, {"scene": "open", "kind": "bignum", "ref": ["established[0]", "suspicious[0]"], "text": "It also alleged about 61 improper award certifications.", "t0": 9.68, "t1": 13.64, "shot": "awards", "visual": {"type": "bignum", "value": "61", "label": "Improper award certifications alleged"}, "wt": [0.0, 0.16, 0.51, 0.99, 1.28, 2.08, 2.71, 3.04]}, {"scene": "open", "kind": "quote", "ref": ["established[0]"], "text": "The apprentices served in San Francisco Unified schools.", "t0": 13.76, "t1": 16.81, "shot": "r2", "visual": {"type": "quote", "line": "2014 to 2016"}, "wt": [0.0, 0.12, 0.77, 1.16, 1.27, 1.46, 2.03, 2.46]}, {"scene": "terms", "kind": "doc", "ref": ["suspicious[1]", "established[1]"], "text": "The government said more than 1.7 million dollars in federal funds was at issue.", "t0": 17.03, "t1": 22.39, "shot": "r3", "visual": {"type": "doc", "source": "signed", "kicker": "United States, University of San Francisco and relator", "text": "Signed settlement", "mark": "Signed settlement"}, "wt": [0.0, 0.13, 0.52, 0.9, 1.07, 1.28, 1.6, 1.93, 2.28, 2.67, 3.37, 3.57, 3.96, 4.68, 4.88, 4.99]}, {"scene": "terms", "kind": "record", "ref": ["suspicious[1]", "established[1]"], "text": "The university agreed to pay the United States 2,561,727.50 dollars.", "t0": 22.51, "t1": 28.33, "shot": "r4", "visual": {"type": "record", "layout": "amounts", "context": "Signed settlement", "heading": "Separate payment terms", "source": "signed", "rows": [{"icon": "transfer", "label": "To the United States", "value": "$2,561,727.50"}, {"icon": "file", "label": "Relator expenses, fees and costs", "value": "$141,000"}]}, "wt": [0.0, 0.15, 0.78, 1.14, 1.25, 1.44, 1.57, 1.89, 2.26, 2.54, 2.83, 3.16, 3.61, 5.25]}, {"scene": "terms", "kind": "doc", "ref": ["established[1]"], "text": "The Inspector General reported that the university made the payment.", "t0": 28.45, "t1": 31.33, "shot": "r5", "visual": {"type": "doc", "source": "payment", "kicker": "Corporation for National and Community Service, Office of Inspector General", "text": "Payment confirmation", "mark": "Payment confirmation"}, "wt": [0.0, 0.12, 0.64, 0.99, 1.43, 1.54, 1.65, 2.2, 2.36, 2.46]}, {"scene": "terms", "kind": "doc", "ref": ["established[1]"], "text": "The settlement separately specified 141,000 dollars for the relator’s expenses, fees and costs.", "t0": 31.45, "t1": 38.31, "shot": "r6", "visual": {"type": "doc", "source": "signed", "kicker": "United States, University of San Francisco and relator", "text": "Paragraph 3", "mark": "Paragraph 3"}, "wt": [0.0, 0.16, 0.64, 1.08, 1.77, 2.05, 2.44, 2.99, 3.37, 4.07, 4.24, 4.37, 4.86, 5.82, 6.18, 6.32]}, {"scene": "response", "kind": "quote", "ref": ["notEstablished[0]", "defense[0]"], "text": "The university denied wrongdoing. The settlement included no admission.", "t0": 38.53, "t1": 43.12, "shot": "r7", "visual": {"type": "quote", "line": "USF denied the allegations"}, "wt": [0.0, 0.16, 0.83, 1.39, 2.65, 2.84, 3.26, 3.82, 4.04]}, {"scene": "response", "kind": "doc", "ref": ["defense[0]"], "text": "The Justice Department credited its cooperation and said it gave up the grant.", "t0": 43.24, "t1": 47.65, "shot": "r8", "visual": {"type": "doc", "source": "doj", "kicker": "U.S. Attorney’s Office, Eastern District of California", "text": "Justice Department announcement", "mark": "Justice Department announcement"}, "wt": [0.0, 0.14, 0.52, 0.94, 1.39, 1.54, 2.42, 2.78, 3.16, 3.38, 3.69, 3.89, 4.0]}, {"scene": "response", "kind": "doc", "ref": ["suspicious[2]", "established[2]"], "text": "In January 2021, AmeriCorps issued a final debarment notice to the former program director.", "t0": 47.77, "t1": 53.84, "shot": "r9", "visual": {"type": "doc", "source": "debarment", "kicker": "AmeriCorps Office of Inspector General", "text": "Final notice of debarment", "mark": "Final notice of debarment"}, "wt": [0.0, 0.21, 0.75, 1.02, 2.0, 2.76, 3.09, 3.21, 3.63, 4.24, 4.62, 4.74, 4.85, 5.21, 5.61]}, {"scene": "response", "kind": "quote", "ref": ["established[2]"], "text": "The Inspector General recommended three years. The final notice’s duration remains unknown.", "t0": 53.96, "t1": 59.41, "shot": "r10", "visual": {"type": "quote", "line": "Recommended term"}, "wt": [0.0, 0.17, 0.71, 1.15, 1.66, 1.95, 2.96, 3.13, 3.46, 3.89, 4.36, 4.86]}, {"scene": "response", "kind": "unknowns", "ref": ["notEstablished[0]", "next[0]"], "text": "The agreement does not assign fault to the school district or individual teachers.", "t0": 59.53, "t1": 63.35, "shot": "r11", "visual": {"type": "unknowns", "cards": ["Individual student teachers", "San Francisco Unified"]}, "wt": [0.0, 0.16, 0.58, 0.75, 0.92, 1.34, 1.65, 1.75, 1.85, 2.15, 2.54, 2.73, 3.26]}, {"scene": "response", "kind": "end", "ref": ["status"], "text": "Every source is linked in the case file below.", "t0": 63.47, "t1": 65.84, "shot": "r12", "visual": {"type": "end"}, "wt": [0.0, 0.41, 0.83, 0.99, 1.26, 1.34, 1.43, 1.67, 1.94]}], "format": 6, "chapters": {"open": "The time records", "terms": "Two settlement payments", "response": "The university’s response"}, "look": "dossier", "hook": "document"}