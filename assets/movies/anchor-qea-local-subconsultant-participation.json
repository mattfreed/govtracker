uspicious[2]", "established[2]"], "text": "In September, the commission raised the contract ceiling by $450,000.", "t0": 47.12, "t1": 53.7, "shot": "r8", "visual": {"type": "bignum", "value": "$450,000", "label": "Increase in contract ceiling"}, "wt": [0.0, 0.2, 1.23, 1.38, 1.81, 2.12, 2.23, 2.71, 3.08, 3.32, 3.79, 4.29, 5.13, 5.95]}, {"scene": "o", "kind": "bignum", "ref": ["suspicious[2]", "established[2]"], "text": "The Controller later recorded payments to Anchor.", "t0": 53.82, "t1": 56.41, "shot": "r9", "visual": {"type": "bignum", "value": "$663,956.16", "label": "Paid to Anchor"}, "wt": [0.0, 0.14, 0.76, 1.05, 1.53, 2.01, 2.17]}, {"scene": "o", "kind": "bignum", "ref": ["suspicious[2]", "established[2]"], "text": "The vouchers name Anchor as the payee.", "t0": 56.53, "t1": 58.86, "shot": "r9-more1", "visual": {"type": "bignum", "value": "$663,956.16", "label": "Paid to the prime contractor"}, "wt": [0.0, 0.19, 0.72, 0.99, 1.34, 1.52, 1.67]}, {"scene": "o", "kind": "quote", "ref": ["suspicious[2]", "established[2]"], "text": "Those vouchers give the prime contractor’s total.", "t0": 58.98, "t1": 61.82, "shot": "r10", "visual": {"type": "quote", "line": "Those vouchers give the prime contractor’s total"}, "wt": [0.0, 0.44, 1.01, 1.21, 1.33, 1.67, 2.4]}, {"scene": "o", "kind": "quote", "ref": ["suspicious[2]", "established[2]"], "text": "Final local participation remains unknown.", "t0": 61.94, "t1": 64.41, "shot": "r11", "visual": {"type": "quote", "line": "Final local participation remains unknown"}, "wt": [0.0, 0.37, 0.7, 1.48, 1.92]}, {"scene": "o", "kind": "end", "ref": ["status"], "text": "Every source is linked in the case file below.", "t0": 64.53, "t1": 67.17, "shot": "r12", "visual": {"type": "end"}, "wt": [0.0, 0.46, 0.92, 1.11, 1.41, 1.49, 1.6, 1.86, 2.17]}], "format": 6, "chapters": {"p": "The participation table", "b": "The requirements", "o": "The increase"}, "look": "newsroom", "hook": "question"}