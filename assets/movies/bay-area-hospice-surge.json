{"id": "bay-area-hospice-surge", "title": "East Bay hospices whose Medicare payments multiplied in three years", "seconds": 130.2, "voice": "elevenlabs:OtHu0lbpdNTqJVqaxDtR", "narrator": "Maven", "tempo": 1.009, "made": "2026-11-24", "key": "fe719cdbb49e1978", "words": 405, "beats": [{"scene": "open", "kind": "scene", "ref": ["story[0]"], "text": "Hospice is care for people who are dying.", "t0": 0.2, "t1": 1.87, "shot": "b0", "visual": {"type": "scene", "art": "calendar", "label": "Hospice care", "sub": "Medicare pays a flat rate for each day"}, "wt": [0.0, 0.46, 0.58, 0.77, 0.9, 1.12, 1.22, 1.32]}, {"scene": "open", "kind": "scene", "ref": ["story[0]"], "text": "Medicare pays a flat rate for each day a patient is signed up.", "t0": 1.99, "t1": 4.6, "shot": "b0", "visual": {"type": "scene", "art": "calendar", "label": "Hospice care", "sub": "Medicare pays a flat rate for each day"}, "emph": ["each day"], "wt": [0.0, 0.42, 0.62, 0.68, 0.91, 1.11, 1.25, 1.45, 1.64, 1.69, 2.0, 2.09, 2.37]}, {"scene": "open", "kind": "scene", "ref": ["story[0]"], "text": "The pay is the same, whatever care is given. So signing up people who aren’t dying can pay well.", "t0": 4.72, "t1": 9.17, "shot": "b0", "visual": {"type": "scene", "art": "calendar", "label": "Hospice care", "sub": "Medicare pays a flat rate for each day"}, "wt": [0.0, 0.1, 0.26, 0.35, 0.45, 0.89, 1.27, 1.47, 1.56, 2.38, 2.57, 2.88, 3.0, 3.25, 3.38, 3.57, 3.88, 4.02, 4.2]}, {"scene": "open", "kind": "scene", "ref": ["oneLine"], "text": "Eight East Bay hospices, most in Alameda County. In 2024, what did Medicare pay them?", "t0": 9.29, "t1": 14.97, "shot": "b1", "visual": {"type": "scene", "art": "question", "label": "Eight East Bay hospices", "sub": "most in Alameda County"}, "wt": [0.0, 0.29, 0.51, 0.69, 1.58, 1.91, 2.03, 2.43, 3.19, 3.35, 3.59, 4.27, 4.44, 4.57, 4.94, 5.12]}, {"scene": "open", "kind": "bignum", "ref": ["amount", "established[0]"], "text": "40 million dollars.", "t0": 14.97, "t1": 16.04, "shot": "b2", "visual": {"type": "bignum", "value": "$40.0 million", "label": "Medicare paid these 8 hospices in 2024", "sub": "up from $1.5 million between them in their first years on record"}, "emph": ["40"], "wt": [0.04, 0.33, 0.58]}, {"scene": "open", "kind": "caveat", "ref": ["caveat"], "text": "This is a lead, not a finding.", "t0": 16.56, "t1": 18.16, "shot": "b3", "visual": {"type": "caveat", "line": "This is a lead, not a finding: a pattern in public records. This film says what the records show, what they do not show, and what would settle it."}, "wt": [0.0, 0.16, 0.29, 0.37, 0.93, 1.1, 1.17]}, {"scene": "lead1", "kind": "scene", "ref": ["suspicious[0]", "story[1]", "established[3]"], "text": "The first lead: A Plus Prime Care Hospice, in Pleasanton.", "t0": 18.38, "t1": 21.38, "shot": "b6", "visual": {"type": "scene", "art": "housing", "label": "A Plus Prime Care Hospice", "kicker": "The first lead", "sub": "4625 1st St, Suite 230, Pleasanton", "chip": "$116,000 in 2022"}, "wt": [0.0, 0.09, 0.36, 0.86, 1.0, 1.28, 1.59, 1.84, 2.3, 2.4]}, {"scene": "lead1", "kind": "rank", "ref": ["suspicious[0].what"], "text": "Then it took off. Two years later, how much?", "t0": 21.5, "t1": 24.88, "shot": "b7", "visual": {"type": "rank", "label": "A Plus Prime Care · Medicare payments", "rows": [["2022", "$115,986"], ["2023", "$4,164,353"], ["2024", "$8,762,741"]]}, "wt": [0.0, 0.16, 0.24, 0.46, 1.37, 1.58, 1.79, 2.32, 2.51]}, {"scene": "lead1", "kind": "bignum", "ref": ["suspicious[0].what", "story[1]"], "text": "8.8 million dollars.", "t0": 24.88, "t1": 26.46, "shot": "b8", "visual": {"type": "bignum", "value": "$8.8 million", "label": "paid in 2024", "sub": "76 times as much in 2 years"}, "emph": ["8.8"], "wt": [0.04, 0.29, 0.57, 0.78, 1.08]}, {"scene": "lead1", "kind": "scene", "ref": ["suspicious[0].why"], "text": "76 times as much. 363 patients, about 24,140 dollars each.", "t0": 26.98, "t1": 33.13, "shot": "b9", "visual": {"type": "scene", "art": "money", "label": "363 patients", "kicker": "The first lead", "chip": "about $24,140 each"}, "emph": ["76 times"], "wt": [0.0, 0.74, 1.06, 1.2, 1.89, 2.14, 2.4, 2.94, 3.52, 3.78, 4.21, 4.75, 4.97, 5.21, 5.48, 5.8]}, {"scene": "lead1", "kind": "scene", "ref": ["established[7]", "suspicious[0].what"], "text": "Its one present owner is recorded from nine months after Medicare certified it.", "t0": 33.25, "t1": 37.09, "shot": "b9o", "visual": {"type": "scene", "art": "calendar", "label": "A Plus Prime Care Hospice", "kicker": "The federal owner files", "sub": "certified 11 December 2021", "chip": "owner recorded from 1 October 2022"}, "emph": ["nine months after"], "wt": [0.0, 0.21, 0.44, 0.84, 1.17, 1.32, 1.78, 1.99, 2.25, 2.54, 2.83, 3.23, 3.74]}, {"scene": "lead2", "kind": "scene", "ref": ["suspicious[1]", "story[1]"], "text": "The second lead is Grace and Glory Hospice, in Brentwood. In 2021, it got 130,000 dollars.", "t0": 37.31, "t1": 43.09, "shot": "b10", "visual": {"type": "scene", "art": "housing", "label": "Grace and Glory Hospice", "kicker": "The second lead", "sub": "Brentwood", "chip": "$130,000 in 2021"}, "wt": [0.0, 0.12, 0.45, 0.68, 0.81, 1.12, 1.23, 1.56, 2.05, 2.19, 3.04, 3.2, 3.44, 4.18, 4.29, 4.47, 4.57, 4.78, 5.02, 5.31]}, {"scene": "lead2", "kind": "rank", "ref": ["suspicious[1].what"], "text": "By 2024?", "t0": 43.21, "t1": 44.64, "shot": "b11", "visual": {"type": "rank", "label": "Grace and Glory · Medicare payments", "rows": [["2021", "$130,424"], ["2022", "$482,356"], ["2023", "$2,408,019"], ["2024", "$7,185,504"]]}, "wt": [0.0, 0.16, 0.47]}, {"scene": "lead2", "kind": "bignum", "ref": ["suspicious[1].what", "story[1]"], "text": "7.2 million dollars.", "t0": 44.64, "t1": 46.2, "shot": "b12", "visual": {"type": "bignum", "value": "$7.2 million", "label": "paid in 2024", "sub": "55 times as much in 3 years"}, "emph": ["7.2"], "wt": [0.04, 0.39, 0.63, 0.79, 1.06]}, {"scene": "lead2", "kind": "versus", "ref": ["suspicious[1].what", "story[4]", "hcai"], "text": "But the State’s report weakens this one. Many live discharges can mean patients who weren’t dying.", "t0": 46.72, "t1": 51.64, "shot": "b13s", "visual": {"type": "versus", "a": ["Grace And Glory, discharged alive, 2025", "23.6%"], "b": ["California middle", "48.1%"], "kicker": "The State’s own report"}, "wt": [0.0, 0.11, 0.21, 0.53, 0.89, 1.26, 1.47, 2.27, 2.56, 2.8, 3.35, 3.52, 3.74, 4.16, 4.28, 4.51]}, {"scene": "lead2", "kind": "versus", "ref": ["suspicious[1].what", "innocent[2]"], "text": "Grace And Glory: 23.6 percent, against a California middle of 48.1.", "t0": 51.76, "t1": 56.55, "shot": "b13s", "visual": {"type": "versus", "a": ["Grace And Glory, discharged alive, 2025", "23.6%"], "b": ["California middle", "48.1%"], "kicker": "The State’s own report"}, "wt": [0.0, 0.31, 0.42, 0.82, 1.42, 1.71, 1.96, 2.42, 2.76, 2.82, 3.4, 3.68, 3.78, 4.24, 4.5]}, {"scene": "lead3", "kind": "scene", "ref": ["suspicious[2]", "story[1]"], "text": "The third lead is Best Hospice Provider, in Hayward. In 2021, it got 182,000 dollars.", "t0": 56.77, "t1": 62.55, "shot": "b14", "visual": {"type": "scene", "art": "housing", "label": "Best Hospice Provider", "kicker": "The third lead", "sub": "Hayward", "chip": "$182,000 in 2021"}, "wt": [0.0, 0.13, 0.4, 0.62, 0.75, 1.0, 1.42, 1.88, 1.99, 2.76, 2.93, 3.2, 3.81, 3.92, 4.12, 4.29, 4.64, 5.01, 5.3]}, {"scene": "lead3", "kind": "rank", "ref": ["suspicious[2].what"], "text": "And three years later?", "t0": 62.67, "t1": 63.81, "shot": "b15", "visual": {"type": "rank", "label": "Best Hospice Provider · Medicare payments", "rows": [["2021", "$182,187"], ["2022", "$539,886"], ["2023", "$2,213,824"], ["2024", "$4,960,881"]]}, "wt": [0.0, 0.12, 0.31, 0.51]}, {"scene": "lead3", "kind": "bignum", "ref": ["suspicious[2].what", "story[1]"], "text": "5 million dollars.", "t0": 63.81, "t1": 64.8, "shot": "b16", "visual": {"type": "bignum", "value": "$5.0 million", "label": "paid in 2024", "sub": "27 times as much in 3 years"}, "emph": ["5"], "wt": [0.04, 0.29, 0.55]}, {"scene": "lead3", "kind": "scene", "ref": ["established[1]", "suspicious[2].what"], "text": "Its one State report, for 2022: 13 percent left alive.", "t0": 65.32, "t1": 69.19, "shot": "b17s", "visual": {"type": "scene", "art": "question", "label": "No State report", "kicker": "The third lead", "sub": "2023, 2024 and 2025", "chip": "2022: 13.0% discharged alive"}, "wt": [0.0, 0.18, 0.38, 0.66, 1.08, 1.23, 1.48, 2.49, 2.88, 3.2, 3.41]}, {"scene": "lead3", "kind": "scene", "ref": ["established[1]", "suspicious[2].what"], "text": "No report since, while Medicare paid it.", "t0": 69.31, "t1": 71.1, "shot": "b17sx", "visual": {"type": "scene", "art": "question", "label": "No State report", "kicker": "The third lead", "sub": "2023, 2024 and 2025", "chip": "2022: 13.0% discharged alive"}, "emph": ["No report since"], "wt": [0.0, 0.22, 0.58, 0.89, 1.07, 1.45, 1.69]}, {"scene": "lead4", "kind": "scene", "ref": ["suspicious[3]", "story[1]"], "text": "The fourth lead moved fastest.", "t0": 71.32, "t1": 72.83, "shot": "b18", "visual": {"type": "scene", "art": "housing", "label": "Home Connect Hospice", "kicker": "The fourth lead", "sub": "Fremont", "chip": "$205,000 in 2023"}, "wt": [0.0, 0.1, 0.38, 0.59, 0.84]}, {"scene": "lead4", "kind": "scene", "ref": ["suspicious[3]", "story[1]"], "text": "Home Connect Hospice, in Fremont, got 205,000 dollars in 2023.", "t0": 72.95, "t1": 77.29, "shot": "b18x", "visual": {"type": "scene", "art": "housing", "label": "Home Connect Hospice", "kicker": "The fourth lead", "sub": "Fremont", "chip": "$205,000 in 2023"}, "wt": [0.0, 0.25, 0.56, 1.02, 1.14, 1.85, 2.07, 2.3, 2.57, 2.79, 3.08, 3.4, 3.51, 3.77]}, {"scene": "lead4", "kind": "rank", "ref": ["suspicious[3].what"], "text": "Just one year later, how much?", "t0": 77.41, "t1": 79.37, "shot": "b19", "visual": {"type": "rank", "label": "Home Connect · Medicare payments", "rows": [["2023", "$204,595"], ["2024", "$3,970,365"]]}, "wt": [0.0, 0.26, 0.42, 0.58, 1.14, 1.31]}, {"scene": "lea