ipt", "label": "REAX", "value": "$77,447"}, {"icon": "receipt", "label": "APEX", "value": "$15,490"}]}, "wt": [0.0, 0.47, 0.86, 0.95, 1.75, 2.26, 2.65, 2.77]}, {"scene": "work", "kind": "record", "ref": ["established[1]"], "text": "Another $123,271 came from contract fees that were never paid.", "t0": 16.94, "t1": 23.86, "shot": "s4", "visual": {"type": "record", "source": "audit", "heading": "Unrealized fees", "context": "The subcontractors", "layout": "amounts", "rows": [{"icon": "receipt", "label": "Contract fees", "value": "$123,271"}]}, "wt": [0.0, 0.53, 0.75, 1.12, 1.72, 2.77, 3.08, 3.43, 4.03, 4.47, 4.74, 4.97, 5.56, 5.91, 6.03, 6.17, 6.44]}, {"scene": "partner", "kind": "record", "ref": ["suspicious[1]", "established[2]"], "text": "MCK separately promised to perform 40 percent of its joint venture’s work.", "t0": 24.08, "t1": 28.63, "shot": "s5", "visual": {"type": "record", "source": "audit", "heading": "Partner commitment", "context": "The joint venture", "layout": "relationship", "rows": [{"icon": "document", "label": "Partner commitment", "value": "40 percent"}, {"icon": "document", "label": "Evaluation bonus", "value": "7.5 percent"}]}, "wt": [0.0, 0.72, 1.2, 1.63, 1.73, 2.25, 2.62, 3.06, 3.16, 3.35, 3.67, 4.17]}, {"scene": "partner", "kind": "record", "ref": ["established[2]"], "text": "MCK reported subcontracting none of its work.", "t0": 28.75, "t1": 32.33, "shot": "s6", "visual": {"type": "record", "source": "audit", "heading": "The partner’s report", "context": "The joint venture", "layout": "relationship", "rows": [{"icon": "document", "label": "Subcontracted work", "value": "None reported"}]}, "wt": [0.0, 0.68, 1.14, 2.07, 2.27, 2.37, 2.55]}, {"scene": "partner", "kind": "record", "ref": ["established[2]"], "text": "Invoices showed $618,914 went to subcontractors.", "t0": 32.33, "t1": 38.1, "shot": "s6b", "visual": {"type": "record", "source": "audit", "heading": "Invoices below the partner", "context": "The joint venture", "layout": "amounts", "