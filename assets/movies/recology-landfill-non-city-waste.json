9, "t1": 46.96, "shot": "amend-terms", "visual": {"type": "doc", "source": "update", "kicker": "sf-controller", "text": "Contract amendments", "mark": "Contract amendments"}, "wt": [0.0, 0.21, 0.65, 1.04, 1.13, 1.48, 1.61, 2.17, 2.73, 2.98, 3.09, 3.47, 4.01]}, {"scene": "status", "kind": "doc", "ref": ["suspicious[2]", "established[2]"], "text": "By July 2026, seven of nine landfill recommendations had been implemented.", "t0": 47.08, "t1": 52.33, "shot": "r7", "visual": {"type": "doc", "source": "update", "kicker": "sf-controller", "text": "July 2026 status", "mark": "July 2026 status"}, "wt": [0.0, 0.27, 0.68, 1.0, 2.03, 2.44, 2.59, 2.88, 3.36, 4.1, 4.21, 4.38]}, {"scene": "status", "kind": "quote", "ref": ["suspicious[2]", "established[2]"], "text": "The Controller said two would not be implemented. No recommendations remained open.", "t0": 52.45, "t1": 56.63, "shot": "r8", "visual": {"type": "quote", "line": "Two would not be implemented"}, "wt": [0.0, 0.11, 0.6, 0.88, 1.12, 1.29, 1.44, 1.57, 2.66, 2.89, 3.61, 3.94]}, {"scene": "status", "kind": "unknowns", "ref": ["notEstablished[0]", "next[0]"], "text": "The audit did not establish a dollar effect on customers’ rates.", "t0": 56.75, "t1": 60.09, "shot": "r9", "visual": {"type": "unknowns", "cards": ["Effect on customer rates", "Any amount refunded"]}, "wt": [0.0, 0.18, 0.49, 0.65, 0.83, 1.31, 1.42, 1.79, 2.15, 2.31, 2.81]}, {"scene": "status", "kind": "end", "ref": ["status"], "text": "Every source is linked in the case file below.", "t0": 60.21, "t1": 62.55, "shot": "r10", "visual": {"type": "end"}, "wt": [0.0, 0.31, 0.71, 0.93, 1.25, 1.36, 1.46, 1.73, 1.98]}], "format": 6, "chapters": {"open": "What entered the cost base?", "fee": "A separate fee", "status": "What happened to the recommendations?"}, "look": "map", "hook": "number"}