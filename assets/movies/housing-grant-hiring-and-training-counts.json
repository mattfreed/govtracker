{"id": "housing-grant-hiring-and-training-counts", "title": "Housing reports overstated new hires and undercounted trainees", "seconds": 43.6, "voice": "tinyvoca:F2", "narrator": "Temporary local narration", "made": "2026-11-28", "key": "190b0ba6944aeeb0", "words": 123, "beats": [{"scene": "p", "kind": "compare", "ref": ["suspicious[0]", "established[0]"], "text": "Federal housing grants were supposed to create economic opportunities for local residents.", "t0": 0.2, "t1": 4.79, "shot": "s0", "visual": {"type": "compare", "rows": [["CDBG", "Trainees"], ["HOME", "New hires"]]}}, {"scene": "p", "kind": "doc", "ref": ["suspicious[0]", "established[0]"], "text": "San Francisco reported hiring and training on federal form 60002.", "t0": 4.91, "t1": 9.45, "shot": "s1", "visual": {"type": "doc", "source": "original", "kicker": "What the federal form measured", "text": "Federal form", "mark": "Federal"}}, {"scene": "b", "kind": "doc", "ref": ["suspicious[1]", "established[1]"], "text": "One program left a trainee out of its reported total.", "t0": 9.67, "t1": 12.61, "shot": "s2", "visual": {"type": "doc", "source": "original", "kicker": "Two programs reported different errors", "text": "One trainee", "mark": "One"}}, {"scene": "b", "kind": "compare", "ref": ["suspicious[1]", "established[1]"], "text": "Another overstated the number of new hires by three.", "t0": 12.73, "t1": 15.68, "shot": "s3", "visual": {"type": "compare", "rows": [["CDBG trainees", "1 understated"], ["HOME new hires", "3 overstated"]]}}, {"scene": "b", "kind": "quote", "ref": ["suspicious[1]", "established[1]"], "text": "The audit reported no questioned costs.", "t0": 15.8, "t1": 18.05, "shot": "s4", "visual": {"type": "quote", "line": "No questioned costs"}}, {"scene": "b", "kind": "doc", "ref": ["suspicious[2]", "established[2]"], "text": "The housing office traced the errors to a collection of project spreadsheets.", "t0": 18.17, "t1": 21.93, "shot": "s5", "visual": {"type": "doc", "source": "response", "kicker": "Project spreadsheets were combined by hand", "text": "Project spreadsheets", "mark": "Project"}}, {"scene": "b", "kind": "doc", "ref": ["suspicious[2]", "established[2]"], "text": "It began using a database in July 2016.", "t0": 22.05, "t1": 24.99, "shot": "s6", "visual": {"type": "doc", "source": "response", "kicker": "Project spreadsheets were combined by hand", "text": "July 2016", "mark": "July"}}, {"scene": "b", "kind": "doc", "ref": ["suspicious[2]", "established[2]"], "text": "Its deputy director would check the totals before submission.", "t0": 25.11, "t1": 28.12, "shot": "s7", "visual": {"type": "doc", "source": "response", "kicker": "Project spreadsheets were combined by hand", "text": "Review before submission", "mark": "Review"}}, {"scene": "o", "kind": "doc", "ref": ["suspicious[3]", "established[3]"], "text": "The FY2017 report marked the corrective action implemented.", "t0": 28.34, "t1": 32.32, "shot": "s8", "visual": {"type": "doc", "source": "follow", "kicker": "Following audit recorded the fix", "text": "Corrective action implemented", "mark": "Corrective"}}, {"scene": "o", "kind": "quote", "ref": ["suspicious[3]", "established[3]"], "text": "The public figures still do not show what share of all hiring was affected.", "t0": 32.44, "t1": 36.38, "shot": "s9", "visual": {"type": "quote", "line": "Hiring totals"}}, {"scene": "o", "kind": "quote", "ref": ["suspicious[3]", "established[3]"], "text": "The two reported errors measure different outcomes in different programs.", "t0": 36.5, "t1": 40.1, "shot": "s10", "visual": {"type": "quote", "line": "Training and hiring"}}, {"scene": "o", "kind": "end", "ref": ["status"], "text": "Every source is linked in the case file below.", "t0": 40.22, "t1": 42.69, "shot": "end", "visual": {"type": "end"}}], "audioStatus": "temporary-local", "audioProvider": "tiny-voca", "format": 6, "chapters": {"p": "What the federal form measured", "b": "Two programs reported different errors", "o": "Following audit recorded the fix"}, "look": "newsroom", "hook": "timeline"}