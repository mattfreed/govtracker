.86, 2.17, 2.31, 2.5]}, {"scene": "lead2", "kind": "versus", "ref": ["suspicious[1]", "timeline[3]", "timeline[5]"], "text": "1.3 million dollars in 2022,", "t0": 42.37, "t1": 45.06, "shot": "b7", "visual": {"type": "versus", "a": ["2022: to 2 related people", "$1.3 million"], "b": ["2023: to 2 related people", "$1.7 million"]}, "emph": ["1.3 million"], "wt": [0.0, 0.23, 0.49, 0.73, 1.04, 1.4, 1.48, 1.73]}, {"scene": "lead2", "kind": "bignum", "ref": ["suspicious[1]", "timeline[5]"], "text": "then 1.7 million in 2023,", "t0": 45.06, "t1": 47.18, "shot": "b7a", "visual": {"type": "bignum", "value": "$1.7 million", "label": "2023: to 2 related people"}, "emph": ["1.7 million"], "wt": [0.04, 0.28, 0.47, 0.73, 1.01, 1.33, 1.38, 1.65]}, {"scene": "lead2", "kind": "bignum", "ref": ["suspicious[1].what", "links[3]", "established[7]"], "text": "plus 47,820 of payroll tax.", "t0": 47.18, "t1": 50.2, "shot": "b8", "visual": {"type": "bignum", "value": "$2,940,000", "label": "bonuses to two related people, over two years", "sub": "plus $47,820 of payroll tax on them"}, "wt": [0.04, 0.28, 0.79, 1.19, 1.41, 1.71, 2.08, 2.18, 2.54]}, {"scene": "lead2", "kind": "quote", "ref": ["suspicious[1].why"], "text": "Owners who work in a home may be paid.", "t0": 50.62, "t1": 52.41, "shot": "b9", "visual": {"type": "quote", "line": "Pay to related people this large against a thin result is what a Medi-Cal audit tests."}, "wt": [0.0, 0.32, 0.44, 0.64, 0.71, 0.78, 1.02, 1.2, 1.33]}, {"scene": "lead2", "kind": "quote", "ref": ["suspicious[1].why"], "text": "Pay this large, on a thin result, is what a Medi-Cal audit tests.", "t0": 52.53, "t1": 55.95, "shot": "b9", "visual": {"type": "quote", "line": "Pay to related people this large against a thin result is what a Medi-Cal audit tests."}, "wt": [0.0, 0.24, 0.44, 0.91, 1.08, 1.15, 1.36, 1.83, 2.01, 2.14, 2.21, 2.69, 2.97]}, {"scene": "lead3", "kind": "chain", "ref": ["suspicious[2]", "timeline[8]", "links[1]", "links[2]", "established[7]"], "te