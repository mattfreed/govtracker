.57, 0.75, 0.81]}, {"scene": "open", "kind": "scene", "ref": ["story[0]"], "text": "The City rents offices, clinics, shelters and storage from private owners.", "t0": 14.6, "t1": 18.58, "shot": "b2", "visual": {"type": "scene", "art": "cityhall", "label": "City as tenant", "kicker": "Offices, clinics, shelters, storage", "sub": "each lease approved by a Board file"}, "wt": [0.0, 0.13, 0.41, 0.73, 1.33, 1.88, 2.36, 2.49, 2.93, 3.11, 3.49]}, {"scene": "open", "kind": "scene", "ref": ["story[0]"], "text": "The Assessor’s roll records when each building changes hands.", "t0": 18.7, "t1": 21.63, "shot": "b2", "visual": {"type": "scene", "art": "cityhall", "label": "City as tenant", "kicker": "Offices, clinics, shelters, storage", "sub": "each lease approved by a Board file"}, "wt": [0.0, 0.12, 0.6, 0.87, 1.23, 1.43, 1.67, 2.01, 2.43]}, {"scene": "lead1", "kind": "count", "ref": ["suspicious[0]", "amount", "oneLine"], "text": "14 buildings the City rents show a sale date after the lease file, or a large re-set value.", "t0": 21.85, "t1": 27.15, "shot": "b3", "visual": {"type": "count", "value": "14", "label": "buildings the City rents: a sale date after the lease file, or a large value re-set"}, "emph": ["14 buildings"], "wt": [0.0, 0.49, 0.91, 1.01, 1.27, 1.62, 1.85, 1.92, 2.21, 2.49, 2.74, 2.84, 3.09, 3.75, 3.93, 4.0, 4.36, 4.8]}, {"scene": "lead1", "kind": "doc", "ref": ["established[4]"], "text": "One more, 888 Post Street, is left out: that sale date is the City’s own purchase.", "t0": 27.27, "t1": 32.59, "shot": "b3p", "visual": {"type": "doc", "kicker": "Deed 2021131274 · File 210772", "text": "888 Post Street is not counted: the sale date of 12 August 2021 on its roll is the City’s own purchase", "mark": "the City’s own purchase"}, "wt": [0.0, 0.2, 0.59, 0.84, 1.3, 1.56, 1.85, 2.0, 2.26, 3.01, 3.28, 3.59, 3.88, 4.02, 4.12, 4.49, 4.73]}, {"scene": "lead1", "kind": "scene", "ref": ["suspicious[0].what"], "text": "752 Vallejo Street:", "t0": 32.71, "t1": 34.94, "shot": "b4a", "visual": {"type": "scene", "art": "housing", "label": "752 Vallejo Street", "kicker": "A building the City rents"}, "wt": [0.0, 0.41, 0.98, 1.44]}, {"scene": "lead1", "kind": "count", "ref": ["suspicious[0].what"], "text": "a sale dated 1,421 days after its lease file.", "t0": 34.94, "t1": 38.94, "shot": "b4b", "visual": {"type": "count", "value": "1,421", "label": "days from lease file to sale date", "sub": "752 Vallejo Street"}, "emph": ["1,421"], "wt": [0.04, 0.18, 0.46, 0.77, 0.98, 1.37, 1.6, 1.88, 2.45, 2.82, 3.15, 3.33, 3.59]}, {"scene": "lead1", "kind": "rank", "ref": ["suspicious[0].what"], "text": "333 Valencia: 2,058 days.", "t0": 39.06, "t1": 42.81, "shot": "b4", "visual": {"type": "rank", "label": "Days from lease file to sale date", "rows": [["2000 Oakdale Avenue", "3,559"], ["760 Harrison Street", "3,289"], ["333 Valencia Street", "2,058"], ["3801 Third Street", "1,443"], ["752 Vallejo Street", "1,421"], ["141 Industrial Street", "701"]]}, "wt": [0.0, 0.25, 0.58, 1.13, 2.14, 2.39, 2.77, 3.28]}, {"scene": "lead1", "kind": "rank", "ref": ["suspicious[0].what"], "text": "141 Industrial: just 701.", "t0": 42.93, "t1": 45.56, "shot": "b4", "visual": {"type": "rank", "label": "Days from lease file to sale date", "rows": [["2000 Oakdale Avenue", "3,559"], ["760 Harrison Street", "3,289"], ["333 Valencia Street", "2,058"], ["3801 Third Street", "1,443"], ["752 Vallejo Street", "1,421"], ["141 Industrial Street", "701"]]}, "emph": ["701"], "wt": [0.0, 0.21, 0.49, 0.94, 1.5, 1.67, 1.96, 2.3]}, {"scene": "lead1", "kind": "doc", "ref": ["established[6]"], "text": "At 333 Valencia, the City’s rent went to a new company name from April 2026.", "t0": 45.68, "t1": 51.2, "shot": "b4c", "visual": {"type": "doc", "source": "x24b", "kicker": "Controller · vendor payments · Public Health", "text": "333 Valencia Owner LLC: rows to January 2026. 333 Valencia Building JV LLC: from April 2026", "mark": "333 Valencia Building JV LLC"}, "wt": [0.0, 0.17, 0.4, 0.67, 1.