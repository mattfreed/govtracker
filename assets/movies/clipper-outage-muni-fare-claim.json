{"id": "clipper-outage-muni-fare-claim", "title": "Muni claimed $62,992 after Clipper fare readers stopped working", "seconds": 51.7, "voice": "elevenlabs:OUMCzFUTd0F4Q6lkLkco", "narrator": "Roxy", "tempo": 1.027, "made": "2026-11-27", "key": "cfb2580033e1ecff", "words": 129, "beats": [{"scene": "p", "kind": "hook", "ref": ["suspicious[0]", "established[0]"], "text": "On July 1, 2025, Clipper readers failed across Bay Area transit systems.", "t0": 0.2, "t1": 5.67, "shot": "r0", "visual": {"type": "hook", "words": ["July", "1,", "2025"], "sub": "The Clipper outage"}, "wt": [0.0, 0.2, 0.59, 0.94, 1.28, 2.03, 2.45, 2.89, 3.28, 3.71, 3.96, 4.28, 4.75]}, {"scene": "p", "kind": "quote", "ref": ["suspicious[0]", "established[0]"], "text": "Operators began service with readers unable to collect fares.", "t0": 5.79, "t1": 9.65, "shot": "r1", "visual": {"type": "quote", "line": "Operators began service with readers unable to collect fares"}, "wt": [0.0, 0.65, 1.06, 1.47, 1.7, 2.21, 2.71, 2.81, 3.19]}, {"scene": "p", "kind": "doc", "ref": ["suspicious[0]", "established[0]"], "text": "The fare system’s internal calendar had expired when June ended.", "t0": 9.77, "t1": 13.67, "shot": "r2", "visual": {"type": "doc", "source": "memo", "kicker": "The calendar", "text": "June 30, 2025", "mark": "June 30, 2025"}, "wt": [0.0, 0.14, 0.45, 0.98, 1.46, 1.99, 2.16, 2.78, 3.03, 3.42]}, {"scene": "p", "kind": "quote", "ref": ["suspicious[0]", "established[0]"], "text": "Cubic deployed a replacement around 11:45 that morning.", "t0": 13.79, "t1": 17.31, "shot": "r3", "visual": {"type": "quote", "line": "Cubic deployed a replacement around 11:45 that morning"}, "wt": [0.0, 0.41, 0.81, 0.89, 1.44, 1.74, 2.83, 3.04]}, {"scene": "b", "kind": "bignum", "ref": ["suspicious[1]", "established[1]"], "text": "How much did Muni lose? The regional commission estimated $68,906.", "t0": 17.53, "t1": 24.4, "shot": "r4", "visual": {"type": "bignum", "value": "$68,906", "label": "Commission estimate for Muni"}, "wt": [0.0, 0.24, 0.52, 0.72, 1.04, 2.32, 2.52, 3.01, 3.52, 4.09, 4.71, 5.23, 5.5, 5.88, 6.21]}, {"scene": "b", "kind": "quote", "ref": ["suspicious[1]", "established[1]"], "text": "Muni submitted a lower estimate.", "t0": 24.52, "t1": 26.31, "shot": "r5", "visual": {"type": "quote", "line": "Muni submitted a lower estimate"}, "wt": [0.0, 0.34, 0.77, 0.85, 1.21]}, {"scene": "b", "kind": "bignum", "ref": ["suspicious[1]", "established[1]"], "text": "Muni put its loss at $62,992.", "t0": 26.43, "t1": 30.61, "shot": "r6", "visual": {"type": "bignum", "value": "$62,992", "label": "Muni estimate and proposed reimbursement"}, "wt": [0.0, 0.34, 0.53, 0.71, 1.06, 1.21, 1.82, 2.36, 2.62, 2.99, 3.54]}, {"scene": "b", "kind": "quote", "ref": ["suspicious[1]", "established[1]"], "text": "Commission staff proposed reimbursing that full amount.", "t0": 30.73, "t1": 33.75, "shot": "r7", "visual": {"type": "quote", "line": "Commission staff proposed reimbursing that full amount"}, "wt": [0.0, 0.52, 0.89, 1.35, 2.08, 2.29, 2.55]}, {"scene": "o", "kind": "bignum", "ref": ["suspicious[2]", "established[2]"], "text": "The Clipper Executive Board approved $1 million in October.", "t0": 33.97, "t1": 37.55, "shot": "r8", "visual": {"type": "bignum", "value": "$1 million", "label": "Regional reimbursement budget"}, "wt": [0.0, 0.13, 0.48, 1.01, 1.27, 1.75, 1.98, 2.36, 2.77, 2.89]}, {"scene": "o", "kind": "quote", "ref": ["suspicious[2]", "established[2]"], "text": "Interest on Clipper funds would cover this outage and other verified claims.", "t0": 37.67, "t1": 41.96, "shot": "r9", "visual": {"type": "quote", "line": "Interest on Clipper funds would cover this outage and other verified claims"}, "wt": [0.0, 0.56, 0.72, 1.11, 1.5, 1.68, 1.99, 2.22, 2.64, 2.84, 3.11, 3.64]}, {"scene": "o", "kind": "doc", "ref": ["suspicious[2]", "established[2]", "status"], "text": "The commission said it was pursuing recovery from Cubic.", "t0": 42.08, "t1": 44.85, "shot": "r10", "visual": {"type": "doc", "source": "memo", "kicker": "The contractor", "text": "Cubic", "mark": "Cubic"}, "wt": [0.0, 0.12, 0.6, 0.8, 0.87, 1.02, 1.5, 2.06, 2.28]}, {"scene": "o", "kind": "quote", "ref": ["suspicious[2]", "established[2]", "status"], "text": "The records give no Muni payment date or credit from Cubic.", "t0": 44.97, "t1": 48.12, "shot": "r11", "visual": {"type": "quote", "line": "The records give no Muni payment date or credit from Cubic"}, "wt": [0.0, 0.15, 0.54, 0.79, 1.0, 1.3, 1.7, 2.0, 2.17, 2.51, 2.69]}, {"scene": "o", "kind": "end", "ref": ["status"], "text": "Every source is linked in the case file below.", "t0": 48.24, "t1": 50.78, "shot": "r12", "visual": {"type": "end"}, "wt": [0.0, 0.4, 0.78, 0.94, 1.26, 1.35, 1.44, 1.73, 2.05]}], "format": 6, "chapters": {"p": "The expired calendar", "b": "The Muni claim", "o": "The reimbursement budget"}, "look": "newsroom", "hook": "person"}