um", "value": "$5,563.50", "label": "Restricted-source gifts"}, "wt": [0.0, 0.18, 0.54, 1.01, 1.9, 2.28, 2.42, 2.76, 3.19, 3.49, 3.89, 4.59, 5.3, 5.53, 5.88]}, {"scene": "b", "kind": "bignum", "ref": ["suspicious[1]", "established[1]"], "text": "The City tripled the value of the gifts.", "t0": 20.96, "t1": 23.2, "shot": "r3", "visual": {"type": "bignum", "value": "$16,690.50", "label": "City penalty"}, "wt": [0.0, 0.25, 0.61, 1.02, 1.14, 1.52, 1.63, 1.74]}, {"scene": "b", "kind": "quote", "ref": ["suspicious[1]", "established[1]"], "text": "The penalty came to $16,690.50.", "t0": 23.32, "t1": 28.35, "shot": "r3-more1", "visual": {"type": "quote", "line": "The penalty came to $16,690.50"}, "wt": [0.0, 0.16, 0.6, 0.91, 1.03, 1.53, 2.11, 2.42, 2.81, 3.25, 3.95, 4.18, 4.54]}, {"scene": "o", "kind": "bignum", "ref": ["suspicious[1]", "established[1]"], "text": "The State imposed a separate $9,500 penalty.", "t0": 28.57, "t1": 32.84, "shot": "r4", "visual": {"type": "bignum", "value": "$9,500", "label": "State penalty"}, "wt": [0.0, 0.22, 0.73, 1.23, 1.34, 1.83, 2.16, 2.61, 2.91, 3.23, 3.63]}, {"scene": "o", "kind": "doc", "ref": ["established[1]"], "text": "The State counts included disclosure and participation in the permit decision.", "t0": 32.96, "t1": 37.55, "shot": "detail1", "visual": {"type": "doc", "kicker": "San Francisco Ethics Commission", "source": "order", "text": "The State counts included disclosure and participation in the permit decision", "mark": "The State counts included disclosure and participation in the permit decision"}, "wt": [0.0, 0.16, 0.53, 0.89, 1.4, 2.14, 2.36, 3.38, 3.54, 3.65, 4.01]}, {"scene": "o", "kind": "doc", "ref": ["suspicious[2]", "established[2]"], "text": "The agreement records cashier’s checks or money orders submitted for both penalties.", "t0": 37.67, "t1": 42.08, "shot": "r5", "visual": {"type": "doc", "source": "order", "kicker": "Joint stipulation", "text": "cashier’s checks or money orders", "mark": "money orders"}, "wt": 