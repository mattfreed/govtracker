{"id": "mountain-tunnel-inspection-hours-and-budget", "title": "A tunnel inspection budget missed the cost of round-the-clock construction", "seconds": 51.1, "voice": "elevenlabs:9PVP7ENhDskL0KYHAKtD", "narrator": "Jerry B.", "made": "2026-11-27", "key": "1cd1f62e776fca53", "words": 139, "beats": [{"scene": "p", "kind": "hook", "ref": ["suspicious[0]", "established[0]"], "text": "The tunnel work had a separate contract for construction management.", "t0": 0.2, "t1": 3.2, "shot": "s0", "visual": {"type": "hook", "words": ["What", "did", "inspection", "cost?"], "sub": "A management agreement for the tunnel"}, "wt": [0.0, 0.14, 0.43, 0.66, 0.81, 0.91, 1.29, 1.79, 1.93, 2.49]}, {"scene": "p", "kind": "bignum", "ref": ["suspicious[0]", "established[0]"], "text": "The original ceiling was $24.5 million.", "t0": 3.32, "t1": 6.49, "shot": "s1", "visual": {"type": "bignum", "value": "$24.5 million", "label": "A management agreement for the tunnel"}, "wt": [0.0, 0.15, 0.57, 0.94, 1.08, 1.67, 1.96, 2.36, 2.7]}, {"scene": "p", "kind": "doc", "ref": ["suspicious[0]", "established[0]"], "text": "This contract covered inspections, not the excavation itself.", "t0": 6.61, "t1": 9.92, "shot": "s2", "visual": {"type": "doc", "source": "original", "kicker": "A management agreement for the tunnel", "text": "Construction management", "mark": "Construction"}, "wt": [0.0, 0.21, 0.69, 0.97, 1.9, 2.12, 2.27, 2.85]}, {"scene": "b", "kind": "quote", "ref": ["suspicious[1]", "established[1]"], "text": "The original estimate allowed 40,633 inspection hours.", "t0": 10.14, "t1": 14.27, "shot": "s3", "visual": {"type": "quote", "line": "40,633 hours"}, "wt": [0.0, 0.16, 0.56, 0.94, 1.29, 1.65, 2.1, 2.37, 2.66, 3.23, 3.73]}, {"scene": "b", "kind": "doc", "ref": ["suspicious[1]", "established[1]"], "text": "Five winter shutdowns needed round-the-clock coverage.", "t0": 14.39, "t1": 16.9, "shot": "s4", "visual": {"type": "doc", "source": "analysis", "kicker": "The original inspection allowance missed the work pattern", "text": "Five winter shutdowns", "mark": "Five"}, "wt": [0.0, 0.31, 0.58, 1.14, 1.43, 2.04]}, {"scene": "b", "kind": "doc", "ref": ["suspicious[1]", "established[1]"], "text": "The inspectors worked twelve-hour shifts during the shutdowns.", "t0": 17.02, "t1": 19.94, "shot": "detail1", "visual": {"type": "doc", "source": "analysis", "kicker": "Winter shutdowns", "text": "12-hour inspection shifts", "mark": "12-hour"}, "wt": [0.0, 0.14, 0.71, 0.96, 1.57, 1.92, 2.19, 2.28]}, {"scene": "b", "kind": "versus", "ref": ["suspicious[1]", "established[1]"], "text": "The revised estimate was 53,300 hours.", "t0": 20.06, "t1": 23.46, "shot": "s5", "visual": {"type": "versus", "a": ["initial estimate", "40,633 hours"], "b": ["Revised estimate", "53,300 hours"], "kicker": "Inspection time"}, "wt": [0.0, 0.15, 0.61, 1.03, 1.19, 1.85, 2.33, 2.64, 2.98]}, {"scene": "b", "kind": "quote", "ref": ["suspicious[1]", "established[1]"], "text": "The revised rate included overtime.", "t0": 23.58, "t1": 25.39, "shot": "s6", "visual": {"type": "quote", "line": "Overtime and overhead"}, "wt": [0.0, 0.12, 0.57, 0.78, 1.23]}, {"scene": "b", "kind": "versus", "ref": ["suspicious[1]", "established[1]"], "text": "The average rate rose from about $207 to $310.", "t0": 25.51, "t1": 29.77, "shot": "detail2", "visual": {"type": "versus", "a": ["initial rate", "$207"], "b": ["Revised rate", "$310"], "kicker": "Average hourly billing"}, "wt": [0.0, 0.16, 0.52, 0.79, 1.05, 1.24, 1.52, 1.74, 2.09, 2.39, 2.88, 3.06, 3.32, 3.62, 3.84]}, {"scene": "b", "kind": "doc", "ref": ["suspicious[2]", "established[2]"], "text": "Supervisors raised the contract ceiling to $34 million.", "t0": 29.89, "t1": 33.46, "shot": "s7", "visual": {"type": "doc", "source": "decision", "kicker": "The amendment stayed inside the project component", "text": "$34 million authorized", "mark": "$34"}, "wt": [0.0, 0.8, 1.04, 1.14, 1.62, 1.97, 2.1, 2.73, 3.12]}, {"scene": "b", "kind": "quote", "ref": ["suspicious[2]", "established[2]"], "text": "That stayed within the existing project budget for construction management.", "t0": 33.58, "t1": 36.96, "shot": "s8", "visual": {"type": "quote", "line": "Construction management budget"}, "wt": [0.0, 0.21, 0.48, 0.76, 0.9, 1.37, 1.78, 2.12, 2.26, 2.84]}, {"scene": "o", "kind": "bignum", "ref": ["suspicious[3]", "established[3]"], "text": "The voucher register contains 1,152 lines for this agreement.", "t0": 37.18, "t1": 41.72, "shot": "s9", "visual": {"type": "bignum", "value": "1,152 lines", "label": "The actual payments have a separate total"}, "wt": [0.0, 0.15, 0.54, 1.01, 1.51, 1.81, 2.32, 2.54, 2.87, 3.46, 3.76, 3.9, 4.06]}, {"scene": "o", "kind": "quote", "ref": ["suspicious[3]", "established[3]"], "text": "The payments cover all management tasks together.", "t0": 41.84, "t1": 44.08, "shot": "s10", "visual": {"type": "quote", "line": "Invoices would separate the tasks"}, "wt": [0.0, 0.14, 0.53, 0.86, 1.07, 1.51, 1.82]}, {"scene": "o", "kind": "bignum", "ref": ["suspicious[3]", "established[3]"], "text": "They total $26,830,951.07 so far.", "t0": 44.2, "t1": 47.98, "shot": "detail3", "visual": {"type": "bignum", "value": "$26,830,951.07", "label": "All management tasks"}, "wt": [0.0, 0.2, 0.54, 0.78, 1.36, 1.62, 1.8, 2.12, 3.19, 3.41]}, {"scene": "o", "kind": "end", "ref": ["status"], "text": "Every source is linked in the case file below.", "t0": 48.1, "t1": 50.22, "shot": "end", "visual": {"type": "end"}, "wt": [0.0, 0.32, 0.63, 0.79, 1.03, 1.11, 1.21, 1.47, 1.75]}], "format": 6, "chapters": {"p": "A management agreement for the tunnel", "b": "The original inspection allowance missed the work pattern", "o": "The actual payments have a separate total"}, "look": "midnight", "hook": "number"}