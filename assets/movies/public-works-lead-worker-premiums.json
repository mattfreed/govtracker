{"id": "public-works-lead-worker-premiums", "title": "Public Works paid lead premiums on shifts with no crew listed", "seconds": 49.0, "voice": "elevenlabs:9PVP7ENhDskL0KYHAKtD", "narrator": "Jerry B.", "made": "2026-11-25", "key": "1ade4cbdcea23063", "words": 141, "beats": [{"scene": "open", "kind": "hook", "ref": ["suspicious[0]", "established[0]"], "text": "Public Works paid a lead-worker premium to general laborers in January 2011.", "t0": 0.2, "t1": 4.34, "shot": "r0", "visual": {"type": "hook", "words": ["Who", "was", "leading", "a", "crew?"], "sub": "Public Works field reports"}, "wt": [0.0, 0.38, 0.64, 0.85, 0.94, 1.46, 1.88, 2.02, 2.34, 2.8, 2.93, 3.45, 3.74]}, {"scene": "open", "kind": "doc", "ref": ["suspicious[0]", "established[0]"], "text": "Auditors compared those premiums with the week’s daily field reports.", "t0": 4.46, "t1": 7.75, "shot": "r1", "visual": {"type": "doc", "source": "audit", "kicker": "San Francisco Budget and Legislative Analyst", "text": "January 10–15, 2011", "mark": "January 10–15, 2011"}, "wt": [0.0, 0.47, 0.88, 1.11, 1.58, 1.74, 1.85, 2.17, 2.52, 2.8]}, {"scene": "open", "kind": "record", "ref": ["suspicious[0]", "established[0]"], "text": "For 12 of the laborers who got the premium, no other crew member was listed.", "t0": 7.87, "t1": 11.77, "shot": "r2", "visual": {"type": "record", "layout": "relationship", "context": "January 2011 field reports", "heading": "What the reports showed", "source": "audit", "rows": [{"icon": "file", "label": "Oversaw specialized crews", "value": "16 general laborers"}, {"icon": "gap", "label": "No other crew member listed", "value": "12 general laborers"}]}, "wt": [0.0, 0.18, 0.49, 0.57, 0.69, 1.12, 1.27, 1.48, 1.58, 2.35, 2.56, 2.79, 3.03, 3.32, 3.48]}, {"scene": "open", "kind": "doc", "ref": ["established[1]"], "text": "Some laborers oversaw public-assistance or community-service participants.", "t0": 11.89, "t1": 15.6, "shot": "r3", "visual": {"type": "doc", "source": "audit", "kicker": "San Francisco Budget and Legislative Analyst", "text": "Daily field reports", "mark": "Daily field reports"}, "wt": [0.0, 0.29, 0.77, 1.23, 2.08, 2.21, 3.02]}, {"scene": "open", "kind": "quote", "ref": ["established[1]"], "text": "The department kept no electronic record of those assignments.", "t0": 15.72, "t1": 18.66, "shot": "r4", "visual": {"type": "quote", "line": "Assignments"}, "wt": [0.0, 0.12, 0.61, 0.88, 1.09, 1.7, 2.0, 2.1, 2.32]}, {"scene": "proposal", "kind": "bignum", "ref": ["suspicious[1]", "established[2]"], "text": "Auditors estimated 450,000 dollars in possible yearly savings from a change to bargaining agreements.", "t0": 18.88, "t1": 24.7, "shot": "r5", "visual": {"type": "bignum", "value": "$450,000", "label": "Potential annual City savings"}, "wt": [0.0, 0.51, 1.09, 1.35, 1.66, 1.99, 2.38, 2.79, 2.91, 3.38, 3.72, 4.14, 4.33, 4.44, 4.76, 4.86, 5.28]}, {"scene": "proposal", "kind": "doc", "ref": ["established[2]"], "text": "The estimate assumed a three-subordinate rule would reduce craft lead pay by one-third.", "t0": 24.82, "t1": 28.94, "shot": "r6", "visual": {"type": "doc", "source": "hearing", "kicker": "San Francisco Budget and Legislative Analyst", "text": "Three-subordinate rule", "mark": "Three-subordinate rule"}, "wt": [0.0, 0.16, 0.54, 0.91, 0.99, 1.78, 2.0, 2.18, 2.53, 2.85, 3.06, 3.34, 3.56]}, {"scene": "proposal", "kind": "quote", "ref": ["established[2]"], "text": "It covered several crafts across the City.", "t0": 29.06, "t1": 31.0, "shot": "r7", "visual": {"type": "quote", "line": "Multiple crafts citywide"}, "wt": [0.0, 0.15, 0.46, 0.81, 1.17, 1.48, 1.59]}, {"scene": "agreement", "kind": "doc", "ref": ["established[3]"], "text": "In a separate 2014 painters’ arbitration, a witness described receiving lead pay while working alone.", "t0": 31.22, "t1": 37.0, "shot": "r8", "visual": {"type": "doc", "source": "award", "kicker": "San Francisco Board of Supervisors, arbitration record", "text": "2014 arbitration", "mark": "2014 arbitration"}, "wt": [0.0, 0.16, 0.25, 0.63, 0.92, 1.4, 1.78, 2.83, 2.97, 3.34, 3.83, 4.28, 4.52, 4.79, 5.03, 5.37]}, {"scene": "agreement", "kind": "quote", "ref": ["established[3]"], "text": "The arbitrator retained the existing language and noted that the City had given no bargaining notice.", "t0": 37.12, "t1": 42.1, "shot": "r9", "visual": {"type": "quote", "line": "Existing contract language"}, "wt": [0.0, 0.13, 0.71, 1.09, 1.23, 1.71, 2.24, 2.53, 2.82, 2.98, 3.11, 3.41, 3.53, 3.88, 4.1, 4.58]}, {"scene": "agreement", "kind": "unknowns", "ref": ["notEstablished[0]", "next[0]"], "text": "The records leave individual eligibility and actual duties unresolved.", "t0": 42.22, "t1": 45.91, "shot": "r10", "visual": {"type": "unknowns", "cards": ["Applicable agreement", "Duties by shift"]}, "wt": [0.0, 0.18, 0.58, 0.83, 1.44, 2.15, 2.29, 2.63, 3.02]}, {"scene": "agreement", "kind": "end", "ref": ["status"], "text": "Every source is linked in the case file below.", "t0": 46.03, "t1": 48.15, "shot": "r11", "visual": {"type": "end"}, "wt": [0.0, 0.32, 0.63, 0.79, 1.03, 1.11, 1.21, 1.47, 1.75]}], "format": 6, "chapters": {"open": "A week of field reports", "proposal": "The citywide estimate", "agreement": "What the contract said"}, "look": "map", "hook": "document"}