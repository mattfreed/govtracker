{"id": "bart-construction-work-tag-settlement", "title": "BART recovered $1.7 million after an inspector signed 595 work tags", "seconds": 45.8, "voice": "elevenlabs:9PVP7ENhDskL0KYHAKtD", "narrator": "Jerry B.", "made": "2026-11-25", "key": "2e18817bfc9e69fe", "words": 139, "beats": [{"scene": "open", "kind": "hook", "ref": ["suspicious[0]", "established[0]"], "text": "A construction contractor used work tags to bill BART for extra work.", "t0": 0.2, "t1": 3.65, "shot": "r0", "visual": {"type": "hook", "words": ["Who", "verified", "the", "work?"], "sub": "BART construction"}, "wt": [0.0, 0.11, 0.69, 1.33, 1.57, 1.82, 2.13, 2.24, 2.49, 2.74, 2.92, 3.2]}, {"scene": "open", "kind": "doc", "ref": ["suspicious[0]", "established[0]"], "text": "A separate construction management firm was responsible for verifying those charges.", "t0": 3.77, "t1": 7.72, "shot": "r1", "visual": {"type": "doc", "source": "final", "kicker": "BART independent Office of the Inspector General", "text": "Time-and-materials work tags", "mark": "Time-and-materials work tags"}, "wt": [0.0, 0.12, 0.45, 1.05, 1.49, 1.77, 1.92, 2.53, 2.68, 3.23, 3.44]}, {"scene": "open", "kind": "record", "ref": ["suspicious[0]", "established[0]"], "text": "One inspector signed 595 tags without proper verification.", "t0": 7.84, "t1": 11.89, "shot": "r2", "visual": {"type": "record", "layout": "relationship", "context": "Work tags", "heading": "How a bill reached BART", "source": "final", "rows": [{"icon": "file", "label": "Construction firm", "value": "Submitted work tags"}, {"icon": "audit", "label": "Inspector", "value": "verified the work"}, {"icon": "transfer", "label": "BART", "value": "Paid for the project"}]}, "wt": [0.0, 0.21, 0.72, 1.07, 1.35, 1.64, 2.24, 2.6, 2.93, 3.26]}, {"scene": "open", "kind": "quote", "ref": ["suspicious[0]", "established[0]"], "text": "Some tags were signed for work on days the inspector was on vacation.", "t0": 12.01, "t1": 15.46, "shot": "r3", "visual": {"type": "quote", "line": "When the inspector was away"}, "wt": [0.0, 0.3, 0.59, 0.73, 1.01, 1.14, 1.41, 1.56, 1.84, 1.97, 2.5, 2.67, 2.82]}, {"scene": "open", "kind": "doc", "ref": ["suspicious[0]", "established[0]"], "text": "Other tags were signed months or years after the work.", "t0": 15.58, "t1": 18.01, "shot": "r4", "visual": {"type": "doc", "source": "final", "kicker": "BART independent Office of the Inspector General", "text": "Signatures", "mark": "Signatures"}, "wt": [0.0, 0.29, 0.59, 0.73, 1.08, 1.37, 1.52, 1.84, 2.1, 2.2]}, {"scene": "review", "kind": "doc", "ref": ["suspicious[1]", "established[1]"], "text": "In 28 instances the tags showed hours without corresponding hours in that week's payroll.", "t0": 18.23, "t1": 22.96, "shot": "r5", "visual": {"type": "doc", "source": "final", "kicker": "BART independent Office of the Inspector General", "text": "Initial payroll comparison", "mark": "Initial payroll comparison"}, "wt": [0.0, 0.15, 0.66, 1.24, 1.45, 1.79, 2.09, 2.43, 2.76, 3.45, 3.75, 3.87, 4.04, 4.3]}, {"scene": "review", "kind": "quote", "ref": ["suspicious[1]", "established[1]"], "text": "The records limited how far that comparison could go.", "t0": 23.08, "t1": 25.86, "shot": "r6", "visual": {"type": "quote", "line": "Inconsistent supporting records"}, "wt": [0.0, 0.18, 0.59, 1.0, 1.23, 1.55, 1.73, 2.27, 2.46]}, {"scene": "close", "kind": "doc", "ref": ["suspicious[2]", "established[2]"], "text": "The original report described 8.3 million dollars in possible penalties and damages.", "t0": 26.08, "t1": 30.62, "shot": "r7", "visual": {"type": "doc", "source": "limited", "kicker": "BART independent Office of the Inspector General", "text": "December 2023 limited report", "mark": "December 2023 limited report"}, "wt": [0.0, 0.16, 0.56, 0.9, 1.43, 1.6, 1.87, 2.15, 2.48, 2.84, 2.97, 3.4, 3.83, 3.93]}, {"scene": "close", "kind": "bignum", "ref": ["suspicious[2]", "established[2]"], "text": "BART reached a 1.7 million dollar settlement with the two firms in June 2025.", "t0": 30.74, "t1": 35.51, "shot": "r8", "visual": {"type": "bignum", "value": "$1.7 million", "label": "Combined settlement with two firms"}, "wt": [0.0, 0.28, 0.55, 0.66, 0.92, 1.23, 1.57, 1.88, 2.17, 2.61, 2.79, 2.89, 3.14, 3.5, 3.61, 3.85, 4.12]}, {"scene": "close", "kind": "doc", "ref": ["suspicious[2]", "established[2]"], "text": "The Inspector General reported the money recovered.", "t0": 35.63, "t1": 38.0, "shot": "r9", "visual": {"type": "doc", "source": "annual", "kicker": "BART independent Office of the Inspector General", "text": "FY2026 legislative report", "mark": "FY2026 legislative report"}, "wt": [0.0, 0.14, 0.67, 1.04, 1.44, 1.57, 1.86]}, {"scene": "close", "kind": "unknowns", "ref": ["notEstablished[0]"], "text": "The report did not determine individual liability or how much each contractor paid.", "t0": 38.12, "t1": 42.7, "shot": "r10", "visual": {"type": "unknowns", "cards": ["Charges by contractor", "Individual liability"]}, "wt": [0.0, 0.15, 0.51, 0.7, 0.88, 1.34, 1.89, 2.72, 3.01, 3.18, 3.43, 3.61, 4.19]}, {"scene": "close", "kind": "end", "ref": ["status"], "text": "Every source is linked in the case file below.", "t0": 42.82, "t1": 44.93, "shot": "r11", "visual": {"type": "end"}, "wt": [0.0, 0.32, 0.63, 0.79, 1.03, 1.11, 1.21, 1.47, 1.75]}], "format": 6, "chapters": {"open": "A signature on extra work", "review": "What payroll could confirm", "close": "The settlement"}, "look": "dossier", "hook": "document"}