ms", "kind": "unknowns", "ref": ["notEstablished[0]", "next[0]"], "text": "The audits gave no disallowed amount. The executed allocation schedule would clarify the base.", "t0": 35.1, "t1": 40.22, "shot": "r9", "visual": {"type": "unknowns", "cards": ["Executed allocation schedule", "Amended agreement"]}, "wt": [0.0, 0.15, 0.51, 0.81, 1.04, 1.54, 2.23, 2.41, 2.97, 3.55, 3.97, 4.14, 4.62, 4.73]}, {"scene": "terms", "kind": "end", "ref": ["status"], "text": "Every source is linked in the case file below.", "t0": 40.34, "t1": 42.46, "shot": "r10", "visual": {"type": "end"}, "wt": [0.0, 0.32, 0.63, 0.79, 1.03, 1.11, 1.21, 1.47, 1.75]}], "format": 6, "chapters": {"open": "What was the cost base?", "charges": "Two program years", "terms": "City approval and contract terms"}, "look": "newsroom", "hook": "question"}