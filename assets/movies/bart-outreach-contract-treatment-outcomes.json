{"id": "bart-outreach-contract-treatment-outcomes", "title": "BART paid $350,000 for outreach and could confirm one treatment admission", "seconds": 68.1, "voice": "elevenlabs:iPYqcpY8j8Ap4jUf28I3", "narrator": "Michael", "made": "2026-11-26", "key": "9e7457a99ec287cb", "words": 156, "beats": [{"scene": "agreements", "kind": "hook", "ref": ["established[0]", "suspicious[0]"], "text": "BART contracted with The Salvation Army for outreach at downtown San Francisco stations.", "t0": 0.2, "t1": 5.73, "shot": "r0", "visual": {"type": "hook", "words": ["What", "did", "BART", "buy", "for", "outreach?"], "sub": "Downtown San Francisco"}, "wt": [0.0, 0.35, 1.06, 1.23, 1.35, 2.02, 2.32, 2.53, 3.13, 3.29, 4.0, 4.25, 4.86]}, {"scene": "agreements", "kind": "record", "ref": ["established[0]", "suspicious[0]"], "text": "The board authorized two agreements of 250,000 dollars each.", "t0": 5.85, "t1": 10.87, "shot": "r1", "visual": {"type": "record", "layout": "relationship", "context": "Board authorizations", "heading": "Two outreach agreements", "source": "audit", "rows": [{"icon": "file", "label": "First agreement", "value": "$250,000"}, {"icon": "file", "label": "Renewal", "value": "$250,000"}]}, "wt": [0.0, 0.16, 0.66, 1.38, 1.73, 2.39, 2.56, 2.8, 3.19, 3.58, 3.98, 4.51]}, {"scene": "agreements", "kind": "bignum", "ref": ["established[1]", "suspicious[1]"], "text": "The inspector general reported 350,000 dollars spent over the two agreements.", "t0": 10.99, "t1": 16.68, "shot": "r2", "visual": {"type": "bignum", "value": "$350,000", "label": "Reported spending across both agreements"}, "wt": [0.0, 0.16, 0.75, 1.16, 1.69, 2.11, 2.53, 2.92, 3.35, 4.18, 4.51, 4.71, 4.83, 5.07]}, {"scene": "agreements", "kind": "doc", "ref": ["established[0]", "suspicious[0]", "established[2]", "suspicious[2]"], "text": "The agreements offered outreach, referrals and access to residential treatment.", "t0": 16.8, "t1": 21.45, "shot": "r3", "visual": {"type": "doc", "source": "audit", "kicker": "BART Office of the Inspector General", "text": "Residential treatment", "mark": "Residential treatment"}, "wt": [0.0, 0.17, 0.74, 1.1, 1.77, 2.56, 2.79, 3.4, 3.57, 4.17]}, {"scene": "agreements", "kind": "quote", "ref": ["established[0]", "suspicious[0]", "established[2]", "suspicious[2]"], "text": "They provided access to up to four treatment beds. They did not purchase emergency overnight shelter.", "t0": 21.57, "t1": 27.57, "shot": "r4", "visual": {"type": "quote", "line": "Four beds"}, "wt": [0.0, 0.2, 0.73, 1.19, 1.31, 1.51, 1.69, 2.15, 2.59, 3.6, 3.8, 3.96, 4.14, 4.57, 5.13, 5.56]}, {"scene": "outcomes", "kind": "bignum", "ref": ["established[1]", "suspicious[1]", "established[2]", "suspicious[2]"], "text": "The outreach team reported 3,217 contacts.", "t0": 27.79, "t1": 32.14, "shot": "r5", "visual": {"type": "bignum", "value": "3,217", "label": "Outreach contacts from January 2021 to May 2022"}, "wt": [0.0, 0.17, 0.65, 1.04, 1.45, 1.87, 2.49, 2.78, 3.14, 3.67]}, {"scene": "outcomes", "kind": "doc", "ref": ["established[1]", "suspicious[1]"], "text": "Those figures run from January 2021 to May 2022.", "t0": 32.26, "t1": 37.04, "shot": "r6", "visual": {"type": "doc", "source": "audit", "kicker": "BART Office of the Inspector General", "text": "Reporting period", "mark": "Reporting period"}, "wt": [0.0, 0.39, 0.83, 1.09, 1.29, 1.83, 2.23, 3.16, 3.41, 3.69, 4.03]}, {"scene": "outcomes", "kind": "doc", "ref": ["established[1]", "suspicious[1]", "established[2]", "suspicious[2]"], "text": "The monthly measures changed, and the reports did not clearly explain the outcomes.", "t0": 37.16, "t1": 41.99, "shot": "r7", "visual": {"type": "doc", "source": "audit", "kicker": "BART Office of the Inspector General", "text": "Monthly reporting", "mark": "Monthly reporting"}, "wt": [0.0, 0.14, 0.54, 0.99, 1.82, 2.0, 2.11, 2.63, 2.85, 3.16, 3.6, 4.04, 4.16]}, {"scene": "outcomes", "kind": "bignum", "ref": ["established[1]", "suspicious[1]", "established[2]", "suspicious[2]"], "text": "Investigators confirmed one person entered residential treatment over the full 24 months.", "t0": 42.11, "t1": 48.52, "shot": "r8", "visual": {"type": "bignum", "value": "1", "label": "Confirmed residential treatment admission in 24 months"}, "wt": [0.0, 0.91, 1.53, 1.82, 2.33, 2.73, 3.32, 4.21, 4.48, 4.64, 5.31, 5.94]}, {"scene": "outcomes", "kind": "quote", "ref": ["established[1]", "suspicious[1]", "established[2]", "suspicious[2]"], "text": "Contacts and admissions cover different periods. A contact does not identify a unique person.", "t0": 48.64, "t1": 55.19, "shot": "r9", "visual": {"type": "quote", "line": "Different reporting periods"}, "wt": [0.0, 0.57, 0.7, 1.28, 1.62, 2.0, 3.21, 3.39, 4.0, 4.31, 4.83, 5.5, 5.62, 6.01]}, {"scene": "outcomes", "kind": "doc", "ref": ["established[0]", "suspicious[0]", "established[2]", "suspicious[2]"], "text": "Investigators did not substantiate the allegation that emergency beds had been withheld.", "t0": 55.31, "t1": 60.58, "shot": "r10", "visual": {"type": "doc", "source": "audit", "kicker": "BART Office of the Inspector General", "text": "Shelter allegation", "mark": "Shelter allegation"}, "wt": [0.0, 0.94, 1.16, 1.45, 2.15, 2.28, 3.18, 3.4, 3.98, 4.37, 4.49, 4.67]}, {"scene": "outcomes", "kind": "doc", "ref": ["established[3]", "suspicious[3]"], "text": "BART did not renew the service after July 2022.", "t0": 60.7, "t1": 64.42, "shot": "r11", "visual": {"type": "doc", "source": "closure", "kicker": "BART Office of the Inspector General", "text": "Agreements and outcomes", "mark": "Agreements and outcomes"}, "wt": [0.0, 0.37, 0.55, 0.78, 1.15, 1.3, 1.8, 2.11, 2.63, 2.98]}, {"scene": "outcomes", "kind": "end", "ref": ["status"], "text": "Every source is linked in the case file below.", "t0": 64.54, "t1": 67.18, "shot": "r12", "visual": {"type": "end"}, "wt": [0.0, 0.46, 0.92, 1.11, 1.41, 1.49, 1.6, 1.86, 2.17]}], "format": 6, "chapters": {"agreements": "What BART intended to buy", "outcomes": "What the outcomes could show"}, "look": "newsroom", "hook": "question"}