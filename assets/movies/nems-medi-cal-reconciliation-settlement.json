ef": ["suspicious[2]", "established[2]"], "text": "California said the costs raised the per-visit rate from 2001 through 2008.", "t0": 45.35, "t1": 51.82, "shot": "r8", "visual": {"type": "quote", "line": "Per-visit rate"}, "wt": [0.0, 0.69, 1.31, 1.48, 1.95, 2.35, 2.49, 3.14, 3.55, 3.78, 3.99, 4.42, 5.15, 5.45, 5.69, 6.15]}, {"scene": "appeal", "kind": "bignum", "ref": ["suspicious[2]", "established[2]"], "text": "They say the clinic paid California 4.8 million dollars.", "t0": 51.94, "t1": 56.04, "shot": "r9", "visual": {"type": "bignum", "value": "$4.8 million", "label": "Payment to California"}, "wt": [0.0, 0.31, 0.71, 0.84, 1.19, 1.43, 2.13, 2.44, 2.8, 3.12, 3.52]}, {"scene": "appeal", "kind": "quote", "ref": ["suspicious[2]", "established[2]"], "text": "The settlement resolved an amended state claim. The United States dismissed its claims with prejudice.", "t0": 56.16, "t1": 63.12, "shot": "r10", "visual": {"type": "quote", "line": "Civil settlement"}, "wt": [0.0, 0.21, 0.79, 1.46, 1.58, 2.12, 2.49, 3.75, 3.93, 4.36, 4.8, 5.47, 5.65, 6.1, 6.29]}, {"scene": "appeal", "kind": "unknowns", "ref": ["notEstablished[0]"], "text": "The settlement payment does not establish the value of any omitted payments.", "t0": 63.24, "t1": 68.41, "shot": "r11", "visual": {"type": "unknowns", "cards": ["Amount of any overpayment"]}, "wt": [0.0, 0.17, 0.69, 1.5, 1.8, 2.16, 2.81, 2.95, 3.32, 3.5, 4.01, 4.57]}, {"scene": "appeal", "kind": "end", "ref": ["status"], "text": "Every source is linked in the case file below.", "t0": 68.53, "t1": 71.16, "shot": "r12", "visual": {"type": "end"}, "wt": [0.0, 0.46, 0.92, 1.11, 1.41, 1.49, 1.6, 1.86, 2.17]}], "format": 6, "chapters": {"report": "How reimbursements were calculated", "appeal": "Two settlement records"}, "look": "map", "hook": "question"}