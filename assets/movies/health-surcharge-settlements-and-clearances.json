{"id": "health-surcharge-settlements-and-clearances", "title": "Health surcharge settlements set aside $2.09 million for workers", "seconds": 43.9, "voice": "elevenlabs:9PVP7ENhDskL0KYHAKtD", "narrator": "Jerry B.", "made": "2026-11-27", "key": "579f92b0bf09b031", "words": 118, "beats": [{"scene": "p", "kind": "hook", "ref": ["suspicious[0]", "established[0]"], "text": "Customers paid a surcharge described as employee health care.", "t0": 0.2, "t1": 3.25, "shot": "s0", "visual": {"type": "hook", "words": ["Customer", "health", "surcharges"], "sub": "The issue was what happened to customer surcharges"}, "wt": [0.0, 0.48, 0.7, 0.78, 1.38, 1.92, 2.04, 2.5, 2.75]}, {"scene": "p", "kind": "doc", "ref": ["suspicious[0]", "established[0]"], "text": "San Francisco examined the amounts collected from 2009 through 2011.", "t0": 3.37, "t1": 7.56, "shot": "s1", "visual": {"type": "doc", "source": "program", "kicker": "The issue was what happened to customer surcharges", "text": "2009–11 customer charges", "mark": "2009–11"}, "wt": [0.0, 0.26, 0.84, 1.26, 1.37, 1.72, 2.16, 2.35, 2.57, 3.04, 3.29, 3.5, 3.8]}, {"scene": "p", "kind": "doc", "ref": ["suspicious[0]", "established[0]"], "text": "The program offered businesses a chance to settle voluntarily.", "t0": 7.68, "t1": 10.59, "shot": "s2", "visual": {"type": "doc", "source": "program", "kicker": "The issue was what happened to customer surcharges", "text": "Voluntary settlements", "mark": "Voluntary"}, "wt": [0.0, 0.11, 0.57, 0.83, 1.32, 1.41, 1.74, 1.89, 2.18]}, {"scene": "b", "kind": "bignum", "ref": ["suspicious[1]", "established[1]"], "text": "The City reviewed 57 businesses.", "t0": 10.81, "t1": 12.88, "shot": "s3", "visual": {"type": "bignum", "value": "57 businesses", "label": "The City classified 57 businesses individually"}, "wt": [0.0, 0.11, 0.4, 0.78, 1.48]}, {"scene": "b", "kind": "record", "ref": ["suspicious[1]", "established[1]"], "text": "The City listed 38 monetary settlements.", "t0": 13.0, "t1": 15.57, "shot": "s4", "visual": {"type": "record", "source": "publicindex", "layout": "table", "heading": "City findings", "context": "All 57 outcomes", "rows": [{"label": "Monetary settlements", "value": "38"}, {"label": "Nonmonetary agreements", "value": "2"}, {"label": "Cleared", "value": "17"}]}, "wt": [0.0, 0.16, 0.48, 0.84, 1.44, 2.02]}, {"scene": "b", "kind": "doc", "ref": ["suspicious[1]", "established[1]"], "text": "The money was intended for nearly 4,000 eligible workers.", "t0": 15.69, "t1": 19.14, "shot": "s5", "visual": {"type": "doc", "source": "closeout", "kicker": "The City classified 57 businesses individually", "text": "Nearly 4,000 eligible workers", "mark": "Nearly"}, "wt": [0.0, 0.13, 0.41, 0.59, 1.04, 1.21, 1.57, 1.91, 2.42, 2.94]}, {"scene": "b", "kind": "record", "ref": ["suspicious[2]", "established[2]"], "text": "For Patxi’s, the index listed $205,000 for workers.", "t0": 19.26, "t1": 23.31, "shot": "s6", "visual": {"type": "record", "source": "record28", "layout": "table", "heading": "Patxi’s settlement", "context": "Three separate components", "rows": [{"label": "Signed worker allocation", "value": "$205,573.95"}, {"label": "Increased spending", "value": "About $100,000"}, {"label": "City penalty", "value": "$15,000"}]}, "wt": [0.0, 0.16, 0.94, 1.12, 1.49, 1.82, 2.09, 2.42, 2.71, 3.09, 3.42, 3.57]}, {"scene": "b", "kind": "doc", "ref": ["suspicious[2]", "established[2]"], "text": "The signed agreement required an extra $573.95 for workers.", "t0": 23.43, "t1": 28.91, "shot": "s7", "visual": {"type": "doc", "source": "record28", "kicker": "Different agreements committed different dollars", "text": "$573.95 difference", "mark": "$573.95"}, "wt": [0.0, 0.12, 0.42, 0.89, 1.32, 1.44, 1.77, 2.1, 2.52, 3.15, 3.62, 3.9, 4.55, 4.84, 4.99]}, {"scene": "o", "kind": "doc", "ref": ["suspicious[3]", "established[3]"], "text": "Two businesses agreed to nonmonetary terms.", "t0": 29.13, "t1": 31.55, "shot": "s8", "visual": {"type": "doc", "source": "publicindex", "kicker": "Two businesses settled without a payment, and 17 were cleared", "text": "Two nonmonetary agreements", "mark": "Two"}, "wt": [0.0, 0.22, 0.73, 1.08, 1.22, 2.0]}, {"scene": "o", "kind": "bignum", "ref": ["suspicious[3]", "established[3]"], "text": "The City cleared 17 after reviewing the underlying records.", "t0": 31.67, "t1": 34.88, "shot": "s9", "visual": {"type": "bignum", "value": "17 cleared", "label": "Two businesses settled without a payment, and 17 were cleared"}, "wt": [0.0, 0.15, 0.44, 0.77, 1.42, 1.69, 2.11, 2.24, 2.79]}, {"scene": "o", "kind": "doc", "ref": ["suspicious[3]", "established[3]"], "text": "One Market Restaurant was among the businesses cleared.", "t0": 35.0, "t1": 37.6, "shot": "s10", "visual": {"type": "doc", "source": "publicindex", "kicker": "Two businesses settled without a payment, and 17 were cleared", "text": "One Market Restaurant", "mark": "One"}, "wt": [0.0, 0.23, 0.59, 1.06, 1.23, 1.5, 1.61, 2.15]}, {"scene": "o", "kind": "quote", "ref": ["suspicious[3]", "established[3]"], "text": "The final worker distribution still needs reconciliation.", "t0": 37.72, "t1": 40.77, "shot": "s11", "visual": {"type": "quote", "line": "Final worker distribution"}, "wt": [0.0, 0.15, 0.5, 0.82, 1.51, 1.83, 2.09]}, {"scene": "o", "kind": "end", "ref": ["status"], "text": "Every source is linked in the case file below.", "t0": 40.89, "t1": 43.0, "shot": "end", "visual": {"type": "end"}, "wt": [0.0, 0.32, 0.63, 0.79, 1.03, 1.11, 1.21, 1.47, 1.75]}], "format": 6, "chapters": {"p": "The issue was what happened to customer surcharges", "b": "The City classified 57 businesses individually", "o": "Two businesses settled without a payment, and 17 were cleared"}, "look": "dossier", "hook": "person"}