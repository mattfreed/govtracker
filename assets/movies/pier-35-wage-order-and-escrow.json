icious[4]", "established[4]"], "text": "The closeout audit did not itemize the $62,554.10 wage order.", "t0": 31.49, "t1": 36.77, "shot": "s8", "visual": {"type": "doc", "source": "close", "kicker": "The later closeout audit answered a different accounting question", "text": "What the closeout audit checked", "mark": "What"}, "wt": [0.0, 0.09, 0.48, 0.76, 0.9, 1.08, 1.49, 1.6, 2.1, 2.47, 2.72, 2.99, 3.47, 3.84, 3.99, 4.19, 4.43, 4.67]}, {"scene": "o", "kind": "doc", "ref": ["suspicious[4]", "established[4]"], "text": "The public vouchers end before we can see what the workers received.", "t0": 36.89, "t1": 39.73, "shot": "s9", "visual": {"type": "doc", "source": "vouchers", "kicker": "The later closeout audit answered a different accounting question", "text": "The missing payment record", "mark": "The"}, "wt": [0.0, 0.1, 0.4, 0.81, 1.05, 1.32, 1.42, 1.57, 1.72, 1.86, 1.95, 2.3]}, {"scene": "o", "kind": "end", "ref": ["status"], "text": "Every source is linked in the case file below.", "t0": 39.85, "t1": 41.99, "shot": "end", "visual": {"type": "end", "source": "result"}, "wt": [0.0, 0.31, 0.65, 0.8, 1.06, 1.17, 1.26, 1.5, 1.76]}], "format": 6, "chapters": {"p": "Pier 35’s final construction price was $833,865", "b": "The work classification changed what ten people should have earned", "o": "The later closeout audit answered a different accounting question"}, "look": "map", "hook": "timeline"}