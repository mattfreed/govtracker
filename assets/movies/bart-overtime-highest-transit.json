{"id": "bart-overtime-highest-transit", "title": "BART: top overtime share of 13 transit payrolls; 440 position-years above salary", "seconds": 156.7, "voice": "elevenlabs:OUMCzFUTd0F4Q6lkLkco", "narrator": "Roxy", "tempo": 1.2, "made": "2026-11-25", "key": "605991b903795a74", "words": 455, "beats": [{"scene": "open", "kind": "form", "ref": ["suspicious[1]", "timeline[0]"], "text": "One BART position, in 2021.", "t0": 0.2, "t1": 2.78, "shot": "b0", "visual": {"type": "form", "title": "BART, 2021", "sub": "one position, as reported to the State Controller", "rows": [["Position", "Electrical Foreworker"], ["Regular pay", "$114,840"], ["Overtime", "?", 1]]}, "wt": [0.0, 0.25, 0.54, 1.07, 1.22, 1.54]}, {"scene": "open", "kind": "form", "ref": ["suspicious[1]", "timeline[0]"], "text": "An Electrical Foreworker, on regular pay of 114,840 dollars.", "t0": 2.78, "t1": 7.9, "shot": "b0", "visual": {"type": "form", "title": "BART, 2021", "sub": "one position, as reported to the State Controller", "rows": [["Position", "Electrical Foreworker"], ["Regular pay", "$114,840"], ["Overtime", "?", 1]]}, "wt": [0.04, 0.21, 0.68, 1.35, 1.55, 1.92, 2.2, 2.33, 2.52, 2.91, 3.35, 3.81, 4.04, 4.34, 4.63]}, {"scene": "open", "kind": "form", "ref": ["suspicious[1]", "timeline[0]"], "text": "The overtime that year?", "t0": 8.02, "t1": 9.1, "shot": "b0", "visual": {"type": "form", "title": "BART, 2021", "sub": "one position, as reported to the State Controller", "rows": [["Position", "Electrical Foreworker"], ["Regular pay", "$114,840"], ["Overtime", "?", 1]]}, "wt": [0.0, 0.13, 0.57, 0.72]}, {"scene": "open", "kind": "bignum", "ref": ["suspicious[1].what"], "text": "299,931 dollars.", "t0": 9.1, "t1": 12.01, "shot": "b1", "visual": {"type": "bignum", "value": "$299,931", "label": "overtime, on top of regular pay", "sub": "the largest such row, 2019 to 2025"}, "emph": ["299,931"], "wt": [0.04, 0.27, 0.57, 1.05, 1.45, 1.66, 1.94, 2.36]}, {"scene": "open", "kind": "caveat", "ref": ["caveat"], "text": "This is a lead, not a finding.", "t0": 12.53, "t1": 13.97, "shot": "b2", "visual": {"type": "caveat", "line": "This is a lead, not a finding: a pattern in public records. This film says what the records show, what they do not show, and what would settle it."}, "wt": [0.0, 0.17, 0.3, 0.38, 0.7, 0.86, 0.93]}, {"scene": "open", "kind": "scene", "ref": ["established[0]", "story[0]"], "text": "Every figure here is what BART reported to the State Controller.", "t0": 14.09, "t1": 16.88, "shot": "b3", "visual": {"type": "scene", "art": "cityhall", "label": "State Controller", "kicker": "Where the figures come from", "sub": "publishes every employer’s pay"}, "wt": [0.0, 0.34, 0.65, 0.86, 0.96, 1.13, 1.39, 1.79, 1.88, 1.96, 2.2]}, {"scene": "lead1", "kind": "scene", "ref": ["story[0]"], "text": "BART isn’t in the City’s payroll file. It’s a district of three counties, with its own board.", "t0": 17.1, "t1": 21.59, "shot": "b4", "visual": {"type": "scene", "art": "question", "label": "BART", "kicker": "Not in the City’s payroll file", "sub": "a district of three counties, with its own board"}, "wt": [0.0, 0.32, 0.58, 0.68, 0.78, 1.08, 1.5, 2.12, 2.34, 2.41, 2.79, 2.88, 3.12, 3.55, 3.75, 3.9, 4.09]}, {"scene": "lead1", "kind": "scene", "ref": ["story[0]"], "text": "So how does its overtime compare with other transit payrolls?", "t0": 21.71, "t1": 25.1, "shot": "b4", "visual": {"type": "scene", "art": "question", "label": "BART", "kicker": "Not in the City’s payroll file", "sub": "a district of three counties, with its own board"}, "wt": [0.0, 0.21, 0.37, 0.54, 0.72, 1.18, 1.5, 1.67, 1.89, 2.28]}, {"scene": "lead1", "kind": "rank", "ref": ["suspicious[0]", "suspicious[0].what"], "text": "In 2024, BART paid overtime equal to 16.2 percent of regular pay.", "t0": 25.1, "t1": 29.73, "shot": "b5", "visual": {"type": "rank", "label": "Overtime as a share of regular pay, 2024", "rows": [["BART", "16.2%"], ["San Diego Transit Corporation", "15.7%"], ["Sacramento Regional Transit System", "14.6%"], ["Muni", "13.1%"], ["Golden Gate Bridge district", "7.4%"]]}, "emph": ["16.2 percent"], "wt": [0.04, 0.22, 0.51, 1.14, 1.48, 1.75, 2.26, 2.51, 2.59, 3.06, 3.3, 3.49, 3.85, 3.95, 4.31]}, {"scene": "lead1", "kind": "rank", "ref": ["suspicious[0]", "suspicious[0].what"], "text": "By that share, first of 13 transit payrolls.", "t0": 29.85, "t1": 32.77, "shot": "b5", "visual": {"type": "rank", "label": "Overtime as a share of regular pay, 2024", "rows": [["BART", "16.2%"], ["San Diego Transit Corporation", "15.7%"], ["Sacramento Regional Transit System", "14.6%"], ["Muni", "13.1%"], ["Golden Gate Bridge district", "7.4%"]]}, "wt": [0.0, 0.17, 0.38, 0.7, 0.97, 1.06, 1.5, 1.9]}, {"scene": "lead1", "kind": "rank", "ref": ["suspicious[0]", "suspicious[0].what"], "text": "Muni: 13.1. The Golden Gate Bridge district: 7.4.", "t0": 32.77, "t1": 37.25, "shot": "b5", "visual": {"type": "rank", "label": "Overtime as a share of regular pay, 2024", "rows": [["BART", "16.2%"], ["San Diego Transit Corporation", "15.7%"], ["Sacramento Regional Transit System", "14.6%"], ["Muni", "13.1%"], ["Golden Gate Bridge district", "7.4%"]]}, "wt": [0.04, 0.63, 1.09, 1.38, 2.1, 2.27, 2.57, 2.79, 3.11, 3.55, 3.86, 4.12]}, {"scene": "lead1", "kind": "bignum", "ref": ["amount", "links[0]", "suspicious[0].what"], "text": "That’s 75.6 million dollars of overtime, about 16,162 dollars per paid position.", "t0": 37.37, "t1": 43.64, "shot": "b6", "visual": {"type": "bignum", "value": "$75.6 million", "label": "BART overtime, 2024", "sub": "16,162 dollars per paid position"}, "emph": ["75.6 million"], "wt": [0.0, 0.24, 0.82, 1.08, 1.35, 1.66, 1.99, 2.09, 2.79, 3.09, 3.55, 3.99, 4.17, 4.48, 5.0, 5.35, 5.49, 5.73]}, {"scene": "lead1", "kind": "quote", "ref": ["suspicious[0].why"], "text": "Rail systems run around the clock, and fill vacancies with overtime.", "t0": 43.76, "t1": 47.2, "shot": "b7", "visual": {"type": "quote", "line": "Rail systems run around the clock and fill vacancies with overtime."}, "wt": [0.0, 0.29, 0.72, 0.9, 1.15, 1.23, 1.64, 1.83, 2.06, 2.65, 2.82]}, {"scene": "lead1", "kind": "quote", "ref": ["suspicious[0].why"], "text": "Being first says where the question is, not what the answer is.", "t0": 47.32, "t1": 49.93, "shot": "b7", "visual": {"type": "quote", "line": "Rail systems run around the clock and fill vacancies with overtime."}, "wt": [0.0, 0.29, 0.55, 0.77, 0.9, 0.98, 1.37, 1.56, 1.7, 1.84, 1.95, 2.31]}, {"scene": "lead2", "kind": "scene", "ref": ["suspicious[1]"], "text": "Now count the positions paid at least as much in overtime as in salary.", "t0": 50.15, "t1": 53.52, "shot": "b8", "visual": {"type": "scene", "art": "magnifier", "label": "Overtime at least equal to regular pay", "kicker": "Regular pay of $40,000 or more", "sub": "2019 to 2025"}, "wt": [0.0, 0.23, 0.48, 0.56, 1.05, 1.3, 1.39, 1.61, 1.73, 1.92, 2.02, 2.52, 2.67, 2.8]}, {"scene": "lead2", "kind": "scene", "ref": ["suspicious[1]"], "text": "From 2019 to 2025, across the payrolls compared, 444 position-years.", "t0": 53.64, "t1": 59.25, "shot": "b8", "visual": {"type": "scene", "art": "magnifier", "label": "Overtime at least equal to regular pay", "kicker": "Regular pay of $40,000 or more", "sub": "2019 to 2025"}, "wt": [0.0, 0.2, 0.49, 0.92, 1.0, 1.27, 1.89, 2.26, 2.35, 2.79, 3.27, 3.54, 3.86, 4.38]}, {"scene": "lead2", "kind": "scene", "ref": ["suspicious[1]"], "text": "How many at BART?", "t0": 59.25, "t1": 60.38, "shot": "b8", "visual": {"type": "scene", "art": "magnifier", "label": "Overtime at least equal to regular pay", "kicker": "Regular pay of $40,000 or more", "sub": "2019 to 2025"}, "wt": [0.04, 0.23, 0.45, 0.55]}, {"scene": "lead2", "kind": "slam", "ref": ["suspicious[1].what", "oneLine"], "text": "440.", "t0": 60.38, "t1": 61.23, "shot": "b9", "visual": {"type": "slam", "words": ["440"], "sub": "of the 444 position-years are BART’s"}, "emph": ["440"], "wt": [0.04, 0.25, 0.5]}, {"scene": "lead2", "kind": "rank", "ref": ["suspicious[1].what"], 