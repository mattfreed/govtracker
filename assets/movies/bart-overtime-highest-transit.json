, "visual": {"type": "unknowns", "cards": ["That any overtime was not worked: the export has no hours", "Who holds any position: the export has no names"]}, "wt": [0.0, 0.12, 0.48, 0.74, 0.99, 1.12, 1.32, 1.79, 2.03]}, {"scene": "close", "kind": "unknowns", "ref": ["notEstablished[0]", "notEstablished[1]", "notEstablished[2]"], "text": "The export has no hours, and no names. A position is a row, not a person.", "t0": 140.69, "t1": 145.07, "shot": "b16", "visual": {"type": "unknowns", "cards": ["That any overtime was not worked: the export has no hours", "Who holds any position: the export has no names"]}, "wt": [0.0, 0.15, 0.55, 0.74, 0.91, 1.39, 1.58, 1.75, 2.59, 2.72, 3.12, 3.24, 3.31, 3.66, 3.82, 3.89]}, {"scene": "close", "kind": "settle", "ref": ["next[1]", "next[2]"], "text": "What would settle it? BART’s timesheets for those positions, and its rules on staffing and call-backs.", "t0": 145.19, "t1": 150.47, "shot": "b17", "visual": {"type": "settle", "cards": [{"who": "", "what": "Hours and timesheets behind the positions paid more in overtime than salary"}, {"who": "", "what": "BART’s labor agreements: minimum-staffing and call-back rules"}], "focus": 0}, "wt": [0.0, 0.11, 0.27, 0.57, 1.26, 1.65, 2.27, 2.42, 2.63, 3.22, 3.4, 3.56, 3.89, 4.04, 4.49, 4.6]}, {"scene": "close", "kind": "status", "ref": ["status", "defense[0]"], "text": "No authority has reviewed these figures, and no employee is accused.", "t0": 150.59, "t1": 153.76, "shot": "b18", "visual": {"type": "status"}, "wt": [0.0, 0.21, 0.64, 0.77, 1.11, 1.3, 1.68, 1.81, 1.95, 2.46, 2.58]}, {"scene": "close", "kind": "end", "ref": ["end"], "text": "A lead is a question, not an accusation.", "t0": 153.88, "t1": 155.81, "shot": "b19", "visual": {"type": "end"}, "wt": [0.0, 0.15, 0.38, 0.48, 0.53, 0.96, 1.13, 1.21]}], "format": 6, "chapters": {"open": "One position", "lead1": "Lead 1 · first by share of pay", "lead2": "Lead 2 · 440 position-years", "lead3": "Lead 3 · the top of the payroll", "close": "Where it stands", "pension": "Pensionable pay"}, "look": "midnight", "hook": "person"}