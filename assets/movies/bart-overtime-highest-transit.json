Transit System", "14.6%"], ["Muni", "13.1%"], ["Golden Gate Bridge district", "7.4%"]]}, "emph": ["16.2 percent"], "wt": [0.04, 0.23, 0.52, 1.16, 1.51, 1.78, 2.29, 2.55, 2.64, 3.11, 3.35, 3.55, 3.91, 4.01, 4.38]}, {"scene": "lead1", "kind": "rank", "ref": ["suspicious[0]", "suspicious[0].what"], "text": "By that share, first of 13 transit payrolls.", "t0": 30.31, "t1": 33.28, "shot": "b5", "visual": {"type": "rank", "label": "Overtime as a share of regular pay, 2024", "rows": [["BART", "16.2%"], ["San Diego Transit Corporation", "15.7%"], ["Sacramento Regional Transit System", "14.6%"], ["Muni", "13.1%"], ["Golden Gate Bridge district", "7.4%"]]}, "wt": [0.0, 0.17, 0.39, 0.71, 0.98, 1.07, 1.53, 1.93]}, {"scene": "lead1", "kind": "rank", "ref": ["suspicious[0]", "suspicious[0].what"], "text": "Muni: 13.1. The Golden Gate Bridge district: 7.4.", "t0": 33.28, "t1": 37.84, "shot": "b5", "visual": {"type": "rank", "label": "Overtime as a share of regular pay, 2024", "rows": [["BART", "16.2%"], ["San Diego Transit Corporation", "15.7%"], ["Sacramento Regional Transit System", "14.6%"], ["Muni", "13.1%"], ["Golden Gate Bridge district", "7.4%"]]}, "wt": [0.04, 0.64, 1.1, 1.4, 2.13, 2.3, 2.61, 2.83, 3.16, 3.61, 3.92, 4.19]}, {"scene": "lead1", "kind": "bignum", "ref": ["amount", "links[0]", "suspicious[0].what"], "text": "That’s 75.6 million dollars of overtime, about 16,162 dollars per paid position.", "t0": 37.96, "t1": 44.33, "shot": "b6", "visual": {"type": "bignum", "value": "$75.6 million", "label": "BART overtime, 2024", "sub": "16,162 dollars per paid position"}, "emph": ["75.6 million"], "wt": [0.0, 0.25, 0.83, 1.1, 1.38, 1.69, 2.02, 2.12, 2.83, 3.15, 3.61, 4.05, 4.24, 4.55, 5.08, 5.44, 5.58, 5.82]}, {"scene": "lead1", "kind": "quote", "ref": ["suspicious[0].why"], "text": "Rail systems run around the clock, and fill vacancies with overtime.", "t0": 44.45, "t1": 47.95, "shot": "b7", "visual": {"type": "quote", "line": "Rail systems run around the clock and fill vacancies with overtime."}, "wt": [0.0, 0.3, 0.73, 0.92, 1.17, 1.25, 1.66, 1.86, 2.1, 2.7, 2.86]}, {"scene": "lead1", "kind": "quote", "ref": ["suspicious[0].why"], "text": "Being first says where the question is, not what the answer is.", "t0": 48.07, "t1": 50.72, "shot": "b7", "visual": {"type": "quote", "line": "Rail systems run around the clock and fill vacancies with overtime."}, "wt": [0.0, 0.3, 0.56, 0.78, 0.91, 0.99, 1.39, 1.58, 1.73, 1.87, 1.99, 2.35]}, {"scene": "lead2", "kind": "scene", "ref": ["suspicious[1]"], "text": "Now count the positions paid at least as much in overtime as in salary.", "t0": 50.94, "t1": 54.35, "shot": "b8", "visual": {"type": "scene", "art": "magnifier", "label": "Overtime at least equal to regular pay", "kicker": "Regular pay of $40,000 or more", "sub": "2019 to 2025"}, "wt": [0.0, 0.24, 0.49, 0.57, 1.07, 1.32, 1.42, 1.63, 1.76, 1.96, 2.06, 2.57, 2.71, 2.84]}, {"scene": "lead2", "kind": "scene", "ref": ["suspicious[1]"], "text": "From 2019 to 2025, across the payrolls compared, 444 position-years.", "t0": 54.47, "t1": 60.17, "shot": "b8", "visual": {"type": "scene", "art": "magnifier", "label": "Overtime at least equal to regular pay", "kicker": "Regular pay of $40,000 or more", "sub": "2019 to 2025"}, "wt": [0.0, 0.21, 0.5, 0.94, 1.01, 1.29, 1.92, 2.29, 2.39, 2.83, 3.32, 3.6, 3.92, 4.46]}, {"scene": "lead2", "kind": "scene", "ref": ["suspicious[1]"], "text": "How many at BART?", "t0": 60.17, "t1": 61.31, "shot": "b8", "visual": {"type": "scene", "art": "magnifier", "label": "Overtime at least equal to regular pay", "kicker": "Regular pay of $40,000 or more", "sub": "2019 to 2025"}, "wt": [0.04, 0.24, 0.45, 0.56]}, {"scene": "lead2", "kind": "slam", "ref": ["suspicious[1].what", "oneLine"], "text": "440.", "t0": 61.31, "t1": 62.18, "shot": "b9", "visual": {"type": "slam", "words": ["440"], "sub": "of the 444 position-years are BART’s"}, "emph": ["440"], "wt": [0.04, 0.26, 0.51]}, {"scene": "lead2", "kind": "rank", "ref": ["suspicious[1].what"], "text": "Train Operator, 69 times. Senior Operations Foreworker, 50. Electrician, 47.", "t0": 62.7, "t1": 68.9, "shot": "b10", "visual": {"type": "rank", "label": "Commonest BART positions among them", "rows": [["Train Operator", "69"], ["Senior Operations Foreworker", "50"], ["Electrician", "47"]]}, "emph": ["Train Operator"], "wt": [0.0, 0.32, 0.77, 1.37, 2.29, 2.72, 3.26, 3.87, 4.7, 5.43]}, {"scene": "lead2", "kind": "quote", "ref": ["suspicious[1].why"], "text": "Overtime larger than a full salary means a second full-time job’s worth of hours.", "t0": 69.02, "t1": 73.17, "shot": "b11", "visual": {"type": "quote", "line": "a second full-time job’s worth of hours"}, "emph": ["second full-time job"], "wt": [0.0, 0.63, 0.97, 1.11, 1.17, 1.4, 1.83, 2.08, 2.16, 2.47, 2.98, 3.31, 3.55, 3.64]}, {"scene": "lead2", "kind": "quote", "ref": ["suspicious[1].why"], "text": "Timesheets would show whether one person worked them.", "t0": 73.29, "t1": 75.56, "shot": "b11", "visual": {"type": "quote", "line": "a second full-time job’s worth of hours"}, "wt": [0.0, 0.56, 0.74, 0.95, 1.2, 1.37, 1.71, 1.97]}, {"scene": "lead3", "kind": "scene", "ref": ["suspicious[2]", "timeline[2]"], "text": "Then the top of the payroll.", "t0": 75.78, "t1": 76.84, "shot": "b12", "visual": {"type": "scene", "art": "money", "label": "Asst Gm Finance, Interim", "kicker": "Highest total wages, 2025", "chip": "$673,318"}, "wt": [0.0, 0.16, 0.24, 0.45, 0.51, 0.59]}, {"scene": "lead3", "kind": "scene", "ref": ["suspicious[2]", "timeline[2]"], "text": "In 2025, the highest total wages went to an interim assistant general manager for finance.", "t0": 76.96, "t1": 81.95, "shot": "b12", "visual": {"type": "scene", "art": "money", "label": "Asst Gm Finance, Interim", "kicker": "Highest total wages, 2025", "chip": "$673,318"}, "wt": [0.0, 0.13, 0.41, 1.04, 1.15, 1.49, 1.76, 2.18, 2.39, 2.49, 2.61, 3.02, 3.5, 3.82, 4.2, 4.35]}, {"scene": "lead3", "kind": "bignum", "ref": ["suspicious[2].what", "timeline[2]"], "text": "673,318 dollars.", "t0": 82.07, "t1": 85.73, "shot": "b13", "visual": {"type": "bignum", "value": "$673,318", "label": "total wages, 2025", "sub": "$495,152 of it other pay"}, "emph": ["673,318"], "wt": [0.0, 0.32, 0.63, 1.17, 1.62, 1.84, 2.11, 2.49]}, {"scene": "lead3", "kind": "bignum", "ref": ["suspicious[2].what", "timeline[2]"], "text": "495,152 of it, other pay.", "t0": 85.73, "t1": 89.68, "shot": "b13", "visual": {"type": "bignum", "value": "$673,318", "label": "total wages, 2025", "sub": "$495,152 of it other pay"}, "wt": [0.04, 0.31, 0.61, 1.15, 1.56, 1.75, 2.02, 2.53, 2.65, 3.28, 3.6]}, {"scene": "lead3", "kind": "rank", "ref": ["suspicious[2].what"], "text": "Next, a Police Sergeant: 601,013 dollars.", "t0": 90.1, "t1": 95.72, "shot": "b14", "visual": {"type": "rank", "label": "Highest total wages, BART, 2025", "rows": [["Asst Gm Finance, Interim", "$673,318"], ["Police Sergeant (84 Hr)", "$601,013"], ["Sr Police Officer-Adv. (84 Hr)", "$560,607"], ["General Manager", "$477,893"]]}, "wt": [0.0, 1.15, 1.29, 1.6, 2.73, 3.02, 3.37, 3.58, 4.0, 4.45]}, {"scene": "lead3", "kind": "rank", "ref": ["suspicious[2].what"], "text": "A senior police officer: 560,607.", "t0": 95.72, "t1": 99.57, "shot": "b14", "visual": {"type": "rank", "label": "Highest total wages, BART, 2025", "rows": [["Asst Gm Finance, Interim", "$673,318"], ["Police Sergeant (84 Hr)", "$601,013"], ["Sr Police Officer-Adv. (84 Hr)", "$560,607"], ["General Manager", "$477,893"]]}, "wt": [0.04, 0.22, 0.57, 0.9, 1.34, 1.64, 1.99, 2.38, 2.84, 3.08, 3.4]}, {"scene": "lead3", "kind": "rank", "ref": ["suspicious[2].what"], "text": "The General Manager: 477,893.", "t0": 99.69, "t1": 103.66, "shot": "b14", "visual": {"type": "rank", "label": "Highest total wages, BART, 2025", "rows": [["Asst Gm Finance, Interim", "$673,318"], ["Police Sergeant (84 Hr)", "$601,013"], ["Sr Police Officer-Adv. (84 Hr)", "$560,607"], ["General Manager", "$477,893"]]}, "wt": [0.0, 0.12, 0.43, 1.03, 1.3, 1.64, 2.25, 2.76, 3.01, 3.31]}, {"scene": "lead3", "kind": "quote", "ref": ["suspicious[2].why", "innocent[2]"], "text": "The highest-paid are mostly police, where overtime and other pay exceed the salary.", "t0": 103.78, "t1": 107.66, "shot": "b15", "visual": {"type": "quote", "line": "The highest-paid positions are mostly police, where overtime and other pay exceed the salary."}, "wt": [0.0, 0.12, 0.61, 0.71, 1.03, 1.5, 1.74, 2.27, 2.39, 2.62, 2.94, 3.29, 3.36]}, {"scene": "lead3", "kind": "quote", "ref": ["suspicious[2].why", "innocent[2]"], "text": "A one-year payout of banked leave also looks like this.", "t0": 107.78, "t1": 110.52, "shot": "b15", "visual": {"type": "quote", "line": "The highest-paid positions are mostly police, where overtime and other pay exceed the salary."}, "wt": [0.0, 0.15, 0.55, 0.94, 1.04, 1.34, 1.66, 1.96, 2.2, 2.38]}, {"scene": "close", "kind": "unknowns", "ref": ["notEstablished[0]", "notEstablished[1]", "notEstablished[2]"], "text": "The records don’t show that any overtime went unworked.", "t0": 110.74, "t1": 113.37, "shot": "b16", "visual": {"type": "unknowns", "cards": ["That any overtime was not worked: the export has no hours", "Who holds any position: the export has no names"]}, "wt": [0.0, 0.13, 0.49, 0.76, 1.0, 1.14, 1.35, 1.82, 2.06]}, {"scene": "close", "kind": "unknowns", "ref": ["notEstablished[0]", "notEstablished[1]", "notEstablished[2]"], "text": "The export has no hours, and no names. A position is a row, not a person.", "t0": 113.49, "t1": 117.93, "shot": "b16", "visual": {"type": "unknowns", "cards": ["That any overtime was not worked: the export has no hours", "Who holds any position: the export has no names"]}, "wt": [0.0, 0.15, 0.56, 0.75, 0.93, 1.41, 1.61, 1.78, 2.63, 2.77, 3.17, 3.3, 3.37, 3.72, 3.89, 3.95]}, {"scene": "close", "kind": "settle", "ref": ["next[1]", "next[2]"], "text": "What would settle it? BART’s timesheets for those positions, and its rules on staffing and call-backs.", "t0": 118.05, "t1": 123.4