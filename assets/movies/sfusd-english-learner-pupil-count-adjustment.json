{"id": "sfusd-english-learner-pupil-count-adjustment", "title": "A school database error overstated the funding count by 325 pupils", "seconds": 40.3, "voice": "elevenlabs:OtHu0lbpdNTqJVqaxDtR", "narrator": "Maven", "made": "2026-11-28", "key": "31058b83742a6d52", "words": 131, "beats": [{"scene": "p", "kind": "compare", "ref": ["suspicious[0]", "established[0]"], "text": "A database upload changed how much school funding San Francisco reported.", "t0": 0.2, "t1": 3.7, "shot": "s0", "visual": {"type": "compare", "rows": [["Certified count", "97,386"], ["After correction", "97,061"]]}, "wt": [0.0, 0.11, 0.58, 1.01, 1.37, 1.51, 1.69, 1.96, 2.29, 2.47, 2.98]}, {"scene": "p", "kind": "doc", "ref": ["suspicious[0]", "established[0]"], "text": "Auditors checked all pupils classified as English learners.", "t0": 3.82, "t1": 6.75, "shot": "s1", "visual": {"type": "doc", "source": "original", "kicker": "A database upload overstated eligibility", "text": "English learners", "mark": "English"}, "wt": [0.0, 0.51, 0.82, 1.02, 1.48, 2.0, 2.12, 2.43]}, {"scene": "p", "kind": "bignum", "ref": ["suspicious[0]", "established[0]"], "text": "They found 325 pupils who did not qualify for that count.", "t0": 6.87, "t1": 10.11, "shot": "s2", "visual": {"type": "bignum", "value": "325 pupils", "label": "A database upload overstated eligibility"}, "wt": [0.0, 0.13, 0.34, 0.56, 0.81, 1.28, 1.67, 1.8, 1.95, 2.14, 2.59, 2.72, 2.91]}, {"scene": "b", "kind": "doc", "ref": ["suspicious[1]", "established[1]"], "text": "One group should have been classified as English only.", "t0": 10.33, "t1": 12.58, "shot": "s3", "visual": {"type": "doc", "source": "original", "kicker": "One count fell by 325", "text": "English only", "mark": "English"}, "wt": [0.0, 0.24, 0.51, 0.68, 0.8, 0.93, 1.46, 1.59, 1.93]}, {"scene": "b", "kind": "compare", "ref": ["suspicious[1]", "established[1]"], "text": "Another group had been reclassified.", "t0": 12.7, "t1": 14.41, "shot": "s4", "visual": {"type": "compare", "rows": [["English only", "255"], ["Reclassified", "70"]]}, "wt": [0.0, 0.37, 0.62, 0.73, 0.89]}, {"scene": "b", "kind": "quote", "ref": ["suspicious[1]", "established[1]"], "text": "The enrollment count itself stayed the same.", "t0": 14.53, "t1": 16.32, "shot": "s5", "visual": {"type": "quote", "line": "Enrollment count"}, "wt": [0.0, 0.09, 0.51, 0.72, 1.08, 1.31, 1.42]}, {"scene": "b", "kind": "bignum", "ref": ["suspicious[1]", "established[1]"], "text": "The audit put the funding correction at $585,496.", "t0": 16.44, "t1": 21.97, "shot": "s6", "visual": {"type": "bignum", "value": "$585,496", "label": "One count fell by 325"}, "wt": [0.0, 0.15, 0.51, 0.68, 0.79, 1.09, 1.52, 1.62, 1.91, 2.29, 2.81, 3.7, 4.02, 4.38, 4.94]}, {"scene": "b", "kind": "doc", "ref": ["suspicious[2]", "established[2]"], "text": "The next audit marked the original finding resolved.", "t0": 22.09, "t1": 24.35, "shot": "s7", "visual": {"type": "doc", "source": "next", "kicker": "Two certifications show the same adjustment", "text": "Original finding", "mark": "Original"}, "wt": [0.0, 0.11, 0.35, 0.62, 0.91, 1.03, 1.4, 1.72]}, {"scene": "b", "kind": "compare", "ref": ["suspicious[2]", "established[2]"], "text": "Later state schedules show a figure just $2 away.", "t0": 24.47, "t1": 27.07, "shot": "s8", "visual": {"type": "compare", "rows": [["Audit", "$585,496"], ["State adjustment", "−$585,498"]]}, "wt": [0.0, 0.3, 0.54, 1.01, 1.21, 1.29, 1.6, 1.8, 1.98, 2.25]}, {"scene": "b", "kind": "quote", "ref": ["suspicious[2]", "established[2]"], "text": "The schedules repeat one adjustment for the same district and year.", "t0": 27.19, "t1": 29.75, "shot": "s9", "visual": {"type": "quote", "line": "One adjustment"}, "wt": [0.0, 0.09, 0.49, 0.76, 0.92, 1.38, 1.51, 1.61, 1.82, 2.17, 2.27]}, {"scene": "b", "kind": "quote", "ref": ["suspicious[2]", "established[2]"], "text": "The schedules omit the finding number.", "t0": 29.87, "t1": 31.48, "shot": "s10", "visual": {"type": "quote", "line": "State aid adjustment"}, "wt": [0.0, 0.09, 0.54, 0.78, 0.89, 1.22]}, {"scene": "o", "kind": "doc", "ref": ["suspicious[3]", "established[3]"], "text": "In 2025, a separate audit used a sample.", "t0": 31.7, "t1": 34.28, "shot": "s11", "visual": {"type": "doc", "source": "original", "kicker": "A later audit used a different method", "text": "Separate audit", "mark": "Separate"}, "wt": [0.0, 0.1, 0.33, 1.0, 1.1, 1.42, 1.77, 2.02, 2.09]}, {"scene": "o", "kind": "quote", "ref": ["suspicious[3]", "established[3]"], "text": "The 325 came from checking the whole group.", "t0": 34.4, "t1": 37.19, "shot": "s12", "visual": {"type": "quote", "line": "325 pupils"}, "wt": [0.0, 0.14, 0.39, 0.62, 1.29, 1.5, 1.66, 2.02, 2.12, 2.34]}, {"scene": "o", "kind": "end", "ref": ["status"], "text": "Every source is linked in the case file below.", "t0": 37.31, "t1": 39.45, "shot": "end", "visual": {"type": "end"}, "wt": [0.0, 0.31, 0.65, 0.8, 1.06, 1.17, 1.26, 1.5, 1.76]}], "format": 6, "chapters": {"p": "A database upload overstated eligibility", "b": "One count fell by 325", "o": "A later audit used a different method"}, "look": "newsroom", "hook": "document"}