{"id": "practice-fusion-opioid-alert-kickbacks", "title": "An opioid maker paid a San Francisco software company to put an alert in medical records", "seconds": 55.5, "voice": "elevenlabs:exurTFaGNF2gnRcPNH8I", "narrator": "Phil", "made": "2026-11-25", "key": "afdf5775d28d38a9", "words": 145, "beats": [{"scene": "open", "kind": "hook", "ref": ["suspicious[0]", "established[0]"], "text": "Purdue Pharma helped design a pain-management alert in Practice Fusion’s electronic medical record software.", "t0": 0.2, "t1": 5.79, "shot": "r0", "visual": {"type": "hook", "words": ["Who", "helped", "design", "the", "alert?"], "sub": "Practice Fusion"}, "wt": [0.0, 0.36, 0.74, 0.97, 1.33, 1.43, 2.15, 2.45, 2.59, 3.03, 3.48, 4.06, 4.46, 4.79]}, {"scene": "open", "kind": "bignum", "ref": ["suspicious[0]", "established[0]"], "text": "Purdue paid the San Francisco company 959,700 dollars.", "t0": 5.91, "t1": 11.11, "shot": "r1", "visual": {"type": "bignum", "value": "$959,700", "label": "Purdue payment under the 2016 contract"}, "wt": [0.0, 0.42, 0.65, 0.77, 0.98, 1.52, 2.31, 2.68, 3.01, 3.53, 4.07, 4.39, 4.67]}, {"scene": "open", "kind": "doc", "ref": ["suspicious[0]", "established[0]"], "text": "The company admitted the alert was meant to increase extended-release opioid prescriptions.", "t0": 11.23, "t1": 15.74, "shot": "r2", "visual": {"type": "doc", "source": "dpa", "kicker": "U.S. District Court for the District of Vermont / DOJ", "text": "Clinical alert", "mark": "Clinical alert"}, "wt": [0.0, 0.14, 0.51, 0.85, 0.96, 1.25, 1.43, 1.65, 1.81, 2.27, 3.13, 3.55]}, {"scene": "open", "kind": "quote", "ref": ["suspicious[0]", "established[0]"], "text": "The alert triggered roughly 230 million times nationwide.", "t0": 15.86, "t1": 19.81, "shot": "r3", "visual": {"type": "quote", "line": "Nationwide alerts"}, "wt": [0.0, 0.12, 0.43, 0.87, 1.28, 1.52, 1.84, 2.14, 2.49, 2.9]}, {"scene": "resolution", "kind": "doc", "ref": ["suspicious[1]", "established[1]"], "text": "Practice Fusion admitted criminal kickback conduct under a deferred prosecution agreement.", "t0": 20.03, "t1": 24.3, "shot": "r4", "visual": {"type": "doc", "source": "dpa", "kicker": "U.S. District Court for the District of Vermont / DOJ", "text": "January 2020", "mark": "January 2020"}, "wt": [0.0, 0.45, 0.83, 1.23, 1.61, 2.06, 2.55, 2.79, 2.86, 3.28, 3.88]}, {"scene": "resolution", "kind": "record", "ref": ["suspicious[1]", "established[1]"], "text": "The 145 million dollar resolution included a fine, forfeiture and a civil settlement.", "t0": 24.42, "t1": 29.67, "shot": "r5", "visual": {"type": "record", "layout": "amounts", "context": "Nationwide resolution", "heading": "Three distinct amounts", "source": "hhs", "rows": [{"icon": "file", "label": "Criminal fine", "value": "$25,398,300"}, {"icon": "transfer", "label": "Forfeiture", "value": "$959,700"}, {"icon": "file", "label": "Civil settlement", "value": "$118,642,000"}]}, "wt": [0.0, 0.15, 0.33, 0.59, 1.08, 1.32, 1.56, 2.21, 2.71, 2.81, 3.44, 4.24, 4.45, 4.54, 4.85]}, {"scene": "resolution", "kind": "doc", "ref": ["suspicious[1]", "established[1]"], "text": "Veradigm reported the amounts paid in full by December 31, 2020.", "t0": 29.79, "t1": 34.17, "shot": "r6", "visual": {"type": "doc", "source": "filing", "kicker": "Veradigm / U.S. Securities and Exchange Commission", "text": "Payment reported", "mark": "Payment reported"}, "wt": [0.0, 0.61, 1.01, 1.1, 1.45, 1.73, 1.89, 2.23, 2.38, 2.81, 3.41, 3.75]}, {"scene": "monitor", "kind": "doc", "ref": ["established[2]"], "text": "Prosecutors and the company later disputed compliance with the monitoring terms.", "t0": 34.39, "t1": 38.48, "shot": "r7", "visual": {"type": "doc", "source": "extend", "kicker": "U.S. District Court for the District of Vermont / DOJ", "text": "Outside monitor", "mark": "Outside monitor"}, "wt": [0.0, 0.61, 0.72, 0.82, 1.25, 1.53, 2.0, 2.62, 2.77, 2.87, 3.4]}, {"scene": "monitor", "kind": "quote", "ref": ["established[2]"], "text": "They agreed to a separate 200,000 dollar payment and an eleven-week extension.", "t0": 38.6, "t1": 42.77, "shot": "r8", "visual": {"type": "quote", "line": "March 2022"}, "wt": [0.0, 0.14, 0.44, 0.57, 0.66, 1.02, 1.2, 1.43, 1.75, 2.01, 2.52, 2.88, 3.0, 3.58]}, {"scene": "monitor", "kind": "doc", "ref": ["established[2]"], "text": "Veradigm reported dismissal of the criminal information effective May 9, 2023.", "t0": 42.89, "t1": 48.25, "shot": "r9", "visual": {"type": "doc", "source": "filing", "kicker": "Veradigm / U.S. Securities and Exchange Commission", "text": "May 2023 dismissal", "mark": "May 2023 dismissal"}, "wt": [0.0, 0.76, 1.24, 1.82, 1.96, 2.09, 2.49, 3.06, 3.55, 3.77, 4.43, 4.77]}, {"scene": "monitor", "kind": "unknowns", "ref": ["notEstablished[0]"], "text": "The national resolution does not establish a dollar loss to San Francisco.", "t0": 48.37, "t1": 52.1, "shot": "r10", "visual": {"type": "unknowns", "cards": ["Prescriptions", "San Francisco payments"]}, "wt": [0.0, 0.13, 0.55, 1.12, 1.32, 1.53, 2.05, 2.14, 2.48, 2.78, 2.92, 3.13]}, {"scene": "monitor", "kind": "end", "ref": ["status"], "text": "Every source is linked in the case file below.", "t0": 52.22, "t1": 54.59, "shot": "r11", "visual": {"type": "end"}, "wt": [0.0, 0.32, 0.72, 0.94, 1.27, 1.38, 1.49, 1.76, 2.01]}], "format": 6, "chapters": {"open": "A clinical alert with a sponsor", "resolution": "The federal resolution", "monitor": "What happened afterwards"}, "look": "flow", "hook": "contrast"}