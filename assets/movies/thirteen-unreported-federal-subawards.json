.10", "mark": "$58,000.10"}}, {"scene": "o", "kind": "quote", "ref": ["suspicious[3]", "established[3]"], "text": "Its action date does not tell us when the missing report was filed.", "t0": 39.1, "t1": 42.29, "shot": "s12", "visual": {"type": "quote", "line": "Action date"}}, {"scene": "o", "kind": "end", "ref": ["status"], "text": "Every source is linked in the case file below.", "t0": 42.41, "t1": 44.63, "shot": "end", "visual": {"type": "end"}}], "audioStatus": "temporary-local", "audioProvider": "tiny-voca", "format": 6, "chapters": {"p": "Federal disclosure had a $25,000 threshold", "b": "Thirteen covered awards were missing", "o": "Follow the workforce award into Treasury’s register"}, "look": "newsroom", "hook": "question"}