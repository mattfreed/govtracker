 0.86, 1.32]}, {"scene": "lead3", "kind": "doc", "ref": ["suspicious[2]", "sources[21]", "established[12]"], "text": "Crestwood guaranteed Helios’s performance and managed the facility.", "t0": 73.51, "t1": 76.38, "shot": "r23", "visual": {"type": "doc", "source": "bd25a", "kicker": "Appendix J · May 2021", "text": "Related Entity Guarantee", "mark": "Guarantee"}, "wt": [0.0, 0.44, 0.87, 1.3, 1.77, 1.95, 2.27, 2.37]}, {"scene": "lead3", "kind": "bignum", "ref": ["suspicious[2].why", "suspicious[0].what", "notEstablished[1]"], "text": "Together, the two agreements come to 252,121,319 dollars.", "t0": 76.5, "t1": 80.44, "shot": "b12b", "visual": {"type": "bignum", "value": "$252,121,319", "label": "the Helios and Crestwood agreements together", "sub": "sized as two operators, or as one?"}, "emph": ["252,121,319"], "wt": [0.0, 0.46, 0.58, 0.75, 1.12, 1.34, 1.46, 1.66, 1.84, 2.14, 2.61, 2.88, 3.05, 3.33]}, {"scene": "lead3", "kind": "scene", "ref": ["suspicious[2]", "sources[21]"], "text": "The guarantee describes management and financial support. It disclaims direct ownership.", "t0": 80.56, "t1": 84.84, "shot": "r25", "visual": {"type": "scene", "art": "contract", "label": "Crestwood and Helios", "sub": "Management and financial support"}, "wt": [0.0, 0.13, 0.55, 1.02, 1.48, 1.62, 2.03, 2.88, 3.02, 3.49, 3.78]}, {"scene": "lead4", "kind": "span", "ref": ["suspicious[3]", "timeline[6]", "timeline[8]"], "text": "Two more: Garfield Nursing Home Inc and Medical Hill Healthcare Center.", "t0": 85.06, "t1": 88.68, "shot": "b13", "visual": {"type": "span", "from": "2025-07-01", "to": "2026-07-01", "days": "", "fromLab": "business-registration start date", "toLab": "Public Health contract begins", "kicker": "Garfield Nursing Home Inc · Medical Hill Healthcare Center"}, "wt": [0.0, 0.22, 1.1, 1.51, 1.76, 1.92, 2.18, 2.38, 2.71, 2.92, 3.32]}, {"scene": "lead4", "kind": "span", "ref": ["suspicious[3]", "timeline[6]", "timeline[8]"], "text": "Each registered to do business here o