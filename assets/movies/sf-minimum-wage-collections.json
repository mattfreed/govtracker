{"id": "sf-minimum-wage-collections", "title": "Less than half the assessed back wages had reached workers by the cutoff", "seconds": 43.7, "voice": "elevenlabs:9PVP7ENhDskL0KYHAKtD", "narrator": "Jerry B.", "made": "2026-11-27", "key": "85af607d33bb0fab", "words": 132, "beats": [{"scene": "p", "kind": "hook", "ref": ["suspicious[0]", "established[0]"], "text": "San Francisco recorded $1,267,041 in back wages and interest under its minimum wage ordinance.", "t0": 0.2, "t1": 6.28, "shot": "r0", "visual": {"type": "hook", "words": ["What", "reached", "workers"], "sub": "Minimum wage collections"}, "wt": [0.0, 0.26, 0.87, 1.33, 1.67, 1.95, 2.26, 2.56, 2.89, 3.28, 3.4, 3.66, 4.02, 4.15, 4.51, 4.75, 4.91, 5.31, 5.62]}, {"scene": "p", "kind": "bignum", "ref": ["suspicious[0]", "established[0]"], "text": "By November 15, 2010, employers had paid $609,959.", "t0": 6.4, "t1": 12.37, "shot": "r1", "visual": {"type": "bignum", "value": "$609,959", "label": "Wages and interest paid"}, "wt": [0.0, 0.19, 0.62, 1.17, 1.53, 2.13, 2.67, 2.79, 3.07, 3.35, 3.71, 3.98, 4.45, 4.7, 4.99, 5.53]}, {"scene": "p", "kind": "quote", "ref": ["suspicious[0]", "established[0]"], "text": "That was 48%.", "t0": 12.49, "t1": 13.92, "shot": "r2", "visual": {"type": "quote", "line": "That was 48%"}, "wt": [0.0, 0.23, 0.43, 0.97]}, {"scene": "p", "kind": "doc", "ref": ["established[0]"], "text": "Back wages and enforcement penalties appear in separate columns.", "t0": 14.04, "t1": 16.98, "shot": "detail0", "visual": {"type": "doc", "kicker": "San Francisco Budget and Legislative Analyst", "source": "review", "text": "Back wages and enforcement penalties appear in separate columns", "mark": "Back wages and enforcement penalties appear in separate columns"}, "wt": [0.0, 0.27, 0.59, 0.71, 1.22, 1.65, 1.99, 2.1, 2.45]}, {"scene": "b", "kind": "bignum", "ref": ["suspicious[1]", "established[1]"], "text": "Employers also owed $125,206 in penalties and enforcement costs.", "t0": 17.2, "t1": 22.5, "shot": "r3"