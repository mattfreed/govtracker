{"id": "zhou-mayoral-campaign-billboard-coordination", "title": "A $10,000 billboard expenditure was coordinated with a mayoral campaign", "seconds": 40.1, "voice": "elevenlabs:OtHu0lbpdNTqJVqaxDtR", "narrator": "Maven", "made": "2026-11-27", "key": "0c03cd8a9f1ca4a9", "words": 128, "beats": [{"scene": "p", "kind": "hook", "ref": ["suspicious[0]", "established[0]"], "text": "In 2019, Ellen Lee Zhou ran for mayor of San Francisco.", "t0": 0.2, "t1": 3.67, "shot": "r0", "visual": {"type": "hook", "words": ["Who", "controlled", "the", "advertising"], "sub": "Mayoral campaign"}, "wt": [0.0, 0.1, 0.38, 1.11, 1.42, 1.58, 1.98, 2.22, 2.37, 2.6, 2.68, 2.86]}, {"scene": "p", "kind": "quote", "ref": ["suspicious[0]", "established[0]"], "text": "A political committee reported spending $10,000 independently to support her.", "t0": 3.79, "t1": 7.92, "shot": "r0-more1", "visual": {"type": "quote", "line": "A political committee reported spending $10,000 independently to support her"}, "wt": [0.0, 0.12, 0.56, 0.94, 1.36, 1.75, 1.99, 2.35, 2.73, 3.43, 3.53, 3.9]}, {"scene": "p", "kind": "bignum", "ref": ["suspicious[0]", "established[0]"], "text": "The question was who arranged the advertising.", "t0": 8.04, "t1": 9.94, "shot": "r1", "visual": {"type": "bignum", "value": "$10,000", "label": "Coordinated expenditure"}, "wt": [0.0, 0.1, 0.45, 0.58, 0.73, 1.07, 1.18]}, {"scene": "p", "kind": "quote", "ref": ["suspicious[0]", "established[0]"], "text": "The Ethics Commission found that Paul Allen Taylor had acted for the campaign.", "t0": 10.06, "t1": 13.28, "shot": "r1-more1", "visual": {"type": "quote", "line": "The Ethics Commission found that Paul Allen Taylor had acted for the campaign"}, "wt": [0.0, 0.12, 0.44, 0.86, 1.08, 1.2, 1.45, 1.69, 2.04, 2.17, 2.45, 2.57, 2.68]}, {"scene": "p", "kind": "quote", "ref": ["suspicious[0]", "established[0]"], "text": "It found that he coordinated the advertising.", "t0": 13.4, "t1": 15.43, "shot": "r1-more2", "visual": {"type": "quote", "line": "It found that he coordinated the advertising"}, "wt": [0.0, 0.14, 0.34, 0.46, 0.58, 1.16, 1.28]}, {"scene": "b", "kind": "bignum", "ref": ["suspicious[1]", "established[1]"], "text": "Commission staff asked for $15,950 across eight counts.", "t0": 15.65, "t1": 19.53, "shot": "r2", "visual": {"type": "bignum", "value": "$15,950", "label": "Staff request"}, "wt": [0.0, 0.41, 0.7, 0.86, 1.0, 1.37, 1.77, 1.98, 2.24, 2.52, 2.84, 3.16, 3.39]}, {"scene": "b", "kind": "doc", "ref": ["suspicious[1]", "established[1]"], "text": "Taylor challenged the Commission’s jurisdiction at the hearing.", "t0": 19.65, "t1": 22.17, "shot": "r3", "visual": {"type": "doc", "source": "brief", "kicker": "Hearing brief", "text": "total penalty", "mark": "penalty"}, "wt": [0.0, 0.34, 0.7, 0.81, 1.29, 1.9, 1.99, 2.11]}, {"scene": "o", "kind": "doc", "ref": ["suspicious[2]", "established[2]"], "text": "The Commission voted on March 22, 2024.", "t0": 22.39, "t1": 25.16, "shot": "r4", "visual": {"type": "doc", "source": "decision", "kicker": "Final order", "text": "vote", "mark": "vote"}, "wt": [0.0, 0.11, 0.54, 0.84, 0.97, 1.24, 1.89, 2.18]}, {"scene": "o", "kind": "quote", "ref": ["suspicious[2]", "established[2]"], "text": "All three commissioners found six counts established.", "t0": 25.28, "t1": 27.69, "shot": "r4-more1", "visual": {"type": "quote", "line": "All three commissioners found six counts established"}, "wt": [0.0, 0.2, 0.42, 0.96, 1.21, 1.46, 1.73]}, {"scene": "o", "kind": "quote", "ref": ["suspicious[2]", "established[2]"], "text": "Two other counts drew two votes each.", "t0": 27.81, "t1": 29.46, "shot": "r4-more2", "visual": {"type": "quote", "line": "Two other counts drew two votes each"}, "wt": [0.0, 0.19, 0.39, 0.68, 0.86, 1.04, 1.29]}, {"scene": "o", "kind": "quote", "ref": ["suspicious[2]", "established[2]"], "text": "The rules required three votes to establish a count.", "t0": 29.58, "t1": 31.75, "shot": "r4-more3", "visual": {"type": "quote", "line": "The rules required three votes to establish a count"}, "wt": [0.0, 0.11, 0.39, 0.8, 1.05, 1.33, 1.45, 1.85, 1.91]}, {"scene": "o", "kind": "bignum", "ref": ["suspicious[2]", "established[2]"], "text": "The commissioners imposed $5,650.", "t0": 31.87, "t1": 35.3, "shot": "r5", "visual": {"type": "bignum", "value": "$5,650", "label": "Final penalty"}, "wt": [0.0, 0.11, 0.68, 1.12, 1.41, 2.02, 2.3, 2.58, 2.87]}, {"scene": "o", "kind": "quote", "ref": ["suspicious[2]", "established[2]"], "text": "That was the penalty in the order.", "t0": 35.42, "t1": 36.92, "shot": "r5-more1", "visual": {"type": "quote", "line": "That was the penalty in the order"}, "wt": [0.0, 0.23, 0.39, 0.49, 0.87, 0.98, 1.12]}, {"scene": "o", "kind": "end", "ref": ["status"], "text": "Every source is linked in the case file below.", "t0": 37.04, "t1": 39.18, "shot": "end", "visual": {"type": "end"}, "wt": [0.0, 0.31, 0.65, 0.8, 1.06, 1.17, 1.26, 1.5, 1.76]}], "format": 6, "chapters": {"p": "The billboard spending", "b": "What staff sought", "o": "What the Commission decided"}, "look": "newsroom", "hook": "number"}