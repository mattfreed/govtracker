.88, 1.53, 1.75, 2.15]}, {"scene": "a", "kind": "doc", "ref": ["suspicious[1]", "established[1]"], "text": "A judge upheld the order in October 2013.", "t0": 18.62, "t1": 21.7, "shot": "s5", "visual": {"type": "doc", "source": "judgment", "text": "ORDERED", "mark": "ORDERED"}, "wt": [0.0, 0.15, 0.46, 0.87, 1.04, 1.31, 1.43, 1.96, 2.31]}, {"scene": "b", "kind": "doc", "ref": ["suspicious[1]", "established[1]"], "text": "The new judgment named San Francisco as creditor for the workers.", "t0": 21.92, "t1": 26.34, "shot": "s6", "visual": {"type": "doc", "source": "terms", "text": "judgment creditor", "mark": "creditor"}, "wt": [0.0, 0.15, 0.39, 0.9, 1.23, 1.5, 2.61, 2.91, 3.57, 3.75, 3.85]}, {"scene": "b", "kind": "bignum", "ref": ["suspicious[1]", "established[1]"], "text": "The judgment set the amount owed at $1,339,028.39.", "t0": 26.46, "t1": 31.57, "shot": "s7", "visual": {"type": "bignum", "value": "$1,339,028.39", "label": "Worker health expenditures ordered"}, "wt": [0.0, 0.22, 0.73, 0.96, 1.1, 1.5, 2.14, 2.34, 2.64, 2.93, 3.25, 3.69, 4.05, 4.51]}, {"scene": "b", "kind": "bignum", "ref": ["suspicious[2]", "established[2]"], "text": "The settlement required at least $200,000 every six months.", "t0": 31.69, "t1": 37.49, "shot": "s8", "visual": {"type": "bignum", "value": "$200,000", "label": "Every six months"}, "wt": [0.0, 0.17, 0.67, 1.25, 1.36, 1.63, 2.23, 2.78, 3.27, 4.35, 4.87, 5.31]}, {"scene": "b", "kind": "doc", "ref": ["suspicious[2]", "established[2]"], "text": "An administrator was to locate the workers and pay them.", "t0": 37.61, "t1": 40.36, "shot": "s9", "visual": {"type": "doc", "source": "terms", "text": "Settlement Administrator", "mark": "Administrator"}, "wt": [0.0, 0.16, 0.82, 0.98, 1.11, 1.54, 1.67, 2.08, 2.23, 2.5]}, {"scene": "b", "kind": "doc", "ref": ["suspicious[2]", "established[2]"], "text": "Owner Gina Gregori personally guaranteed the judgment.", "t0": 40.48, "t1": 43.64, "shot": "s10", "visual": {"type": "doc", "source": "terms", 