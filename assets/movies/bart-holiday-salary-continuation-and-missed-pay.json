.35]}, {"scene": "o", "kind": "doc", "ref": ["suspicious[3]", "established[3]"], "text": "BART promised a one-year review, with a longer lookback if it found substantial errors.", "t0": 47.43, "t1": 52.78, "shot": "s8", "visual": {"type": "doc", "source": "actions", "kicker": "Management promised to look back, with the review still in progress", "text": "Review one year", "mark": "Review"}, "wt": [0.0, 0.38, 0.85, 0.98, 1.51, 2.37, 2.57, 2.65, 3.03, 3.53, 3.66, 3.8, 4.15, 4.85]}, {"scene": "o", "kind": "quote", "ref": ["suspicious[3]", "established[3]"], "text": "The June 2027 target had not yet arrived.", "t0": 52.9, "t1": 56.09, "shot": "s9", "visual": {"type": "quote", "line": "June 2027 target"}, "wt": [0.0, 0.21, 0.6, 0.93, 1.55, 1.95, 2.14, 2.38, 2.59]}, {"scene": "o", "kind": "end", "ref": ["status"], "text": "Every source is linked in the case file below.", "t0": 56.21, "t1": 58.84, "shot": "end", "visual": {"type": "end"}, "wt": [0.0, 0.46, 0.92, 1.11, 1.41, 1.49, 1.6, 1.86, 2.17]}], "format": 6, "chapters": {"p": "Eligibility depended on the bargaining unit and date", "b": "A payroll test found missed and duplicate payments", "o": "Management promised to look back, with the review still in progress"}, "look": "terminal", "hook": "contrast"}