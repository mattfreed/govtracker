{"id": "sfha-landlord-tenant-same-beneficiary", "title": "A homeowner collected $341,455 in rent subsidies on his own San Francisco home", "seconds": 47.7, "voice": "elevenlabs:OUMCzFUTd0F4Q6lkLkco", "narrator": "Roxy", "tempo": 1.045, "made": "2026-11-26", "key": "84377e30d35cf45f", "words": 135, "beats": [{"scene": "owner", "kind": "hook", "ref": ["suspicious[0]", "established[0]"], "text": "Gregory Finkelson bought a home in 2005 using another person’s name.", "t0": 0.2, "t1": 4.48, "shot": "r0", "visual": {"type": "hook", "words": ["Who", "was", "the", "landlord?"], "sub": "San Francisco housing assistance"}, "wt": [0.0, 0.43, 1.04, 1.3, 1.38, 1.62, 1.73, 1.93, 2.36, 2.76, 3.04, 3.37, 3.88]}, {"scene": "owner", "kind": "doc", "ref": ["suspicious[0]", "established[0]"], "text": "He told the San Francisco Housing Authority that person was his landlord.", "t0": 4.6, "t1": 8.37, "shot": "r1", "visual": {"type": "doc", "source": "plea", "kicker": "U.S. Attorney’s Office, Northern District of California", "text": "Housing application", "mark": "Housing application"}, "wt": [0.0, 0.13, 0.36, 0.44, 0.63, 1.18, 1.58, 2.08, 2.29, 2.69, 2.89, 3.09]}, {"scene": "owner", "kind": "quote", "ref": ["suspicious[1]", "established[1]"], "text": "He also said he worked for the business at the house. He owned it.", "t0": 8.49, "t1": 11.94, "shot": "r2", "visual": {"type": "quote", "line": "The business at the house"}, "wt": [0.0, 0.15, 0.45, 0.67, 0.79, 1.05, 1.16, 1.25, 1.68, 1.8, 1.92, 2.63, 2.88, 3.22]}, {"scene": "owner", "kind": "record", "ref": ["suspicious[1]", "established[1]"], "text": "Housing assistance went into accounts Finkelson controlled.", "t0": 12.06, "t1": 15.17, "shot": "r3", "visual": {"type": "record", "layout": "relationship", "context": "Public housing payments", "heading": "Where the money went", "source": "plea", "rows": [{"icon": "building", "label": "Reported landlord", "value": "Another person"}, {"icon": "person", "label": "Account control", "value": "G