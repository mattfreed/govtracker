{"id": "sf-public-works-somarts-paving-contract-title", "title": "A $7.9 million street contract carried a cultural center’s name", "seconds": 53.2, "voice": "elevenlabs:9PVP7ENhDskL0KYHAKtD", "narrator": "Jerry B.", "made": "2026-11-27", "key": "cdf83fbfab09ab99", "words": 167, "beats": [{"scene": "title", "kind": "hook", "ref": ["established[0]", "suspicious[0]"], "text": "One city contract carries the name of a cultural center.", "t0": 0.2, "t1": 2.8, "shot": "r0", "visual": {"type": "hook", "words": ["What", "did", "the", "City", "actually", "buy?"], "sub": "Mission Street and SOMArts"}, "wt": [0.0, 0.23, 0.5, 0.98, 1.29, 1.41, 1.63, 1.75, 1.83, 2.26]}, {"scene": "title", "kind": "doc", "ref": ["established[0]"], "text": "This is a lead, not a finding. The award describes street paving, sewer work and safety improvements.", "t0": 2.92, "t1": 8.77, "shot": "r1", "visual": {"type": "doc", "source": "paving-signed", "kicker": "San Francisco Public Works Commission", "text": "Mission SoMa Improvements", "mark": "Mission SoMa Improvements"}, "wt": [0.0, 0.19, 0.32, 0.43, 1.01, 1.22, 1.3, 2.3, 2.47, 2.81, 3.31, 3.63, 4.2, 4.54, 4.79, 4.92, 5.27]}, {"scene": "title", "kind": "doc", "ref": ["established[0]"], "text": "A second award covers accessibility work inside the cultural center.", "t0": 8.89, "t1": 12.37, "shot": "r2", "visual": {"type": "doc", "source": "cultural-signed", "kicker": "San Francisco Public Works Commission", "text": "SOMArts Cultural Center", "mark": "SOMArts Cultural Center"}, "wt": [0.0, 0.13, 0.45, 0.83, 1.13, 1.92, 2.2, 2.64, 2.74, 3.14]}, {"scene": "title", "kind": "record", "ref": ["established[0]", "suspicious[0]"], "text": "The Public Works Commission voted on the projects two weeks apart.", "t0": 12.49, "t1": 15.55, "shot": "r3", "visual": {"type": "record", "layout": "timeline", "context": "October 2026", "heading": "Two commission votes", "source": "paving-signed", "rows": [{"icon": "calendar", "label": "Street project", "event": "2026-1