6.45]}, {"scene": "lead1", "kind": "quote", "ref": ["notEstablished[0]", "innocent[1]"], "text": "Grant money usually shows up as revenue, or as a debt. Here it’s neither.", "t0": 35.74, "t1": 39.62, "shot": "b7", "visual": {"type": "quote", "line": "It may be held or passed on as agent for a sponsored project"}, "wt": [0.0, 0.23, 0.5, 0.9, 1.16, 1.27, 1.37, 1.96, 2.1, 2.22, 2.29, 2.66, 3.07, 3.44]}, {"scene": "lead1", "kind": "quote", "ref": ["notEstablished[0]", "innocent[1]"], "text": "A sponsor holding money for another project could leave it out.", "t0": 39.74, "t1": 42.28, "shot": "b7", "visual": {"type": "quote", "line": "It may be held or passed on as agent for a sponsored project"}, "wt": [0.0, 0.07, 0.56, 0.77, 0.97, 1.1, 1.39, 1.83, 2.03, 2.22, 2.32]}, {"scene": "lead2", "kind": "quote", "ref": ["suspicious[3]", "story[2]"], "text": "And there may be such a project. The City’s title for the grant ends: “fs Sounds B”.", "t0": 42.5, "t1": 47.69, "shot": "b8", "visual": {"type": "quote", "line": "HRC-DKI-CW1-009-PW fs Sounds B"}, "wt": [0.08, 0.14, 0.34, 0.53, 0.74, 0.94, 1.03, 1.62, 1.81, 2.12, 2.32, 2.44, 2.54, 2.9, 3.54, 4.09, 4.8]}, {"scene": "lead2", "kind": "chain", "ref": ["suspicious[3].why", "notEstablished[1]"], "text": "That looks like Project Wreckless as fiscal sponsor for another project, its name cut off.", "t0": 47.81, "t1": 52.05, "shot": "b9", "visual": {"type": "chain", "steps": [{"art": "cityhall", "name": "Human Rights Commission", "sub": "$1,000,000 grant"}, {"art": "van", "name": "Project Wreckless", "sub": "fiscal sponsor?"}, {"art": "question", "name": "Sounds B…", "sub": "name cut off"}], "kicker": "The second lead"}, "wt": [0.0, 0.14, 0.33, 0.51, 1.04, 1.48, 1.62, 1.96, 2.34, 2.47, 2.76, 3.36, 3.55, 3.76, 3.96]}, {"scene": "lead2", "kind": "chain", "ref": ["suspicious[3].why", "notEstablished[1]"], "text": "If so, the record doesn’t show who got the money.", "t0": 52.17, "t1": 54.5, "shot": "b9", "visual": {"type": "chain", "steps": [{"art": "cityhall", "name": "Human Rights Commission", "sub": "$1,000,000 grant"}, {"art": "van", "name": "Project Wreckless", "sub": "fiscal sponsor?"}, {"art": "question", "name": "Sounds B…", "sub": "name cut off"}], "kicker": "The second lead"}, "wt": [0.0, 0.14, 0.67, 0.77, 1.08, 1.36, 1.55, 1.68, 1.8, 1.91]}, {"scene": "lead3", "kind": "scene", "ref": ["suspicious[0]", "established[0]"], "text": "In 2023 it borrowed 189,338 dollars from NPU Inc, a company.", "t0": 54.72, "t1": 61.63, "shot": "b10", "visual": {"type": "scene", "art": "money", "label": "NPU Inc", "kicker": "The third lead", "sub": "a director has a controlling interest"}, "wt": [0.0, 0.08, 0.35, 0.93, 1.28, 1.62, 1.81, 2.09, 2.56, 3.03, 3.34, 3.62, 4.03, 4.49, 4.94, 5.66, 6.36, 6.5]}, {"scene": "lead3", "kind": "scene", "ref": ["suspicious[0]", "established[0]"], "text": "The return says a director has a controlling interest in it.", "t0": 61.75, "t1": 64.03, "shot": "b10", "visual": {"type": "scene", "art": "money", "label": "NPU Inc", "kicker": "The third lead", "sub": "a director has a controlling interest"}, "emph": ["controlling interest"], "wt": [0.0, 0.05, 0.38, 0.57, 0.64, 0.97, 1.1, 1.17, 1.64, 1.96, 2.05]}, {"scene": "lead3", "kind": "rank", "ref": ["suspicious[0].what"], "text": "A year later, it owed 334,105. By the end of 2025?", "t0": 64.15, "t1": 69.71, "shot": "b11", "visual": {"type": "rank", "label": "Owed to NPU Inc at year end", "rows": [["2025", "$584,180"], ["2024", "$334,105"], ["2023", "$189,338"]]}, "wt": [0.0, 0.06, 0.26, 0.71, 0.81, 1.05, 1.25, 1.54, 2.06, 2.49, 2.72, 3.02, 3.84, 3.92, 4.05, 4.2, 4.32, 4.57]}, {"scene": "lead3", "kind": "bignum", "ref": ["suspicious[0]", "established[0]"], "text": "584,180 dollars.", "t0": 69.71, "t1": 72.43, "shot": "b12", "visual": {"type": "bignum", "value": "$584,180", "label": "owed to NPU Inc, end of 2025"}, "emph": ["584,180"], "wt": [0.04, 0.23, 0.51, 1.0, 1.57, 1.7, 1.97, 2.25]}, {"scene": "lead3", "kind": "quote", "ref": ["defense[0]", "suspicious[0].why"], "text": "Why borrow? The return says, to fund operations during a shortfall year.", "t0": 72.95, "t1": 76.8, "shot": "b13", "visual": {"type": "quote", "line": "To fund operations during a shortfall year"}, "wt": [0.0, 0.16, 0.75, 0.9, 1.25, 1.65, 1.78, 2.1, 2.68, 2.88, 2.96, 3.44]}, {"scene": "lead3", "kind": "quote", "ref": ["defense[0]", "suspicious[0].why"], "text": "Far more than a year of its spending is now owed to an insider’s company.", "t0": 76.92, "t1": 80.24, "shot": "b13", "visual": {"type": "quote", "line": "To fund operations during a shortfall year"}, "wt": [0.0, 0.24, 0.48, 0.62, 0.69, 0.87, 0.95, 1.1, 1.5, 1.64, 1.85, 2.14, 2.23, 2.38, 2.9]}, {"scene": "lead4", "kind": "versus", "ref": ["suspicious[2]", "established[3]"], "text": "But 2025 wasn’t a shortfall.", "t0": 80.46, "t1": 82.66, "shot": "b14", "visual": {"type": "versus", "a": ["revenue, 2025", "$83,191"], "b": ["expenses, 2025", "$51,407"]}, "emph": ["wasn’t"], "wt": [0.0, 0.09, 0.31, 1.01, 1.43, 1.52]}, {"scene": "lead4", "kind": "versus", "ref": ["suspicious[2]", "established[3]"], "text": "It took in 83,191 dollars and spent 51,407.", "t0": 82.78, "t1": 88.45, "shot": "b14x", "visual": {"type": "versus", "a": ["revenue, 2025", "$83,191"], "b": ["expenses, 2025", "$51,407"]}, "wt": [0.0, 0.17, 0.44, 0.69, 1.11, 1.53, 1.77, 2.06, 2.53, 3.02, 3.33, 3.74, 4.25, 4.69, 4.83, 5.13]}, {"scene": "lead4", "kind": "scene", "ref": ["suspicious[2].what"], "text": "Still, it borrowed 250,075 dollars more.", "t0": 88.57, "t1": 92.18, "shot": "b15", "visual": {"type": "scene", "art": "money", "label": "New insider borrowing, 2025", "kicker": "The fourth lead", "chip": "$250,075"}, "emph": ["250,075"], "wt": [0.0, 0.51, 0.64, 0.97, 1.1, 1.38, 1.64, 2.04, 2.64, 3.01]}, {"scene": "lead4", "kind": "scene", "ref": ["suspicious[2].what"], "text": "Cash and other assets rose about as much. No record seen explains it.", "t0": 92.3, "t1": 95.89, "shot": "b15", "visual": {"type": "scene", "art": "money", "label": "New insider borrowing, 2025", "kicker": "The fourth lead", "chip": "$250,075"}, "wt": [0.0, 0.24, 0.33, 0.56, 1.0, 1.19, 1.4, 1.56, 2.05, 2.3, 2.64, 2.89, 3.29]}, {"scene": "lead5", "kind": "chain", "ref": ["suspicious[4]", "established[5]"], "text": "Who approved the loan? A board of three, including the founder and a related trustee.", "t0": 96.11, "t1": 100.4, "shot": "b16", "visual": {"type": "chain", "steps": [{"art": "contract", "name": "The founder", "sub": "CEO and founder, unpaid"}, {"art": "contract", "name": "A trustee", "sub": "related to the founder"}, {"art": "housing", "name": "A board of three", "sub": "approved the loan"}], "kicker": "Who approved it"}, "wt": [0.0, 0.06, 0.32, 0.43, 1.15, 1.33, 1.54, 1.68, 2.13, 2.45, 2.55, 2.97, 3.25, 3.35, 3.56]}, {"scene": "lead5", "kind": "scene", "ref": ["notEstablished[2]"], "text": "It doesn’t name the director who controls NPU.", "t0": 100.52, "t1": 102.71, "shot": "b17", "visual": {"type": "scene", "art": "question", "label": "Which director controls NPU Inc?", "kicker": "Who approved it"}, "wt": [0.0, 0.08, 0.35, 0.53, 0.62, 1.01, 1.16, 1.61]}, {"scene": "lead5", "kind": "doc", "ref": ["established[8]", "notEstablished[2]"], "text": "But NPU’s own State filings name a chief executive with the founder’s name, at the same address.", "t0": 102.83, "t1": 107.37, "shot": "b17a", "visual": {"type": "doc", "source": "ir4a", "kicker": "California Secretary of State · 3661558", "text": "NPU, INC.: chief executive and director (2025 and 2026 statements), 88 5th Street", "mark": "chief executive and director"}, "emph": ["the founder’s name"], "wt": [0.0, 0.21, 0.67, 0.82, 1.09, 1.49, 1.77, 1.87, 2.09, 2.52, 2.59, 2.69, 3.16, 3.59, 3.66, 3.76, 4.02]}, {"scene": "lead5", "kind": "form", "ref": ["established[10]", "innocent[5]"], "text": "Its 2025 report to the State answers No to insider deals, and No to government funding.", "t0": 107.49, "t1": 113.1, "shot": "b17c", "visual": {"type": "form", "title": "Report to the Attorney General for 2025, signed May 19, 2026", "rows": [["Transactions with an officer or director, or their company?", "No", 1], ["Government funding?", "No", 1]]}, "wt": [0.0, 0.13, 0.34, 0.88, 1.15, 1.25, 1.37, 1.76, 2.35, 2.77, 2.96, 3.43, 3.87, 4.3, 4.64, 4.8, 5.15]}, {"scene": "lead5", "kind": "form", "ref": ["established[10]"], "text": "Yet its federal return lists the loan,", "t0": 113.22, "t1": 115.16, "shot": "b17c", "visual": {"type": "form", "title": "Report to the Attorney General for 2025, signed May 19, 2026", "rows": [["Transactions with an officer or director, or their company?", "No", 1], ["Government funding?", "No", 1]]}, "wt": [0.0, 0.07, 0.21, 0.57, 1.02, 1.25, 1.37]}, {"scene": "lead5", "kind": "form", "ref": ["established[10]"], "text": "and the City paid it 451,929 dollars in fiscal 2025.", "t0": 115.16, "t1": 120.47, "shot": "b17c", "visual": {"type": "form", "title": "Report to the Attorney General for 2025, signed May 19, 2026", "rows": [["Transactions with an officer or director, or their company?", "No", 1], ["Government funding?", "No", 1]]}, "wt": [0.04, 0.12, 0.29, 0.6, 0.8, 0.93, 1.12, 1.41, 1.87, 2.29, 2.59, 2.87, 3.35, 3.8, 3.95, 4.33, 4.59]}, {"scene": "lead5", "kind": "form", "ref": ["suspicious[4]"], "text": "The 2023 and 2024 renewals also answered no. The attached returns listed the loan.", "t0": 120.59, "t1": 126.26, "shot": "r29a", "visual": {"type": "form", "title": "State renewals", "rows": [["2023", "No", 1], ["2024", "No", 1], ["Attached Schedule L", "Loan disclosed", 0]]}, "wt": [0.0, 0.09, 0.31, 0.85, 1.03, 1.24, 1.71, 2.21, 2.57, 2.93, 3.4, 4.04, 4.46, 4.91, 5.22, 5.33]}, {"scene": "close", "kind": "unknowns", "ref": ["notEstablished[0]", "notEstablished[3]"], "text": "The records don’t show where the City’s money sits in its books.", "t0": 126.48, "t1": 128.89, "shot": "b18", "visual": {"type": "unknowns", "cards": ["Where the $977,068 sits in its books", "Whether any City money repaid the loan"]}, "wt": [0.0, 0.07, 0.4, 0.6, 0.79, 0.91, 1.0, 1.26, 1.48, 1.72, 1.8, 1.95]}, {"scene": "close", "kind": "settle", "ref": ["next[0]", "next[1]"], "text": "What would settle it? The grant’s invoices and any sponsor agreement. And the loan agreement with NPU.", "t0": 129.01, "t1": 133.88, "shot": "b19", "visual": {"type": "settle", "cards": [{"who": "", "what": "The grant agreement, invoices and any fiscal-sponsor agreement"}, {"who": "", "what": "The NPU Inc loan agreement and ledger"}], "focus": 0}, "wt": [0.0, 0.07, 0.22, 0.47, 0.73, 0.89, 1.23, 1.78, 2.01, 2.16, 2.55, 3.09, 3.33, 3.43, 3.68, 4.0, 4.21]}, {"scene": "close", "kind": "status", "ref": ["status"], "text": "Its 2025 return, filed in May 2026, still shows no government grant revenue.", "t0": 134.0, "t1": 139.5, "shot": "b20", "visual": {"type": "status"}, "wt": [0.0, 0.14, 0.35, 0.97, 1.63, 1.93, 2.03, 2.21, 2.47, 3.35, 3.63, 3.98, 4.15, 4.57, 4.89]}, {"scene": "close", "kind": "end", "ref": ["end"], "text": "A lead is a question, not an accusation.", "t0": 139.62, "t1": 141.84, "shot": "b21", "visual": {"type": "end"}, "wt": [0.0, 0.06, 0.3, 0.41, 0.53, 1.24, 1.39, 1.53]}], "format": 6, "chapters": {"open": "The grant", "lead1": "Lead 1 · paid vs. reported", "lead2": "Lead 2 · “fs Sounds B”", "lead3": "Lead 3 · the insider loan", "lead4": "Lead 4 · borrowing in a surplus", "lead5": "Lead 5 · a board of three", "close": "Where it stands"}, "look": "flow", "hook": "person"}