 "Services and operating support", "mark": "Services and operating support"}, "wt": [0.0, 0.1, 0.43, 1.09, 1.43, 1.73, 1.96, 2.29, 2.59, 2.93, 3.58, 3.8, 3.9, 4.03, 4.34, 4.49, 5.02, 5.17, 5.62]}, {"scene": "balance", "kind": "bignum", "ref": ["suspicious[0]", "established[0]"], "text": "That leaves a difference of $177,308. The descriptions of what the balances cover differ.", "t0": 18.58, "t1": 25.33, "shot": "r4", "visual": {"type": "bignum", "value": "$177,308", "label": "Difference between the reported balances"}, "wt": [0.0, 0.21, 0.44, 0.54, 0.91, 1.02, 1.21, 1.51, 2.24, 2.65, 2.88, 3.15, 3.32, 4.36, 4.54, 5.13, 5.24, 5.41, 5.55, 6.04, 6.39]}, {"scene": "tax", "kind": "doc", "ref": ["suspicious[1]", "established[1]"], "text": "Both audits agree on $216,182 in fees.", "t0": 25.55, "t1": 29.8, "shot": "r5", "visual": {"type": "doc", "source": "center23", "kicker": "Bernal Heights Neighborhood Center / independent auditor", "text": "Related-party fees", "mark": "Related-party fees"}, "wt": [0.0, 0.28, 0.58, 0.91, 1.02, 1.24, 1.53, 2.01, 2.47, 2.65, 2.93, 3.36, 3.72, 3.83]}, {"scene": "tax", "kind": "doc", "ref": ["suspicious[1]", "established[1]"], "text": "The housing corporation’s tax return reports a $1,767,648 grant to the center.", "t0": 29.92, "t1": 34.62, "shot": "r6", "visual": {"type": "doc", "source": "irs", "kicker": "Internal Revenue Service", "text": "Schedule I", "mark": "Schedule I"}, "wt": [0.0, 0.1, 0.43, 1.11, 1.39, 1.74, 2.11, 2.18, 2.48, 2.72, 2.98, 3.19, 3.52, 3.88, 4.14, 4.25, 4.35]}, {"scene": "tax", "kind": "record", "ref": ["suspicious[1]", "established[1]"], "text": "Its reported operating support plus the donated lease income add up to that grant.", "t0": 34.74, "t1": 38.82, "shot": "r7", "visual": {"type": "record", "layout": "amounts", "context": "Housing Corporation’s accounts", "heading": "Two amounts explain the grant", "source": "housing23", "rows": [{"icon": "money", "label": "Operating support", "value": "$1,624,358"}, {"icon":