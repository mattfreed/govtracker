{"id": "sfusd-school-bus-maintenance-claims", "title": "The school bus inspections behind an $11.5 million settlement", "seconds": 40.4, "voice": "elevenlabs:OtHu0lbpdNTqJVqaxDtR", "narrator": "Maven", "made": "2026-11-27", "key": "5c25954372fec48c", "words": 120, "beats": [{"scene": "p", "kind": "doc", "ref": ["suspicious[0]", "established[0]"], "text": "San Francisco paid monthly for satisfactory school bus service.", "t0": 0.2, "t1": 3.13, "shot": "r0", "visual": {"type": "doc", "source": "opinion", "kicker": "Transportation contract", "text": "Monthly payments", "mark": "Monthly payments"}, "wt": [0.0, 0.2, 0.66, 0.88, 1.24, 1.39, 1.97, 2.22, 2.43]}, {"scene": "p", "kind": "quote", "ref": ["suspicious[0]", "established[0]"], "text": "The contract required maintenance records for each vehicle.", "t0": 3.25, "t1": 6.0, "shot": "r1", "visual": {"type": "quote", "line": "The contract required maintenance records for each vehicle"}, "wt": [0.0, 0.12, 0.57, 1.05, 1.53, 1.91, 2.04, 2.24]}, {"scene": "p", "kind": "doc", "ref": ["suspicious[0]", "established[0]"], "text": "Two former mechanics and the Environmental Law Foundation challenged the invoices.", "t0": 6.12, "t1": 9.83, "shot": "r2", "visual": {"type": "doc", "source": "complaint", "kicker": "First amended complaint", "text": "Environmental Law Foundation", "mark": "Environmental Law Foundation"}, "wt": [0.0, 0.27, 0.58, 1.08, 1.21, 1.31, 1.89, 2.09, 2.59, 2.93, 3.04]}, {"scene": "p", "kind": "quote", "ref": ["suspicious[0]", "established[0]"], "text": "They said each invoice certified compliance with the maintenance terms.", "t0": 9.95, "t1": 13.05, "shot": "r3", "visual": {"type": "quote", "line": "They said each invoice certified compliance with the maintenance terms"}, "wt": [0.0, 0.12, 0.32, 0.55, 0.94, 1.42, 1.88, 2.02, 2.13, 2.55]}, {"scene": "b", "kind": "bignum", "ref": ["suspicious[1]", "established[1]"], "text": "The appellate court described 200 inspections.", "t0": 13.27, "t1": 15.78, "shot": "r4", "visual": {"type": "bignum", "value": "200", "label": "Inspections recording thin brake linings"}, "wt": [0.0, 0.11, 0.5, 0.79, 1.23, 1.49, 1.75]}, {"scene": "b", "kind": "quote", "ref": ["suspicious[1]", "established[1]"], "text": "Those inspections recorded brake linings below the minimum thickness.", "t0": 15.9, "t1": 18.8, "shot": "r5", "visual": {"type": "quote", "line": "Those inspections recorded brake linings below the minimum thickness"}, "wt": [0.0, 0.23, 0.73, 1.05, 1.31, 1.66, 1.89, 1.98, 2.32]}, {"scene": "b", "kind": "doc", "ref": ["suspicious[1]", "established[1]"], "text": "First Student cited satisfactory California Highway Patrol inspections.", "t0": 18.92, "t1": 22.24, "shot": "r6", "visual": {"type": "doc", "source": "opinion", "kicker": "Annual inspections", "text": "California Highway Patrol", "mark": "California Highway Patrol"}, "wt": [0.0, 0.22, 0.59, 0.9, 1.53, 2.02, 2.31, 2.62]}, {"scene": "b", "kind": "quote", "ref": ["suspicious[1]", "established[1]"], "text": "Those annual inspections covered a sample of the fleet.", "t0": 22.36, "t1": 24.78, "shot": "r7", "visual": {"type": "quote", "line": "Those annual inspections covered a sample of the fleet"}, "wt": [0.0, 0.25, 0.58, 1.22, 1.51, 1.58, 1.94, 2.04, 2.14]}, {"scene": "o", "kind": "doc", "ref": ["suspicious[2]", "established[2]"], "text": "In 2014 the court sent the disputed questions back for trial.", "t0": 25.0, "t1": 28.47, "shot": "r8", "visual": {"type": "doc", "source": "opinion", "kicker": "Court of Appeal", "text": "March 11, 2014", "mark": "March 11, 2014"}, "wt": [0.0, 0.14, 0.43, 1.09, 1.25, 1.52, 1.72, 1.84, 2.32, 2.76, 2.96, 3.09]}, {"scene": "o", "kind": "bignum", "ref": ["suspicious[2]", "established[2]"], "text": "The parties settled for $11.5 million.", "t0": 28.59, "t1": 31.13, "shot": "r9", "visual": {"type": "bignum", "value": "$11.5 million", "label": "Gross settlement"}, "wt": [0.0, 0.09, 0.41, 0.73, 0.88, 1.22, 1.46, 1.71, 2.0]}, {"scene": "o", "kind": "bignum", "ref": ["suspicious[2]", "established[2]"], "text": "The Chronicle reported a $3.5 million share for the school district.", "t0": 31.25, "t1": 35.15, "shot": "r10", "visual": {"type": "bignum", "value": "$3.5 million", "label": "Reported district share"}, "wt": [0.0, 0.1, 0.56, 0.99, 1.08, 1.39, 1.69, 1.98, 2.27, 2.59, 2.88, 3.02, 3.12, 3.39]}, {"scene": "o", "kind": "unknowns", "ref": ["suspicious[2]", "established[2]"], "text": "The district’s receipt remains unverified.", "t0": 35.27, "t1": 37.19, "shot": "r11", "visual": {"type": "unknowns", "cards": ["Payment date", "Receipt"]}, "wt": [0.0, 0.1, 0.51, 0.87, 1.22]}, {"scene": "o", "kind": "end", "ref": ["status"], "text": "Every source is linked in the case file below.", "t0": 37.31, "t1": 39.45, "shot": "r12", "visual": {"type": "end"}, "wt": [0.0, 0.31, 0.65, 0.8, 1.06, 1.17, 1.26, 1.5, 1.76]}], "format": 6, "chapters": {"p": "Monthly payments", "b": "Maintenance records", "o": "Civil settlement"}, "look": "newsroom", "hook": "document"}