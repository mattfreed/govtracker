{"id": "sfo-city-overhead-airline-refunds", "title": "SFO returned $4.55 million to airlines after a federal audit", "seconds": 72.6, "voice": "elevenlabs:iPYqcpY8j8Ap4jUf28I3", "narrator": "Michael", "made": "2026-11-27", "key": "75cdbecee9ab0c43", "words": 173, "beats": [{"scene": "p", "kind": "hook", "ref": ["suspicious[0]", "established[0]"], "text": "Each year SFO paid the City for overhead.", "t0": 0.2, "t1": 2.98, "shot": "r0", "visual": {"type": "hook", "words": ["Who", "paid", "for", "overhead?"], "sub": "San Francisco International Airport"}, "wt": [0.0, 0.32, 0.67, 1.38, 1.69, 1.81, 2.08, 2.26]}, {"scene": "p", "kind": "quote", "ref": ["suspicious[0]", "established[0]"], "text": "The 1981 agreement covered services provided across departments.", "t0": 3.1, "t1": 7.53, "shot": "r1", "visual": {"type": "quote", "line": "The 1981 agreement covered services provided across departments"}, "wt": [0.0, 0.16, 0.69, 1.23, 1.95, 2.35, 2.95, 3.39, 3.76]}, {"scene": "p", "kind": "doc", "ref": ["suspicious[0]", "established[0]"], "text": "Public Works charged overhead on its fiscal 2001 direct labor.", "t0": 7.65, "t1": 12.39, "shot": "r2", "visual": {"type": "doc", "source": "oig", "kicker": "Public Works", "text": "$197,074", "mark": "$197,074"}, "wt": [0.0, 0.4, 0.82, 1.38, 2.0, 2.19, 2.37, 2.85, 3.09, 3.57, 3.87, 4.35]}, {"scene": "p", "kind": "bignum", "ref": ["suspicious[0]", "established[0]"], "text": "The department charged $197,074.", "t0": 12.51, "t1": 17.08, "shot": "value2001", "visual": {"type": "bignum", "value": "$197,074", "label": "Public Works overhead"}, "wt": [0.0, 0.14, 0.64, 1.22, 1.41, 1.83, 2.57, 3.15, 4.0]}, {"scene": "p", "kind": "quote", "ref": ["suspicious[0]", "established[0]"], "text": "Federal auditors found the airport had already paid for that overhead.", "t0": 17.2, "t1": 21.18, "shot": "r3", "visual": {"type": "quote", "line": "Federal auditors found the airport had already paid for that overhead"}, "wt": [0.0, 0.5, 1.12, 1.43, 1.55, 2.04, 2.21, 2.7, 3.12, 3.26, 3.43]}, {"scene": "b", "kind": "doc", "ref": ["suspicious[1]", "established[1]"], "text": "Police billed $81,366 for an investigator.", "t0": 21.4, "t1": 27.23, "shot": "r4", "visual": {"type": "doc", "source": "oig", "kicker": "Police Department", "text": "$81,366", "mark": "$81,366"}, "wt": [0.0, 0.51, 0.94, 1.54, 2.12, 2.52, 2.97, 3.94, 4.77, 4.96, 5.06]}, {"scene": "b", "kind": "quote", "ref": ["suspicious[1]", "established[1]"], "text": "The Office of Citizen Complaints also billed for that investigator.", "t0": 27.35, "t1": 31.17, "shot": "r5", "visual": {"type": "quote", "line": "The Office of Citizen Complaints also billed for that investigator"}, "wt": [0.0, 0.18, 0.55, 0.69, 1.14, 1.84, 2.34, 2.73, 2.87, 3.04]}, {"scene": "b", "kind": "bignum", "ref": ["suspicious[1]", "established[1]"], "text": "Across eight departments the audit identified $12,525,921.", "t0": 31.29, "t1": 36.83, "shot": "r6", "visual": {"type": "bignum", "value": "$12,525,921", "label": "Federal audit finding across eight departments"}, "wt": [0.0, 0.58, 0.86, 1.81, 2.0, 2.3, 2.95, 3.3, 3.89, 4.24, 4.6, 4.99]}, {"scene": "b", "kind": "quote", "ref": ["suspicious[1]", "established[1]"], "text": "The City maintained it could charge overhead tied to direct services.", "t0": 36.95, "t1": 41.3, "shot": "r7", "visual": {"type": "quote", "line": "The City maintained it could charge overhead tied to direct services"}, "wt": [0.0, 0.17, 0.47, 1.15, 1.25, 1.44, 1.87, 2.81, 3.17, 3.28, 3.69]}, {"scene": "o", "kind": "doc", "ref": ["suspicious[2]", "established[2]"], "text": "In June 2005 the City sent about $4.6 million back to SFO.", "t0": 41.52, "t1": 47.98, "shot": "r8", "visual": {"type": "doc", "source": "financial", "kicker": "City transfer", "text": "$4.6 million", "mark": "$4.6 million"}, "wt": [0.0, 0.19, 0.6, 0.81, 1.21, 1.6, 1.72, 2.0, 2.2, 2.5, 2.85, 3.15, 3.64, 4.41, 5.33, 5.62, 5.78]}, {"scene": "o", "kind": "quote", "ref": ["suspicious[2]", "established[2]"], "text": "The airport recorded a liability to the airlines.", "t0": 48.1, "t1": 50.97, "shot": "r9", "visual": {"type": "quote", "line": "The airport recorded a liability to the airlines"}, "wt": [0.0, 0.16, 0.63, 1.16, 1.24, 1.89, 2.01, 2.14]}, {"scene": "o", "kind": "bignum", "ref": ["suspicious[2]", "established[2]"], "text": "The airport sent $4.55 million to the carriers.", "t0": 51.09, "t1": 56.68, "shot": "r10", "visual": {"type": "bignum", "value": "$4.55 million", "label": "Remitted to air carriers"}, "wt": [0.0, 0.16, 0.65, 0.93, 1.77, 2.16, 2.55, 3.0, 3.79, 4.69, 4.89, 4.99]}, {"scene": "o", "kind": "quote", "ref": ["suspicious[2]", "established[2]"], "text": "It returned about $55,000 to the City.", "t0": 56.8, "t1": 59.96, "shot": "r11", "visual": {"type": "quote", "line": "It returned about $55,000 to the City"}, "wt": [0.0, 0.18, 0.67, 0.97, 1.65, 2.11, 2.55, 2.69, 2.81]}, {"scene": "o", "kind": "doc", "ref": ["suspicious[2]", "established[2]"], "text": "The City changed its billing procedures and submitted a compliance certificate.", "t0": 60.08, "t1": 64.3, "shot": "r12", "visual": {"type": "doc", "source": "closure", "kicker": "Audit closure", "text": "November 2006", "mark": "November 2006"}, "wt": [0.0, 0.18, 0.52, 1.13, 1.3, 1.65, 2.34, 2.53, 2.97, 3.03, 3.57]}, {"scene": "o", "kind": "quote", "ref": ["suspicious[2]", "established[2]"], "text": "In November 2006 the FAA told the City the audit was closed.", "t0": 64.42, "t1": 68.96, "shot": "r13", "visual": {"type": "quote", "line": "In November 2006 the FAA told the City the audit was closed"}, "wt": [0.0, 0.14, 0.61, 0.84, 1.26, 1.64, 1.87, 2.52, 2.8, 2.92, 3.36, 3.54, 3.84, 4.02]}, {"scene": "o", "kind": "end", "ref": ["status"], "text": "Every source is linked in the case file below.", "t0": 69.08, "t1": 71.71, "shot": "r14", "visual": {"type": "end"}, "wt": [0.0, 0.46, 0.92, 1.11, 1.41, 1.49, 1.6, 1.86, 2.17]}], "format": 6, "chapters": {"p": "The annual payment", "b": "The second bill", "o": "The airline refunds"}, "look": "newsroom", "hook": "number"}