{"id": "city-college-retiree-health-disbursements", "title": "What City College withdrew from its $21 million retiree health authorization", "seconds": 46.7, "voice": "elevenlabs:OtHu0lbpdNTqJVqaxDtR", "narrator": "Maven", "made": "2026-11-27", "key": "762e56d802f6cf2e", "words": 157, "beats": [{"scene": "p", "kind": "hook", "ref": ["suspicious[0]", "established[0]"], "text": "City College had approval to draw up to $21 million from its retiree health trust.", "t0": 0.2, "t1": 4.42, "shot": "r0", "visual": {"type": "hook", "words": ["$21", "million"], "sub": "City College retiree health costs"}, "wt": [0.0, 0.35, 0.71, 0.82, 1.2, 1.29, 1.49, 1.61, 1.71, 2.15, 2.45, 2.8, 2.95, 3.08, 3.54, 3.77]}, {"scene": "p", "kind": "quote", "ref": ["suspicious[0]", "established[0]"], "text": "How much did the trust actually pay?", "t0": 4.54, "t1": 6.94, "shot": "r1", "visual": {"type": "quote", "line": "How much did the trust actually pay?"}, "wt": [0.0, 0.2, 0.43, 0.57, 0.67, 1.07, 1.43]}, {"scene": "p", "kind": "doc", "ref": ["suspicious[0]", "established[0]"], "text": "The trust board set a ceiling and required supporting records.", "t0": 6.94, "t1": 9.66, "shot": "r2", "visual": {"type": "doc", "source": "vote", "kicker": "Trust board vote", "text": "Supporting documentation", "mark": "documentation"}, "wt": [0.04, 0.19, 0.46, 0.72, 0.91, 0.98, 1.35, 1.47, 1.84, 2.21]}, {"scene": "p", "kind": "quote", "ref": ["suspicious[0]", "established[0]"], "text": "The college had budgeted for retiree medical costs over two fiscal years.", "t0": 9.78, "t1": 13.34, "shot": "r3", "visual": {"type": "quote", "line": "The college had budgeted for retiree medical costs over two fiscal years"}, "wt": [0.0, 0.09, 0.38, 0.49, 0.91, 1.07, 1.57, 1.91, 2.33, 2.56, 2.73, 3.07]}, {"scene": "b", "kind": "record", "ref": ["suspicious[1]", "established[1]"], "text": "The first payment was $10,215,511.", "t0": 13.56, "t1": 15.91, "shot": "r4", "visual": {"type": "record", "source": "trust22", "heading": "Direct trust payments", "context": "Two fiscal years", "layout": "amounts", "rows": [{"label": "Fiscal 2021", "value": "$10,215,511"}, {"label": "Fiscal 2022", "value": "$10,387,903"}]}, "wt": [0.0, 0.11, 0.36, 0.69, 0.81, 1.01, 1.22, 1.44, 1.58, 1.84]}, {"scene": "b", "kind": "quote", "ref": ["suspicious[1]", "established[1]"], "text": "The second was $10,387,903.", "t0": 16.03, "t1": 18.22, "shot": "r5", "visual": {"type": "quote", "line": "The second was $10,387,903"}, "wt": [0.0, 0.12, 0.41, 0.52, 0.74, 0.95, 1.18, 1.4, 1.69]}, {"scene": "b", "kind": "doc", "ref": ["suspicious[2]", "established[2]"], "text": "The college booked $10,387,903 at June 30, 2021.", "t0": 18.34, "t1": 22.18, "shot": "r6", "visual": {"type": "doc", "source": "collegeaudit", "kicker": "College accounts", "text": "Due to primary government", "mark": "primary government"}, "wt": [0.0, 0.1, 0.48, 0.72, 0.93, 1.14, 1.38, 1.58, 1.85, 2.21, 2.3, 2.52, 2.97, 3.27]}, {"scene": "b", "kind": "quote", "ref": ["suspicious[2]", "established[2]"], "text": "The trust received the invoices in July and recorded the matching payment the following fiscal year.", "t0": 22.3, "t1": 26.75, "shot": "r7", "visual": {"type": "quote", "line": "The trust received the invoices in July and recorded the matching payment the following fiscal year"}, "wt": [0.0, 0.11, 0.39, 0.71, 0.84, 1.36, 1.46, 1.93, 2.13, 2.49, 2.59, 2.92, 3.31, 3.43, 3.8, 4.16]}, {"scene": "b", "kind": "bignum", "ref": ["suspicious[1]", "suspicious[3]", "established[1]", "established[3]"], "text": "Together the payments came to $20,603,414.", "t0": 26.87, "t1": 29.69, "shot": "r8", "visual": {"type": "bignum", "value": "$20,603,414", "label": "Direct payments to City College"}, "wt": [0.0, 0.45, 0.55, 0.89, 1.06, 1.15, 1.34, 1.58, 1.8, 2.01, 2.28]}, {"scene": "b", "kind": "quote", "ref": ["suspicious[1]", "suspicious[3]", "established[1]", "established[3]"], "text": "That left $396,586 of the authorization unused.", "t0": 29.81, "t1": 34.84, "sh