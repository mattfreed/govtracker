{"id": "city-funded-nonprofits-fund-political-arms", "title": "City-funded charities that send money to political arms", "seconds": 130.3, "voice": "elevenlabs:exurTFaGNF2gnRcPNH8I", "narrator": "Phil", "tempo": 1.157, "made": "2026-11-24", "key": "d401c7f9ca822c84", "words": 414, "beats": [{"scene": "open", "kind": "versus", "ref": ["story[0]"], "text": "A charity can’t take part in election campaigns. And City grant money can’t be spent on politics.", "t0": 0.2, "t1": 4.94, "shot": "b0", "visual": {"type": "versus", "a": ["a charity, 501(c)(3)", "no election campaigns"], "b": ["an advocacy group, 501(c)(4)", "can lobby, back ballot measures"]}, "wt": [0.0, 0.1, 0.41, 0.6, 0.79, 1.02, 1.13, 1.46, 2.52, 2.71, 2.95, 3.18, 3.4, 3.61, 3.71, 4.0, 4.12]}, {"scene": "open", "kind": "doc", "ref": ["story[1]", "oneLine"], "text": "But charities the City funds also give grants to advocacy groups and political committees.", "t0": 5.06, "t1": 9.19, "shot": "b1", "visual": {"type": "doc", "kicker": "Form 990, Schedule I", "text": "Schedule I of the tax return lists every grant a charity makes.", "mark": "every grant"}, "wt": [0.0, 0.14, 0.59, 0.71, 0.98, 1.32, 1.62, 1.8, 2.12, 2.24, 2.74, 3.07, 3.26, 3.65]}, {"scene": "open", "kind": "doc", "ref": ["story[1]", "oneLine"], "text": "And how much is that, in all?", "t0": 9.31, "t1": 10.86, "shot": "b1", "visual": {"type": "doc", "kicker": "Form 990, Schedule I", "text": "Schedule I of the tax return lists every grant a charity makes.", "mark": "every grant"}, "wt": [0.0, 0.12, 0.21, 0.37, 0.47, 1.05, 1.21]}, {"scene": "open", "kind": "bignum", "ref": ["amount", "oneLine"], "text": "415,000 dollars.", "t0": 10.86, "t1": 12.31, "shot": "b2", "visual": {"type": "bignum", "value": "$415,000", "label": "from City-funded charities to three advocacy organizations"}, "emph": ["415,000"], "wt": [0.04, 0.23, 0.45, 0.76, 1.06]}, {"scene": "open", "kind": "caveat", "ref": ["status"], "text": "This is a lead, not a finding. Each grant is on the charity’s own tax return.", "t0": 12.83, "t1": 16.45, "shot": "b3", "visual": {"type": "caveat", "line": "This is a lead, not a finding: a pattern in public records. This film says what the records show, what they do not show, and what would settle it."}, "wt": [0.0, 0.17, 0.28, 0.36, 0.66, 0.85, 0.92, 1.58, 1.82, 2.11, 2.23, 2.33, 2.43, 2.86, 3.05, 3.31]}, {"scene": "open", "kind": "versus", "ref": ["story[0]", "innocent[0]"], "text": "A charity may give its own unrestricted money, within limits, to an advocacy group.", "t0": 16.57, "t1": 20.68, "shot": "b4", "visual": {"type": "versus", "a": ["a charity, 501(c)(3)", "no election campaigns"], "b": ["an advocacy group, 501(c)(4)", "can lobby, back ballot measures"]}, "wt": [0.0, 0.14, 0.48, 0.6, 0.75, 0.89, 1.16, 1.75, 2.24, 2.54, 3.06, 3.2, 3.31, 3.78]}, {"scene": "open", "kind": "versus", "ref": ["story[0]", "innocent[0]"], "text": "That group can lobby and back ballot measures.", "t0": 20.8, "t1": 22.6, "shot": "b4", "visual": {"type": "versus", "a": ["a charity, 501(c)(3)", "no election campaigns"], "b": ["an advocacy group, 501(c)(4)", "can lobby, back ballot measures"]}, "wt": [0.0, 0.17, 0.39, 0.53, 0.8, 0.9, 1.11, 1.38]}, {"scene": "open", "kind": "quote", "ref": ["story[2]"], "text": "The catch: money is fungible.", "t0": 22.72, "t1": 23.99, "shot": "b5", "visual": {"type": "quote", "line": "Money is fungible."}, "wt": [0.0, 0.11, 0.53, 0.75, 0.86]}, {"scene": "open", "kind": "quote", "ref": ["story[2]"], "text": "When a group lives mostly on public grants, only its books show which dollars went.", "t0": 24.11, "t1": 27.73, "shot": "b5", "visual": {"type": "quote", "line": "Money is fungible."}, "wt": [0.0, 0.13, 0.18, 0.43, 0.75, 1.07, 1.18, 1.45, 2.04, 2.26, 2.39, 2.63, 2.8, 2.99, 3.33]}, {"scene": "abode", "kind": "chain", "ref": ["suspicious[0]", "links[0]"], "text": "The biggest: Abode Services.", "t0": 27.95, "t1": 29.44, "shot": "b6", "visual": {"type": "chain", "steps": [{"art": "cityhall", "name": "City departments", "sub": "$74.1 million, fiscal 2019 to 2026"}, {"art": "housing", "name": "Abode Services", "sub": "a City-funded charity"}, {"art": "money", "name": "NPH Action Fund", "sub": "an advocacy group"}], "kicker": "From the charity’s own tax return"}, "wt": [0.0, 0.11, 0.44, 0.79]}, {"scene": "abode", "kind": "chain", "ref": ["suspicious[0]", "links[0]"], "text": "The City paid it 74.1 million dollars from fiscal 2019 to 2026.", "t0": 29.56, "t1": 34.46, "shot": "b6", "visual": {"type": "chain", "steps": [{"art": "cityhall", "name": "City departments", "sub": "$74.1 million, fiscal 2019 to 2026"}, {"art": "housing", "name": "Abode Services", "sub": "a City-funded charity"}, {"art": "money", "name": "NPH Action Fund", "sub": "an advocacy group"}], "kicker": "From the charity’s own tax return"}, "emph": ["74.1 million"], "wt": [0.0, 0.21, 0.49, 0.7, 0.81, 1.33, 1.61, 1.84, 2.16, 2.5, 2.69, 3.1, 3.39, 3.82, 3.91, 4.17]}, {"scene": "abode", "kind": "chain", "ref": ["suspicious[0].what", "links[1]"], "text": "Over two years, what did it grant NPH Action Fund?", "t0": 34.58, "t1": 37.32, "shot": "b6", "visual": {"type": "chain", "steps": [{"art": "cityhall", "name": "City departments", "sub": "$74.1 million, fiscal 2019 to 2026"}, {"art": "housing", "name": "Abode Services", "sub": "a City-funded charity"}, {"art": "money", "name": "NPH Action Fund", "sub": "an advocacy group"}], "kicker": "From the charity’s own tax return"}, "wt": [0.0, 0.22, 0.4, 0.65, 0.8, 0.93, 1.03, 1.29, 1.74, 2.05]}, {"scene": "abode", "kind": "bignum", "ref": ["suspicious[0]", "links[1]"], "text": "175,000 dollars.", "t0": 37.32, "t1": 39.38, "shot": "b8", "visual": {"type": "bignum", "value": "$175,000", "label": "to NPH Action Fund, years to June 2024 and 2025", "sub": "two spellings, one tax number"}, "emph": ["175,000"], "wt": [0.04, 0.23, 0.5, 1.1, 1.46]}, {"scene": "abode", "kind": "quote", "ref": ["suspicious[0].what", "links[1]"], "text": "Its stated purpose: promote affordable housing development.", "t0": 39.9, "t1": 42.63, "shot": "b9", "visual": {"type": "quote", "line": "PROMOTE AFFORDABLE HOUSING DEVELOPMENT"}, "wt": [0.0, 0.18, 0.49, 1.28, 1.63, 2.02, 2.31]}, {"scene": "abode", "kind": "count", "ref": ["established[1]", "story[3]"], "text": "Three more City-funded charities gave it money too: 270,000 dollars from four in all.", "t0": 42.75, "t1": 47.44, "shot": "b9", "visual": {"type": "count", "value": "$270,000", "label": "to NPH Action Fund from four City-funded charities", "sub": "Abode Services $175,000; Tenants and Owners Development Corporation $50,000; United Way of the Bay Area $25,000; Tides Center $20,000"}, "wt": [0.0, 0.21, 0.39, 0.87, 1.23, 1.38, 1.47, 1.69, 2.44, 2.65, 2.92, 3.23, 3.54, 3.81, 4.02, 4.3, 4.41]}, {"scene": "abode", "kind": "bignum", "ref": ["established[2]", "suspicious[0].why"], "text": "Campaign filings show a committee of that name, at the same ZIP code,", "t0": 47.56, "t1": 51.19, "shot": "b9c", "visual": {"type": "bignum", "value": "$710,000", "label": "from NPH Action Fund Political Issues Committee to two San Francisco ballot-measure committees", "sub": "2024 and 2026"}, "wt": [0.0, 0.4, 0.77, 0.95, 1.01, 1.29, 1.37, 1.56, 2.16, 2.3, 2.41, 2.65, 2.92]}, {"scene": "abode", "kind": "bignum", "ref": ["established[2]", "suspicious[0].why"], "text": "gave 710,000 dollars to San Francisco measures.", "t0": 51.19, "t1": 54.13, "shot": "b9c", "visual": {"type": "bignum", "value": "$710,000", "label": "from NPH Action Fund Political Issues Committee to two San Francisco ballot-measure committees", "sub": "2024 and 2026"}, "wt": [0.04, 0.29, 0.55, 0.78, 0.99, 1.31, 1.63, 1.76, 1.93, 2.36]}, {"scene": "abode", "kind": "bignum", "ref": ["established[3]"], "text": "The Fund’s returns show 19.4 million dollars raised in three years.", "t0": 54.25, "t1": 57.76, "shot": "b9d", "visual": {"type": "bignum", "value": "$19.4 million", "label": "contributions on NPH Action Fund’s own returns, 2022 to 2024", "sub": "the four charities’ $270,000: about 1.4%"}, "wt": [0.0, 0.12, 0.38, 0.79, 1.03, 1.36, 1.58, 1.79, 2.07, 2.37, 2.59, 2.68, 2.9]}, {"scene": "abode", "kind": "bignum", "ref": ["established[3]"], "text": "The charities gave about 1.4 percent.", "t0": 57.88, "t1": 59.76, "shot": "b9d", "visual": {"type": "bignum", "value": "$19.4 million", "label": "contributions on NPH Action Fund’s own returns, 2022 to 2024", "sub": "the four charities’ $270,000: about 1.4%"}, "emph": ["1.4 percent"], "wt": [0.0, 0.08, 0.43, 0.61, 0.84, 1.01, 1.22, 1.42]}, {"scene": "coleman", "kind": "chain", "ref": ["suspicious[1]", "links[2]", "links[3]"], "text": "Next, Coleman Children & Youth Services. The City paid it 1.7 million dollars.", "t0": 59.98, "t1": 64.87, "shot": "b10", "visual": {"type": "chain", "steps": [{"art": "cityhall", "name": "City departments", "sub": "$1.7 million, fiscal 2019 to 2026"}, {"art": "housing", "name": "Coleman Children & Youth Services", "sub": "a City-funded charity"}, {"art": "money", "name": "Coleman Action Fund", "sub": "an advocacy group"}], "kicker": "From the charity’s own tax return"}, "wt": [0.0, 0.68, 1.05, 1.38, 1.51, 1.72, 2.65, 2.81, 3.08, 3.31, 3.45, 3.65, 3.87, 4.13, 4.39]}, {"scene": "coleman", "kind": "versus", "ref": ["suspicious[1].what", "oneLine"], "text": "From 2021 to 2025, it gave 100,000 dollars to an advocacy group sharing its name.", "t0": 64.99, "t1": 70.62, "shot": "b11", "visual": {"type": "versus", "a": ["Coleman Children & Youth Services", "the charity"], "b": ["Coleman Action Fund", "its namesake advocacy group, $100,000"]}, "emph": ["100,000"], "wt": [0.0, 0.19, 0.47, 0.91, 1.0, 1.24, 2.16, 2.3, 2.53, 2.71, 2.94, 3.26, 3.91, 4.08, 4.18, 4.68, 4.92, 5.22, 5.37]}, {"scene": "coleman", "kind": "versus", "ref": ["suspicious[1].what"], "text": "Coleman Action Fund. The stated purpose: general support.", "t0": 70.74, "t1": 73.86, "shot": "b11", "visual": {"type": "versus", "a": ["Coleman Children & Youth Services", "the charity"], "b": ["Coleman Action Fund", "its namesake advocacy group, $100,000"]}, "wt": [0.0, 0.37, 0.67, 1.35, 1.51, 1.84, 2.48, 2.8]}, {"scene": "tides", "kind": "chain", "ref": ["suspicious[2]", "links[4]"], "text": "Then Tides Center. The City paid it the most of the three: 104.7 million dollars.", "t0": 74.08, "t1": 79.25, "shot": "b13", "visual": {"type": "chain", "steps": [{"art": "cityhall", "name": "City departments", "sub": "$104.7 million, fiscal 2019 to 2026"}, {"art": "housing", "name": "Tides Center", "sub": "a City-funded charity"}, {"art": "money", "name": "Mycelium In Action Fund", "sub": "an advocacy group"}], "kicker": "From the charity’s own tax return"}, "emph": ["104.7 million"], "wt": [0.0, 0.19, 0.51, 1.24, 1.43, 1.7, 1.89, 1.98, 2.09, 2.34, 2.43, 2.54, 3.14, 3.34, 3.66, 3.89, 4.15, 4.44, 4.74]}, {"scene": "tides", "kind": "chain", "ref": ["suspicious[2].what", "links[5]"], "text": "In 2023, it gave Mycelium In Action Fund 45,000 dollars.", "t0": 79.38, "t1": 83.36, "shot": "b13", "visual": {"type": "chain", "steps": [{"art": "cityhall", "name": "City departments", "sub": "$104.7 million, fiscal 2019 to 2026"}, {"art": "housing", "name": "Tides Center", "sub": "a City-funded charity"}, {"art": "money", "name": "Mycelium In Action Fund", "sub": "an advocacy group"}], "kicker": "From the charity’s own tax return"}, "emph": ["45,000"], "wt": [0.0, 0.13, 0.43, 1.18, 1.33, 1.55, 1.99, 2.1, 2.42, 2.7, 3.21, 3.56]}, {"scene": "tides", "kind": "chain", "ref": ["suspicious[2].what", "links[5]"], "text": "Purpose: healthy individuals and communities.", "t0": 83.48, "t1": 85.72, "shot": "b13", "visual": {"type": "chain", "steps": [{"art": "cityhall", "name": "City departments", "sub": "$104.7 million, fiscal 2019 to 2026"}, {"art": "housing", "name": "Tides Center", "sub": "a City-funded charity"}, {"art": "money", "name": "Mycelium In Action Fund", "sub": "an advocacy group"}], "kicker": "From the charity’s own tax return"}, "wt": [0.0, 0.61, 0.88, 1.34, 1.47]}, {"scene": "tides", "kind": "quote", "ref": ["suspicious[2].why", "suspicious[0].why"], "text": "Each recipient can do political work the charity cannot.", "t0": 85.84, "t1": 88.25, "shot": "b15", "visual": {"type": "quote", "line": "The return does not say whether the money came from unrestricted funds."}, "wt": [0.0, 0.24, 0.68, 0.81, 0.92, 1.26, 1.44, 1.54, 1.85]}, {"scene": "tides", "kind": "quote", "ref": ["suspicious[2].why", "suspicious[0].why"], "text": "And no return says whether the money came from unrestricted funds.", "t0": 88.37, "t1": 91.19, "shot": "b15", "visual": {"type": "quote", "line": "The return does not say whether the money came from unrestricted funds."}, "wt": [0.0, 0.16, 0.33, 0.65, 0.88, 1.12, 1.22, 1.45, 1.64, 1.82, 2.36]}, {"scene": "tides", "kind": "rank", "ref": ["oneLine", "amount", "established[1]"], "text": "Line them up: 270,000 to NPH Action Fund, 100,000 and 45,000.", "t0": 91.31, "t1": 97.12, "shot": "b16", "visual": {"type": "rank", "label": "Grants to advocacy organizations", "rows": [["Four charities → NPH Action Fund", "$270,000"], ["Coleman → Coleman Action Fund", "$100,000"], ["Tides Center → Mycelium In Action Fund", "$45,000"]]}, "wt": [0.0, 0.21, 0.35, 1.12, 1.32, 1.56, 1.85, 2.24, 2.38, 2.83, 3.16, 4.02, 4.21, 4.43, 4.82, 4.98, 5.43]}, {"scene": "tides", "kind": "rank", "ref": ["oneLine", "amount"], "text": "Together, 415,000 dollars, to three advocacy groups.", "t0": 97.24, "t1": 101.28, "shot": "b16", "visual": {"type": "rank", "label": "Grants to advocacy organizations", "rows": [["Four charities → NPH Action Fund", "$270,000"], ["Coleman → Coleman Action Fund", "$100,000"], ["Tides Center → Mycelium In Action Fund", "$45,000"]]}, "wt": [0.0, 0.65, 0.88, 1.13, 1.45, 1.76, 2.53, 2.73, 3.01, 3.48]}, {"scene": "todco", "kind": "chain", "ref": ["suspicious[3]", "story[4]", "links[6]", "links[7]", "established[7]"], "text": "TODCO, another City-funded charity, spends on ballot measures itself.", "t0": 101.5, "t1": 105.73, "shot": "b16a", "visual": {"type": "chain", "steps": [{"art": "cityhall", "name": "City departments", "sub": "$3.7 million, fiscal 2019 to 2026"}, {"art": "housing", "name": "Tenants and Owners Development Corporation", "sub": "TODCO, a City-funded charity"}, {"art": "money", "name": "TODCO-sponsored ballot committees", "sub": "Build Affordable Faster CA (owed $550 in late fees, 2021 list); Housing Forward SF"}], "kicker": "From its own campaign filings"}, "wt": [0.0, 0.66, 1.01, 1.5, 2.18, 2.49, 2.6, 2.89, 3.21]}, {"scene": "todco", "kind": "chain", "ref": ["suspicious[3]", "story[4]", "links[6]", "links[7]", "established[7]"], "text": "From 2014 to 2024, how much?", "t0": 105.73, "t1": 109.25, "shot": "b16a", "visual": {"type": "chain", "steps": [{"art": "cityhall", "name": "City departments", "sub": "$3.7 million, fiscal 2019 to 2026"}, {"art": "housing", "name": "Tenants and Owners Development Corporation", "sub": "TODCO, a City-funded charity"}, {"art": "money", "name": "TODCO-sponsored ballot committees", "sub": "Build Affordable Faster CA (owed $550 in late fees, 2021 list); Housing Forward SF"}], "kicker": "From its own campaign filings"}, "wt": [0.04, 0.24, 0.54, 1.18, 1.35, 1.63, 2.29, 2.47]}, {"scene": "todco", "kind": "bignum", "ref": ["suspicious[3].what", "suspicious[3].why", "established[4]"], "text": "2.4 million dollars, in its own name, not through an advocacy group.", "t0": 109.25, "t1": 113.23, "shot": "b16b", "visual": {"type": "bignum", "value": "$2.4 million", "label": "contributions and campaign payments, TODCO and its affiliate, 2014 to 2024", "sub": "$1,126,393 of it to committees TODCO sponsors"}, "emph": ["2.4 million"], "wt": [0.04, 0.22, 0.43, 0.62, 0.9, 1.5, 1.63, 1.8, 2.01, 2.75, 2.94, 3.14, 3.23, 3.68]}, {"scene": "close", "kind": "unknowns", "ref": ["notEstablished[0]", "notEstablished[1]"], "text": "Not established: that City or restricted money was used,", "t0": 113.85, "t1": 117.03, "shot": "b17", "visual": {"type": "unknowns", "cards": ["That City or restricted money was used", "That the charities’ own dollars paid for any campaign"]}, "wt": [0.0, 0.25, 1.11, 1.33, 1.66, 1.79, 2.18, 2.37, 2.53]}, {"scene": "close", "kind": "unknowns", "ref": ["notEstablished[0]", "notEstablished[1]"], "text": "or that the charities’ own dollars paid for any campaign.", "t0": 117.03, "t1": 119.65, "shot": "b17", "visual": {"type": "unknowns", "cards": ["That City or restricted money was used", "That the charities’ own dollars paid for any campaign"]}, "wt": [0.04, 0.19, 0.32, 0.42, 0.86, 1.05, 1.39, 1.62, 1.74, 1.92]}, {"scene": "close", "kind": "settle", "ref": ["next[0]", "next[1]"], "text": "What would settle it? Each charity’s audited accounts, showing which fund each grant came from.", "t0": 119.77, "t1": 124.46, "shot": "b18", "visual": {"type": "settle", "cards": [{"who": "", "what": "Each charity’s audited statement of functional expenses"}, {"who": "", "what": "The recipients’ campaign and lobbying filings"}], "focus": 0}, "wt": [0.0, 0.18, 0.37, 0.64, 1.19, 1.42, 1.82, 2.21, 2.97, 3.29, 3.49, 3.78, 3.97, 4.24, 4.47]}, {"scene": "close", "kind": "status", "ref": ["defense[0]"], "text": "No one named here was contacted. No authority has made a finding.", "t0": 124.58, "t1": 127.6, "shot": "b19", "visual": {"type": "status"}, "wt": [0.0, 0.2, 0.34, 0.65, 0.8, 0.93, 1.79, 1.95, 2.35, 2.47, 2.61, 2.68]}, {"scene": "close", "kind": "end", "ref": ["end"], "text": "A lead is a question, not an accusation.", "t0": 127.72, "t1": 129.43, "shot": "b20", "visual": {"type": "end"}, "wt": [0.0, 0.11, 0.33, 0.42, 0.5, 0.87, 1.03, 1.12]}], "format": 6, "chapters": {"open": "The question", "abode": "Abode Services · $150,000", "coleman": "A namesake fund · $100,000", "tides": "Tides Center · $45,000", "todco": "TODCO · its own ballot money", "close": "What would settle it"}, "look": "terminal", "hook": "contrast"}