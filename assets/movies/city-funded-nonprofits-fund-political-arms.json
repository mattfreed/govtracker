], "text": "Not established: that City or restricted money was used,", "t0": 114.83, "t1": 117.89, "shot": "b17", "visual": {"type": "unknowns", "cards": ["That City or restricted money was used", "That the charities’ own dollars paid for any campaign"]}, "wt": [0.0, 0.24, 1.07, 1.28, 1.6, 1.73, 2.11, 2.29, 2.44]}, {"scene": "close", "kind": "unknowns", "ref": ["notEstablished[0]", "notEstablished[1]"], "text": "or that the charities’ own dollars paid for any campaign.", "t0": 117.89, "t1": 120.4, "shot": "b17", "visual": {"type": "unknowns", "cards": ["That City or restricted money was used", "That the charities’ own dollars paid for any campaign"]}, "wt": [0.04, 0.19, 0.31, 0.41, 0.83, 1.02, 1.35, 1.57, 1.68, 1.85]}, {"scene": "close", "kind": "settle", "ref": ["next[0]", "next[1]"], "text": "What would settle it? Each charity’s audited accounts, showing which fund each grant came from.", "t0": 120.52, "t1": 125.03, "shot": "b18", "visual": {"type": "settle", "cards": [{"who": "", "what": "Each charity’s audited statement of functional expenses"}, {"who": "", "what": "The recipients’ campaign and lobbying filings"}], "focus": 0}, "wt": [0.0, 0.17, 0.35, 0.61, 1.15, 1.37, 1.76, 2.13, 2.87, 3.17, 3.36, 3.64, 3.83, 4.09, 4.31]}, {"scene": "close", "kind": "status", "ref": ["defense[0]"], "text": "No one named here was contacted. No authority has made a finding.", "t0": 125.15, "t1": 128.04, "shot": "b19", "visual": {"type": "status"}, "wt": [0.0, 0.19, 0.32, 0.62, 0.77, 0.89, 1.73, 1.88, 2.27, 2.38, 2.52, 2.59]}, {"scene": "close", "kind": "end", "ref": ["end"], "text": "A lead is a question, not an accusation.", "t0": 128.16, "t1": 129.8, "shot": "b20", "visual": {"type": "end"}, "wt": [0.0, 0.11, 0.32, 0.41, 0.49, 0.84, 0.99, 1.08]}], "format": 6, "chapters": {"open": "The question", "abode": "Abode Services · $150,000", "coleman": "A namesake fund · $100,000", "tides": "Tides Center · $45,000", "todco": "TODCO · its own ballot money", "close": "What would settle i