{"id": "salvation-army-food-distribution-eligibility", "title": "Three food-distribution audits questioned missing eligibility records", "seconds": 44.0, "voice": "elevenlabs:OtHu0lbpdNTqJVqaxDtR", "narrator": "Maven", "made": "2026-11-25", "key": "d84124b062386d36", "words": 135, "beats": [{"scene": "open", "kind": "hook", "ref": ["suspicious[0]", "established[0]"], "text": "Three audits found recurring gaps in records for a federal food program.", "t0": 0.2, "t1": 3.47, "shot": "r0", "visual": {"type": "hook", "words": ["Who", "signed", "for", "the", "food?"], "sub": "The Salvation Army"}, "wt": [0.0, 0.27, 0.67, 0.9, 1.31, 1.61, 1.73, 2.09, 2.22, 2.29, 2.59, 2.79]}, {"scene": "open", "kind": "doc", "ref": ["suspicious[0]", "established[0]"], "text": "Auditors checked sixty recipients each year at sites that kept forms.", "t0": 3.59, "t1": 7.01, "shot": "r1", "visual": {"type": "doc", "source": "fy25", "kicker": "Federal Audit Clearinghouse; Deloitte & Touche LLP", "text": "Eligibility declarations", "mark": "Eligibility declarations"}, "wt": [0.0, 0.48, 0.81, 1.19, 1.74, 1.94, 2.14, 2.25, 2.52, 2.64, 2.84]}, {"scene": "open", "kind": "record", "ref": ["suspicious[0]", "established[0]"], "text": "Signed declarations were missing for seven, then nine, then ten recipients.", "t0": 7.13, "t1": 11.41, "shot": "r2", "visual": {"type": "record", "layout": "relationship", "context": "Samples of sixty", "heading": "Missing signed forms", "source": "fy25", "rows": [{"icon": "file", "label": "FY2023", "value": "7"}, {"icon": "file", "label": "FY2024", "value": "9"}, {"icon": "file", "label": "FY2025", "value": "10"}]}, "wt": [0.0, 0.32, 0.95, 1.09, 1.4, 1.56, 2.2, 2.46, 3.07, 3.3, 3.55]}, {"scene": "open", "kind": "quote", "ref": ["suspicious[1]", "established[1]"], "text": "Other sites did not require or retain the forms at all.", "t0": 11.53, "t1": 14.09, "shot": "r3", "visual": {"type": "quote", "line": "Other distribution sites"}, "wt": [0.0, 0.26, 0.53, 0.69, 0.86, 1.34, 1.5, 1.79, 1.89, 2.19, 2.3]}, {"scene": "open", "kind": "record", "ref": ["suspicious[1]", "established[1]"], "text": "Auditors questioned the value of food distributed at those sites.", "t0": 14.21, "t1": 17.31, "shot": "r4", "visual": {"type": "record", "layout": "amounts", "context": "Regional audit findings", "heading": "Food at sites missing records", "source": "fy25", "rows": [{"icon": "audit", "label": "FY2023", "value": "$956,107"}, {"icon": "audit", "label": "FY2024", "value": "$1,862,618"}, {"icon": "audit", "label": "FY2025", "value": "$1,294,618"}]}, "wt": [0.0, 0.55, 0.99, 1.09, 1.41, 1.52, 1.77, 2.28, 2.37, 2.59]}, {"scene": "open", "kind": "bignum", "ref": ["suspicious[1]", "established[1]"], "text": "The regional amount for fiscal 2025 was 1,294,618 dollars.", "t0": 17.43, "t1": 21.35, "shot": "r5", "visual": {"type": "bignum", "value": "$1,294,618", "label": "Regional questioned costs for FY2025"}, "wt": [0.0, 0.11, 0.46, 0.72, 0.89, 1.22, 1.46, 2.14, 2.3, 2.54, 2.71, 2.94, 3.16, 3.44]}, {"scene": "scope", "kind": "doc", "ref": ["suspicious[3]", "established[3]"], "text": "The award schedules also name the San Francisco–Marin Food Bank.", "t0": 21.57, "t1": 24.83, "shot": "r6", "visual": {"type": "doc", "source": "fy25", "kicker": "Federal Audit Clearinghouse; Deloitte & Touche LLP", "text": "San Francisco–Marin Food Bank", "mark": "San Francisco–Marin Food Bank"}, "wt": [0.0, 0.1, 0.43, 0.97, 1.33, 1.53, 1.63, 1.83, 2.35, 2.46, 2.74, 2.97]}, {"scene": "scope", "kind": "record", "ref": ["suspicious[3]", "established[3]"], "text": "Those local spending lines are separate from the regional audit findings.", "t0": 24.95, "t1": 28.04, "shot": "r7", "visual": {"type": "record", "layout": "amounts", "context": "San Francisco–Marin award lines", "heading": "Local program expenditures", "source": "fy25", "rows": [{"icon": "file", "label": "FY2024", "value": "$392,372"}, {"icon": "file", "label": "FY2025", "value": "$391,014"}]}, "wt": [0.0, 0.24, 0.51, 0.85, 1.09, 1.21, 1.61, 1.76, 1.88, 2.25, 2.49]}, {"scene": "scope", "kind": "quote", "ref": ["suspicious[3]", "established[3]"], "text": "The auditors did not allocate questioned costs to individual local sites.", "t0": 28.16, "t1": 31.73, "shot": "r8", "visual": {"type": "quote", "line": "Four local sites in FY2025"}, "wt": [0.0, 0.12, 0.54, 0.69, 0.87, 1.31, 1.7, 2.13, 2.29, 2.79, 3.08]}, {"scene": "scope", "kind": "doc", "ref": ["suspicious[2]", "established[2]"], "text": "A restatement had added 4,021,045 dollars in previously unreported food expenditures.", "t0": 31.85, "t1": 36.16, "shot": "r9", "visual": {"type": "doc", "source": "fy23", "kicker": "Federal Audit Clearinghouse; Deloitte & Touche LLP", "text": "Restated awards schedule", "mark": "Restated awards schedule"}, "wt": [0.0, 0.17, 0.77, 0.91, 1.17, 1.42, 1.66, 1.93, 2.28, 2.38, 2.86, 3.34, 3.53]}, {"scene": "scope", "kind": "unknowns", "ref": ["suspicious[0]", "notEstablished[0]"], "text": "Missing paperwork leaves eligibility unverified. No repayment decision is established.", "t0": 36.28, "t1": 40.81, "shot": "r10", "visual": {"type": "unknowns", "cards": ["Recipient eligibility", "Repayment decision"]}, "wt": [0.0, 0.36, 0.84, 1.06, 1.64, 2.68, 2.93, 3.4, 3.76, 3.89]}, {"scene": "scope", "kind": "end", "ref": ["status"], "text": "Every source is linked in the case file below.", "t0": 40.93, "t1": 43.07, "shot": "r11", "visual": {"type": "end"}, "wt": [0.0, 0.31, 0.65, 0.8, 1.06, 1.17, 1.26, 1.5, 1.76]}], "format": 6, "chapters": {"open": "The missing forms", "scope": "What the local award schedule shows"}, "look": "terminal", "hook": "document"}