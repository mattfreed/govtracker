{"id": "labor-slate-coordinated-supervisor-flyer", "title": "A joint campaign event turned part of a slate flyer into a $2,613 contribution", "seconds": 51.9, "voice": "elevenlabs:iPYqcpY8j8Ap4jUf28I3", "narrator": "Michael", "tempo": 1.041, "made": "2026-11-27", "key": "0007fd339a970453", "words": 129, "beats": [{"scene": "p", "kind": "hook", "ref": ["suspicious[0]", "established[0]"], "text": "The Labor & Working Families Slate opposed Bilal Mahmood.", "t0": 0.2, "t1": 3.76, "shot": "r0", "visual": {"type": "hook", "words": ["The", "independently", "reported", "flyer"], "sub": "Labor & Working Families Slate"}, "wt": [0.0, 0.17, 0.53, 0.67, 1.07, 1.55, 2.02, 2.64, 3.02]}, {"scene": "p", "kind": "quote", "ref": ["suspicious[0]", "established[0]"], "text": "It reported $3,484 as independent spending.", "t0": 3.88, "t1": 9.13, "shot": "r0-part1", "visual": {"type": "quote", "line": "It reported $3,484 as independent spending"}, "wt": [0.0, 0.17, 0.65, 1.02, 1.57, 1.82, 2.27, 2.8, 3.65, 3.98, 4.67]}, {"scene": "p", "kind": "doc", "ref": ["suspicious[0]", "established[0]"], "text": "The vendor was Rough House Productions.", "t0": 9.25, "t1": 11.27, "shot": "r1", "visual": {"type": "doc", "source": "f211238791", "kicker": "The vendor schedule", "text": "Rough House Productions", "mark": "Rough House"}, "wt": [0.0, 0.19, 0.51, 0.72, 0.99, 1.28]}, {"scene": "p", "kind": "quote", "ref": ["suspicious[0]", "established[0]"], "text": "The slate paid for two versions of the flyer.", "t0": 11.39, "t1": 13.91, "shot": "r1-part1", "visual": {"type": "quote", "line": "The slate paid for two versions of the flyer"}, "wt": [0.0, 0.18, 0.65, 0.92, 1.08, 1.37, 1.85, 1.95, 2.05]}, {"scene": "b", "kind": "doc", "ref": ["suspicious[1]", "established[1]"], "text": "Daniel Anderson agreed on distribution with Dean Preston’s campaign staff.", "t0": 14.13, "t1": 18.1, "shot": "r2", "visual": {"type": "doc", "source": "order", "kicker": "The joint event", "text": "Coordinated expenditure", "mark": "expenditure"}, "wt": [0.0, 0.38, 0.81, 1.27, 1.39, 2.0, 2.18, 2.47, 3.0, 3.52]}, {"scene": "b", "kind": "quote", "ref": ["suspicious[1]", "established[1]"], "text": "The agreement covered when, where and how volunteers would distribute literature.", "t0": 18.22, "t1": 22.86, "shot": "r2-more1", "visual": {"type": "quote", "line": "The agreement covered when, where and how volunteers would distribute literature"}, "wt": [0.0, 0.15, 0.6, 0.98, 1.66, 2.13, 2.39, 2.7, 3.4, 3.58, 4.07]}, {"scene": "b", "kind": "bignum", "ref": ["suspicious[1]", "established[1]"], "text": "The Ethics Commission assigned $2,613 of the cost to the supervisor campaign.", "t0": 22.98, "t1": 29.84, "shot": "r3", "visual": {"type": "bignum", "value": "$2,613", "label": "In-kind contribution"}, "wt": [0.0, 0.2, 0.59, 1.06, 1.54, 1.84, 2.4, 2.7, 3.05, 3.64, 4.49, 4.67, 4.81, 5.37, 5.54, 5.64, 6.26]}, {"scene": "o", "kind": "bignum", "ref": ["suspicious[2]", "established[2]"], "text": "The contribution exceeded the $500 limit by $2,113.", "t0": 30.06, "t1": 36.77, "shot": "r4", "visual": {"type": "bignum", "value": "$2,113", "label": "Over the limit"}, "wt": [0.0, 0.13, 0.82, 1.34, 1.46, 1.75, 2.04, 2.42, 3.13, 3.36, 3.69, 4.26, 4.45, 5.16, 6.07]}, {"scene": "o", "kind": "bignum", "ref": ["suspicious[2]", "established[2]"], "text": "The settlement was $2,513.", "t0": 36.89, "t1": 40.7, "shot": "r5", "visual": {"type": "bignum", "value": "$2,513", "label": "Settlement"}, "wt": [0.0, 0.2, 0.78, 1.02, 1.31, 1.84, 2.19, 2.6, 3.2]}, {"scene": "o", "kind": "quote", "ref": ["suspicious[2]", "established[2]"], "text": "The order says Preston and his committee did not know the substance of the flyer.", "t0": 40.82, "t1": 45.41, "shot": "r5-part1", "visual": {"type": "quote", "line": "The order says Preston and his committee did not know the substance of the flyer"}, "wt": [0.0, 0.19, 0.55, 1.01, 1.55, 1.69, 1.84, 2.55, 2.75, 2.94, 3.3, 3.45, 3.94, 4.04, 4.14]}, {"scene": "o", "kind": "quote", "ref":