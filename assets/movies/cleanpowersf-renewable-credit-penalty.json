act language", "mark": "Required contract language"}, "wt": [0.0, 0.23, 0.67, 0.91, 0.99, 1.59, 1.72, 2.14]}, {"scene": "o", "kind": "quote", "ref": ["suspicious[2]", "established[2]"], "text": "The commission found that the omission caused no harm.", "t0": 44.4, "t1": 46.74, "shot": "r10", "visual": {"type": "quote", "line": "The commission found that the omission caused no harm"}, "wt": [0.0, 0.13, 0.58, 0.78, 0.91, 1.01, 1.41, 1.79, 2.0]}, {"scene": "o", "kind": "bignum", "ref": ["suspicious[2]", "established[2]"], "text": "The final order assessed $500.", "t0": 46.86, "t1": 49.07, "shot": "r11", "visual": {"type": "bignum", "value": "$500", "label": "Final penalty paid"}, "wt": [0.0, 0.16, 0.5, 0.78, 1.2, 1.44, 1.68]}, {"scene": "o", "kind": "quote", "ref": ["suspicious[2]", "established[2]"], "text": "The state’s compliance table records that payment.", "t0": 49.19, "t1": 51.52, "shot": "r12", "visual": {"type": "quote", "line": "The state’s compliance table records that payment"}, "wt": [0.0, 0.12, 0.44, 0.96, 1.28, 1.7, 1.89]}, {"scene": "o", "kind": "end", "ref": ["status"], "text": "Every source is linked in the case file below.", "t0": 51.64, "t1": 54.0, "shot": "r13", "visual": {"type": "end"}, "wt": [0.0, 0.32, 0.72, 0.94, 1.27, 1.38, 1.49, 1.76, 2.01]}], "format": 6, "chapters": {"p": "The missing clause", "b": "The disputed credits", "o": "The final order"}, "look": "newsroom", "hook": "question"}