{"id": "city-college-reserve-policy-budget", "title": "City College budgeted $32.6 million above its own reserve limit", "seconds": 44.6, "voice": "elevenlabs:9PVP7ENhDskL0KYHAKtD", "narrator": "Jerry B.", "made": "2026-11-27", "key": "32b822443642bf4c", "words": 132, "beats": [{"scene": "p", "kind": "hook", "ref": ["suspicious[0]", "established[0]"], "text": "City College set a ceiling on its unrestricted reserves.", "t0": 0.2, "t1": 2.97, "shot": "r0", "visual": {"type": "hook", "words": ["5%", "to", "9%"], "sub": "City College reserve policy"}, "wt": [0.0, 0.34, 0.72, 0.88, 0.97, 1.37, 1.5, 1.66, 2.24]}, {"scene": "p", "kind": "quote", "ref": ["suspicious[0]", "established[0]"], "text": "Its board chose a range of 5% to 9%.", "t0": 3.09, "t1": 5.72, "shot": "r0-part1", "visual": {"type": "quote", "line": "Its board chose a range of 5% to 9%"}, "wt": [0.0, 0.2, 0.46, 0.73, 0.83, 1.1, 1.2, 1.46, 1.86, 2.02, 2.26]}, {"scene": "p", "kind": "doc", "ref": ["suspicious[0]", "established[0]"], "text": "Separate statewide guidance recommended a minimum near 17%.", "t0": 5.84, "t1": 9.47, "shot": "r1", "visual": {"type": "doc", "source": "policy", "kicker": "Board Policy 8.01", "text": "Unrestricted general fund reserves", "mark": "reserves"}, "wt": [0.0, 0.42, 0.97, 1.38, 1.94, 2.02, 2.44, 2.67, 3.2]}, {"scene": "p", "kind": "quote", "ref": ["suspicious[0]", "established[0]"], "text": "The State Auditor tested the college’s budget against the board’s own limit.", "t0": 9.59, "t1": 13.16, "shot": "r1-part1", "visual": {"type": "quote", "line": "The State Auditor tested the college’s budget against the board’s own limit"}, "wt": [0.0, 0.15, 0.46, 0.85, 1.2, 1.33, 1.81, 2.19, 2.56, 2.7, 3.06, 3.25]}, {"scene": "b", "kind": "record", "ref": ["suspicious[1]", "established[1]"], "text": "The college budgeted $57,977,801 in unrestricted reserves.", "t0": 13.38, "t1": 17.12, "shot": "r2", "visual": {"type": "record", "source": "budget", "heading": "The budget", "context": "Fiscal 2025–26", "layout": "amounts", "rows": [{"label": "Unrestricted ending balance", "value": "$57,977,801"}, {"label": "Local maximum", "value": "$25,336,072"}]}, "wt": [0.0, 0.13, 0.48, 0.93, 1.22, 1.75, 2.09, 2.47, 2.62, 3.21]}, {"scene": "b", "kind": "quote", "ref": ["suspicious[1]", "established[1]"], "text": "The local ceiling used total general fund spending.", "t0": 17.24, "t1": 19.86, "shot": "r2-part1", "visual": {"type": "quote", "line": "The local ceiling used total general fund spending"}, "wt": [0.0, 0.15, 0.5, 0.9, 1.16, 1.54, 1.89, 2.15]}, {"scene": "b", "kind": "bignum", "ref": ["suspicious[1]", "established[1]"], "text": "The State Auditor reported a difference of about $32.6 million.", "t0": 19.98, "t1": 24.19, "shot": "r3", "visual": {"type": "bignum", "value": "$32,642,000", "label": "Budgeted reserves above the maximum"}, "wt": [0.0, 0.1, 0.37, 0.76, 1.18, 1.28, 1.67, 1.77, 2.1, 2.7, 3.01, 3.37, 3.77]}, {"scene": "b", "kind": "quote", "ref": ["suspicious[1]", "established[1]"], "text": "The college said the higher balance supported financial stability.", "t0": 24.31, "t1": 27.29, "shot": "r3-part1", "visual": {"type": "quote", "line": "The college said the higher balance supported financial stability"}, "wt": [0.0, 0.12, 0.47, 0.67, 0.79, 1.12, 1.48, 1.94, 2.41]}, {"scene": "o", "kind": "doc", "ref": ["suspicious[2]", "established[2]"], "text": "The district later certified its actual year-end figures.", "t0": 27.51, "t1": 30.16, "shot": "r4", "visual": {"type": "doc", "source": "actual", "kicker": "October 2026", "text": "Ending Fund Balance", "mark": "Fund Balance"}, "wt": [0.0, 0.14, 0.51, 0.79, 1.34, 1.5, 1.84, 2.2]}, {"scene": "o", "kind": "quote", "ref": ["suspicious[2]", "established[2]"], "text": "It reported an even larger unrestricted balance than it had budgeted.", "t0": 30.28, "t1": 33.64, "shot": "r4-part1", "visual": {"type": "quote", "line": "It reported an even larger unrestricted balance than it had budgeted"}, "wt": [0.0, 0.17, 0.63, 0.76, 1.04, 1.44, 2.06, 2.44, 2.62, 2.73, 2.86]}, {"scene": "o", "kind": "quote", "ref": ["suspicious[2]", "established[2]"], "text": "The college certified those actual figures in October 2026.", "t0": 33.76, "t1": 37.5, "shot": "r4-part1-more1", "visual": {"type": "quote", "line": "The college certified those actual figures in October 2026"}, "wt": [0.0, 0.14, 0.49, 1.01, 1.28, 1.73, 2.11, 2.25, 2.74, 3.03]}, {"scene": "o", "kind": "quote", "ref": ["suspicious[2]", "established[2]"], "text": "The budget and the later financial results refer to the same fiscal year.", "t0": 37.62, "t1": 41.48, "shot": "r4-part1-more2", "visual": {"type": "quote", "line": "The budget and the later financial results refer to the same fiscal year"}, "wt": [0.0, 0.16, 0.61, 0.81, 0.92, 1.2, 1.72, 2.19, 2.57, 2.7, 2.84, 3.16, 3.58]}, {"scene": "o", "kind": "end", "ref": ["status"], "text": "Every source is linked in the case file below.", "t0": 41.6, "t1": 43.71, "shot": "r5", "visual": {"type": "end"}, "wt": [0.0, 0.32, 0.63, 0.79, 1.03, 1.11, 1.21, 1.47, 1.75]}], "format": 6, "chapters": {"p": "Board policy", "b": "The budget", "o": "Year end"}, "look": "midnight", "hook": "document"}